<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ClassScreenLock.Uninstaller.Converters"
             x:Class="ClassScreenLock.Uninstaller.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent 2 设计令牌（颜色、圆角、间距、字阶等语义 token） -->
                <ResourceInclude Source="avares://CSL.Uninstaller/Styles/Fluent2Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Avalonia 内置 Fluent 主题（提供基础控件模板） -->
        <FluentTheme />
        <!-- 自定义 Fluent 2 控件样式（基于 token 的覆盖与扩展） -->
        <StyleInclude Source="avares://CSL.Uninstaller/Styles/FluentStyles.axaml" />
    </Application.Styles>
</Application>
