<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia">

    <!-- Fluent 双环焦点环模板 -->
    <Styles.Resources>
        <FocusAdornerTemplate x:Key="FluentFocusAdorner">
            <Grid Margin="-4">
                <Border BorderBrush="{DynamicResource F2FocusInnerBrush}" BorderThickness="1" Margin="3"/>
                <Border BorderBrush="{DynamicResource F2FocusOuterBrush}" BorderThickness="2" Margin="0"/>
            </Grid>
        </FocusAdornerTemplate>
    </Styles.Resources>

    <!-- ========== 基础按钮 - Fluent 2 ========== -->
    <!-- 尺寸取自 Fluent 2 规范：高度 32px、最小宽度 96px、内边距 10,5 -->
    <Style Selector="Button">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusButton}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource F2ControlDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <!-- 次要按钮（standard）：WinUI 3 标准按钮，透明底 + 1px 描边 -->
    <Style Selector="Button.standard">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
        <Setter Property="MinWidth" Value="96"/>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}"/>
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltQuarternaryBrush}"/>
    </Style>

    <Style Selector="Button.standard:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlDefaultBrush}"/>
    </Style>

    <Style Selector="Button.standard:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button:focus-visible">
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>

    <!-- ========== 强调色按钮（accent）- Fluent 2 ========== -->
    <Style Selector="Button.accent">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextOnAccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeOnAccentBrush}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource F2TextOnAccentPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.accent fluent|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource F2TextOnAccentPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2AccentSecondaryBrush}"/>
    </Style>

    <Style Selector="Button.accent:pressed">
        <Setter Property="Background" Value="{DynamicResource F2AccentTertiaryBrush}"/>
    </Style>

    <Style Selector="Button.accent:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- ========== 危险按钮（danger）- Fluent 2 ========== -->
    <Style Selector="Button.danger">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Foreground" Value="{DynamicResource F2SystemCriticalBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2SystemCriticalBrush}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource F2SystemCriticalBackgroundBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource F2SystemCriticalBrush}"/>
    </Style>

    <Style Selector="Button.danger fluent|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource F2SystemCriticalBrush}"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}"/>
    </Style>

    <Style Selector="Button.danger:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltQuarternaryBrush}"/>
    </Style>

    <!-- ========== 窗口 ========== -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundBaseBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>

    <!-- ========== 文本 ========== -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeSubtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeBodyLarge}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextSecondaryBrush}"/>
    </Style>

    <!-- ========== 卡片 ========== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource F2CardBackgroundDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusCard}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource F2ShadowCardRest}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <!-- ========== 输入框（Fluent 2 Underlined 风格） ========== -->
    <Style Selector="TextBox">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="TextBox /template/ Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="TextBox /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrongStrokeBrush}"/>
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrongStrokeBrush}"/>
    </Style>

    <Style Selector="TextBox:focus /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextSecondaryBrush}"/>
    </Style>

    <!-- ========== ProgressBar ========== -->
    <Style Selector="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Background" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2AccentDefaultBrush}"/>
    </Style>

    <!-- ========== CheckBox ========== -->
    <Style Selector="CheckBox">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <!-- ========== ListBox ========== -->
    <Style Selector="ListBox">
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusCard}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusControl}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>

    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
    </Style>

    <!-- 分隔线 -->
    <Style Selector="Border.divider">
        <Setter Property="Background" Value="{DynamicResource F2DividerStrokeBrush}"/>
    </Style>
</Styles>
