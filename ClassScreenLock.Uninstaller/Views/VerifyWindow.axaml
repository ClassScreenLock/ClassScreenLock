<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClassScreenLock.Uninstaller.ViewModels"
        xmlns:conv="clr-namespace:ClassScreenLock.Uninstaller.Converters"
        x:Class="ClassScreenLock.Uninstaller.Views.VerifyWindow"
        x:DataType="vm:VerifyViewModel"
        Title="ClassScreenLock 卸载"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:VerifyViewModel />
    </Design.DataContext>

    <Border Background="{DynamicResource F2SolidBackgroundBaseBrush}">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- 标题栏 -->
            <Border Grid.Row="0" Padding="24,24,24,8">
                <StackPanel Spacing="2">
                    <TextBlock Text="ClassScreenLock 卸载"
                               FontSize="{DynamicResource F2FontSizeSubtitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="需要管理员权限才能继续"
                               FontSize="13" Foreground="{DynamicResource F2TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 内容区 -->
            <Border Grid.Row="1" Padding="24,12,24,16">
                <StackPanel Spacing="14">
                    <!-- 说明文字 -->
                    <TextBlock Text="请输入管理员账户信息以验证身份。"
                               TextWrapping="Wrap" FontSize="14"
                               Foreground="{DynamicResource F2TextSecondaryBrush}"/>

                    <!-- 用户名 -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="用户名" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Username}" Watermark="请输入管理员用户名"/>
                    </StackPanel>

                    <!-- 密码 -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsPasswordVisible}">
                        <TextBlock Text="密码" FontSize="13" FontWeight="SemiBold"/>
                        <Grid>
                            <TextBox Text="{Binding Password}"
                                     PasswordChar="{Binding PasswordChar}"
                                     Watermark="请输入密码"
                                     Padding="10,5,48,5"/>
                            <Button Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Padding="0" Width="40" Height="28"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                <TextBlock Text="{Binding PasswordToggleLabel}" FontSize="12"
                                           Foreground="{DynamicResource F2AccentDefaultBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 双重验证码 -->
                    <StackPanel Spacing="6" IsVisible="{Binding IsTwoFactorVisible}">
                        <TextBlock Text="双重验证码" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding TwoFactorCode}" Watermark="6 位数字验证码" MaxLength="6"/>
                    </StackPanel>

                    <!-- 错误提示 -->
                    <Border IsVisible="{Binding LoginMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                            Background="{DynamicResource F2SystemCriticalBackgroundBrush}"
                            CornerRadius="{DynamicResource F2RadiusCard}"
                            Padding="12,10">
                        <TextBlock Text="{Binding LoginMessage}"
                                   Foreground="{DynamicResource F2SystemCriticalBrush}"
                                   TextWrapping="Wrap" Classes="caption"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 按钮栏（WinUI 3：居中，标准按钮 + 强调按钮） -->
            <Border Grid.Row="2" Padding="24,20,24,24"
                    Background="{DynamicResource F2SolidBackgroundBaseBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <Button Content="取消" Command="{Binding CancelCommand}"
                            Classes="standard"/>
                    <Button Content="继续" Command="{Binding VerifyCommand}"
                            Classes="accent"
                            IsEnabled="{Binding CanVerify}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
