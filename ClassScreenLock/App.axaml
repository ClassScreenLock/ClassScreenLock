<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassScreenLock.App"
             xmlns:local="using:ClassScreenLock"
             xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:converters="clr-namespace:ClassScreenLock.Converters"
             xmlns:controls="clr-namespace:ClassScreenLock.Controls"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Resources>
        <converters:BooleanToStatusTextConverter x:Key="BooleanToStatusTextConverter"/>
        <converters:BooleanToStatusBrushConverter x:Key="BooleanToStatusBrushConverter"/>
        <converters:ServiceStatusBrushConverter x:Key="ServiceStatusBrushConverter"/>
        <converters:AccountTypeToStringConverter x:Key="AccountTypeToStringConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:IsNullConverter x:Key="IsNullConverter"/>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <!-- 鸿蒙字体定义 -->
        <FontFamily x:Key="HarmonyOSFont">avares://ClassScreenLock/Assets/Fonts#HarmonyOS Sans SC</FontFamily>
        
        <!-- 全局字体族资源，初始值 -->
        <FontFamily x:Key="GlobalFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, SimSun, sans-serif</FontFamily>

        <FontWeight x:Key="GlobalFontWeight">Normal</FontWeight>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://ClassScreenLock/Styles/FluentStyles.axaml"/>
        
        <!-- 全局字体应用样式：强制所有继承自 TemplatedControl 和 TextBlock 的控件使用全局字体 -->
        <Style Selector="TemplatedControl">
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>
        
        <!-- 针对特定的顶级容器或特殊控件确保应用 -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://ClassScreenLock/ClassScreenLock.ico" 
                      ToolTipText="{DynamicResource AppTitle}"
                      Clicked="TrayIcon_OnClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{DynamicResource Tray_Show}" Click="MenuShow_OnClick" />
                        <NativeMenuItem Header="{DynamicResource Tray_QuickLock}" Click="MenuLock_OnClick" />
                        <NativeMenuItem Header="{DynamicResource Tray_QuickUnlock}" Click="MenuUnlock_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{DynamicResource Tray_OpenLockSettings}" Click="MenuOpenLockSettings_OnClick" />
                        <NativeMenuItem Header="{DynamicResource Tray_OpenSchedule}" Click="MenuOpenSchedule_OnClick" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{DynamicResource Tray_Exit}" Click="MenuExit_OnClick" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
