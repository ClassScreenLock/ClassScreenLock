<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
        xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
        xmlns:system="clr-namespace:System;assembly=System.Runtime">

    <!-- Fluent 双环焦点环模板：内环 1px 对比色贴控件边 + 外环 2px 主色（间距 1px），随主题自动切换 -->
    <Styles.Resources>
        <FocusAdornerTemplate x:Key="FluentFocusAdorner">
            <Grid Margin="-4">
                <Border BorderBrush="{DynamicResource F2FocusInnerBrush}" BorderThickness="1" Margin="3"/>
                <Border BorderBrush="{DynamicResource F2FocusOuterBrush}" BorderThickness="2" Margin="0"/>
            </Grid>
        </FocusAdornerTemplate>
    </Styles.Resources>

    <!-- ============================================================
         ClassScreenLock 控件样式 — Fluent 2 (Windows UI Kit)
         全部颜色引用 Styles/Fluent2Tokens.axaml 中的语义 token
         ============================================================ -->

    <!-- Projektanker.Icons.Avalonia默认样式 -->
      <Style Selector="icons|Icon">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}" />
      </Style>

    <!-- ========== 基础按钮 - Fluent 2 ========== -->
    <Style Selector="Button">
        <Setter Property="FontWeight" Value="{DynamicResource GlobalFontWeight}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusButton}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Background" Value="{DynamicResource F2ControlDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltQuarternaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <!-- 焦点环 - 键盘导航可见（Fluent 双环：外环 2px + 内环 1px 对比色） -->
    <Style Selector="Button:focus-visible">
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>

    <!-- ========== 强调色按钮（accent）- Fluent 2 ========== -->
    <Style Selector="Button.accent">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextOnAccentPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeOnAccentBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusButton}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- accent 按钮内文本和图标 - 强制白色 -->
    <Style Selector="Button.accent TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource F2TextOnAccentPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.accent TextBlock.badge,
                     Button.accent TextBlock.subtitle,
                     Button.accent TextBlock.caption,
                     Button.accent TextBlock.status">
        <Setter Property="Foreground" Value="{DynamicResource F2TextOnAccentPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.accent fluent|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource F2TextOnAccentPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.accent:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2AccentSecondaryBrush}"/>
    </Style>

    <Style Selector="Button.accent:pressed">
        <Setter Property="Background" Value="{DynamicResource F2AccentTertiaryBrush}"/>
    </Style>

    <Style Selector="Button.accent:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.accent:focus-visible">
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>

    <!-- ========== 轮廓按钮（outline）- Fluent 2 ========== -->
    <Style Selector="Button.outline">
        <Setter Property="Height" Value="40"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrongStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusButton}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.outline:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}"/>
    </Style>

    <Style Selector="Button.outline:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltQuarternaryBrush}"/>
    </Style>

    <Style Selector="Button.outline:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>

    <!-- ========== 危险按钮（danger）- Fluent 2 Critical 体系 ========== -->
    <Style Selector="Button.danger">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{DynamicResource F2SystemCriticalBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2SystemCriticalBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusButton}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{DynamicResource F2SystemCriticalBackgroundBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- danger 按钮内文本和图标 -->
    <Style Selector="Button.danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource F2SystemCriticalBrush}"/>
    </Style>
    <Style Selector="Button.danger fluent|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource F2SystemCriticalBrush}"/>
    </Style>

    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2SystemCriticalBrush}"/>
    </Style>

    <Style Selector="Button.danger:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltQuarternaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2SystemCriticalBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2SystemCriticalBrush}"/>
    </Style>

    <Style Selector="Button.danger:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>

    <Style Selector="Button.danger:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource F2SystemCriticalBrush}"/>
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>

    <!-- ========== 窗口主题（Kit: Solid Background） ========== -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundBaseBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>

    <!-- 主内容区域 -->
    <Style Selector="Window Grid.main-content-grid">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundBaseBrush}"/>
    </Style>

    <Style Selector="Window Grid.main-content-grid Border.main-content-border">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundQuarternaryBrush}"/>
    </Style>

    <!-- 文本 -->
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="{DynamicResource GlobalFontWeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.badge">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="{DynamicResource GlobalFontWeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
        <Setter Property="LetterSpacing" Value="0"/>
        <Setter Property="TextTrimming" Value="None"/>
    </Style>

    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeBodyLarge}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.status">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextSecondaryBrush}"/>
    </Style>

    <!-- 边框 -->
    <Style Selector="Border.chrome">
        <Setter Property="Background" Value="{DynamicResource F2LayerDefaultBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style Selector="Border.acrylic">
        <Setter Property="Background" Value="{DynamicResource F2CardBackgroundDefaultBrush}"/>
    </Style>

    <!-- 圆形按钮 -->
    <Style Selector="Button.circular">
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusPill}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- ========== 窗口标题栏按钮（Kit: Caption Controls） ========== -->
    <Style Selector="Button.WindowTitleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.WindowTitleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}" />
    </Style>

    <Style Selector="Button.WindowTitleButton:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltQuarternaryBrush}" />
    </Style>

    <!-- Kit: 关闭按钮 Critical 填充 -->
    <Style Selector="Button.WindowTitleButton.CloseButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2SystemCriticalBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <Style Selector="Button.WindowTitleButton.CloseButton:pressed">
        <Setter Property="Background" Value="{DynamicResource F2SystemCriticalBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource F2SystemCriticalBrush}" />
    </Style>

    <!-- ========== 侧边栏按钮（Kit: NavigationView Item） ========== -->
    <Style Selector="Button.SidebarButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="Padding" Value="12,11" />
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusControl}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Panel/>
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.SidebarButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.SidebarButton:pressed">
        <Setter Property="Background" Value="{DynamicResource F2SubtleTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 侧边栏按钮选中态：accent tint + accent 文字（Kit: NavigationViewItem Selected） -->
    <Style Selector="Button.SidebarButton.selected">
        <Setter Property="Background" Value="{DynamicResource F2NavSelectedBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource F2AccentTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.SidebarButton.selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2NavSelectedHoverBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource F2AccentTextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.SidebarButton.selected:pressed">
        <Setter Property="Background" Value="{DynamicResource F2NavSelectedPressedBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource F2AccentTextPrimaryBrush}" />
    </Style>

    <!-- ========== 侧边栏文本与图标（选中时使用 Accent 体系） ========== -->
    <Style Selector="Button.SidebarButton.selected TextBlock.sidebar-text">
        <Setter Property="Foreground" Value="{DynamicResource F2AccentTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.SidebarButton.selected fluent|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource F2AccentTextPrimaryBrush}" />
    </Style>

    <!-- ========== 侧边栏折叠按钮 ========== -->
    <Style Selector="Button.SidebarToggleButton">
        <Setter Property="Background" Value="{DynamicResource F2ControlDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0,8,8,0" />
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.SidebarToggleButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.SidebarToggleButton:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltQuarternaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ========== 卡片（Kit: Card Background + Card Stroke + Card Rest 阴影） ========== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource F2CardBackgroundDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusCard}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource F2ShadowCardRest}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <!-- 可交互卡片 hover -->
    <Style Selector="Border.card.interactive:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeSecondaryBrush}"/>
        <Setter Property="BoxShadow" Value="{DynamicResource F2ShadowCardHover}"/>
    </Style>

    <Style Selector="Border.card.interactive:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltQuarternaryBrush}"/>
    </Style>

    <Style Selector="Border.account-card:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}"/>
    </Style>

    <!-- ========== 图标按钮尺寸 token ========== -->
    <Style Selector="Button.icon-sm">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusIconSmall}"/>
    </Style>

    <Style Selector="Button.icon-md">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusIconMedium}"/>
    </Style>

    <Style Selector="Button.icon-lg">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusIconMedium}"/>
    </Style>

    <!-- ========== 侧边栏背景（Kit: Layer） ========== -->
    <Style Selector="Border.sidebar-background">
        <Setter Property="Background" Value="{DynamicResource F2LayerDefaultBrush}"/>
    </Style>

    <!-- 侧边栏文本：不显式设置前景色，继承按钮 Foreground（选中态自动变为 accent 蓝，避免黑字） -->
    <Style Selector="TextBlock.sidebar-text">
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- 侧边栏版本信息 -->
    <Style Selector="TextBlock.sidebar-version">
        <Setter Property="Foreground" Value="{DynamicResource F2TextTertiaryBrush}"/>
    </Style>

    <!-- 侧边栏分隔线 -->
    <Style Selector="Border.sidebar-divider">
        <Setter Property="Background" Value="{DynamicResource F2DividerStrokeBrush}"/>
    </Style>

    <!-- 侧边栏图标 -->
    <Style Selector="Button.SidebarButton fluent|SymbolIcon">
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>

    <!-- ========== 输入框（Fluent 2 Underlined 风格：无边框无填充，仅底部 1px 下划线） ========== -->
    <Style Selector="TextBox">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- 输入框模板：仅底部下划线，透明背景 -->
    <Style Selector="TextBox /template/ Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="TextBox /template/ Border#PART_Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrongStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrongStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>
    <Style Selector="TextBox:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
    </Style>

    <!-- 水印文字 -->
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextSecondaryBrush}"/>
    </Style>

    <!-- 兼容旧类名：与全局一致的下划线风格 -->
    <Style Selector="TextBox.clear">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- ========== 文本层级（Kit 字阶） ========== -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeTitleLarge}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeSubtitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeBodyLarge}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextSecondaryBrush}"/>
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <!-- ========== ComboBox ========== -->
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusControl}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource F2ControlDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
    </Style>
    <Style Selector="ComboBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltTertiaryBrush}"/>
    </Style>
    <Style Selector="ComboBox:pressed">
        <Setter Property="Background" Value="{DynamicResource F2ControlAltQuarternaryBrush}"/>
    </Style>
    <Style Selector="ComboBox:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ========== TabControl（胶囊选中样式，对标课程表 day-picker） ========== -->
    <Style Selector="TabControl.FluentTabControl">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabControl.FluentTabControl TabItem">
        <Setter Property="FontSize" Value="{DynamicResource F2FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextSecondaryBrush}"/>
    </Style>
    <!-- hover：浅色填充（对标 day-picker :pointerover） -->
    <Style Selector="TabControl.FluentTabControl TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
    </Style>
    <!-- 选中：NavSelected 胶囊 + accent 文字 + SemiBold（对标 day-picker :selected） -->
    <Style Selector="TabControl.FluentTabControl TabItem:selected">
        <Setter Property="Background" Value="{DynamicResource F2NavSelectedBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2AccentTextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TabControl.FluentTabControl TabItem:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2NavSelectedHoverBackgroundBrush}"/>
    </Style>
    <!-- 隐藏选中指示管：胶囊选中样式不再需要底部管道，避免双线 -->
    <Style Selector="TabControl.FluentTabControl TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False"/>
    </Style>

    <Style Selector="TabControl TabItem">
        <Setter Property="CornerRadius" Value="4,4,0,0"/>
    </Style>

    <!-- ========== ListBox ========== -->
    <Style Selector="ListBox">
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusCard}"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusControl}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource F2SubtleTertiaryBrush}"/>
    </Style>
    <Style Selector="ListBoxItem:selected:focus-visible">
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ========== DataGrid ========== -->
    <Style Selector="DataGrid">
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusCard}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="RowHeight" Value="38"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2CardStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
    </Style>

    <!-- ========== ToggleSwitch ========== -->
    <Style Selector="ToggleSwitch">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <!-- ========== CheckBox / RadioButton ========== -->
    <Style Selector="CheckBox">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="RadioButton">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <!-- 全局透明按钮 -->
    <Style Selector="Button.transparent">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="Button.transparent:pointerover">
        <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.transparent:pressed">
        <Setter Property="Background" Value="{DynamicResource F2SubtleTertiaryBrush}"/>
    </Style>
    <Style Selector="Button.transparent:focus-visible">
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>
    <Style Selector="Button.circle:focus-visible">
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>
    <Style Selector="ToggleButton.circle:focus-visible">
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>
    <Style Selector="Button.pill:focus-visible">
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>
    <Style Selector="ToggleButton.pill:focus-visible">
        <Setter Property="FocusAdorner" Value="{StaticResource FluentFocusAdorner}"/>
    </Style>

    <!-- ========== 浮层面板背景（Kit: Layer / Card Background） ========== -->
    <Style Selector="Border.overlay-panel">
        <Setter Property="Background" Value="{DynamicResource F2LayerAltBrush}"/>
    </Style>
    <Style Selector="Border.overlay-panel-header">
        <Setter Property="Background" Value="{DynamicResource F2LayerAltBrush}"/>
    </Style>
    <Style Selector="Border.overlay-panel-side">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundBaseBrush}"/>
    </Style>
    <Style Selector="Border.overlay-panel-item">
        <Setter Property="Background" Value="{DynamicResource F2CardBackgroundDefaultBrush}"/>
    </Style>

    <!-- ========== 快速操作编辑器：高品质 UI 样式（Kit 语义映射） ========== -->
    <Style Selector="Border.qa-editor-shell">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundQuarternaryBrush}"/>
    </Style>
    <Style Selector="Border.qa-editor-titlebar">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundTertiaryBrush}"/>
    </Style>
    <Style Selector="Border.qa-editor-section">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundSecondaryBrush}"/>
    </Style>
    <Style Selector="Border.qa-editor-item">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundQuarternaryBrush}"/>
    </Style>
    <Style Selector="Border.qa-editor-candidate">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundQuarternaryBrush}"/>
    </Style>
    <Style Selector="Border.qa-editor-search">
        <Setter Property="Background" Value="{DynamicResource F2SolidBackgroundSecondaryBrush}"/>
    </Style>

    <!-- 候选按钮悬浮态 -->
    <Style Selector="Button.qa-candidate">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusCard}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.qa-candidate:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource F2AccentDefaultBrush}"/>
    </Style>

    <!-- 已选项卡片悬浮态 -->
    <Style Selector="Border.qa-editor-item">
        <Setter Property="BorderBrush" Value="{DynamicResource F2ControlStrokeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- 圆形操作按钮 -->
    <Style Selector="Button.qa-iconbtn">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.qa-iconbtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.qa-iconbtn-danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource F2SystemCriticalBackgroundBrush}"/>
    </Style>
</Styles>
