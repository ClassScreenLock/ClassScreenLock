<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ClassScreenLock.Views.About"
             x:DataType="vm:AboutViewModel">

    <Grid Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Border 
                Padding="24" 
                CornerRadius="8"
                Margin="16"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" MaxWidth="600">
                <!-- 应用图标和名称 -->
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <Image Source="/ClassScreenLock.ico" Width="64" Height="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding AppName}" Classes="h1" HorizontalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock Text="{Binding AppVersion}" Classes="subtitle" HorizontalAlignment="Center" 
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
                
                <!-- 应用描述 -->
                <TextBlock Text="{Binding AppDescription}" 
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                
                <!-- 分隔线 -->
                <Separator Margin="0,8" 
                          Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                
                <!-- 开发者信息 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="开发者" Classes="h3"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock Text="{Binding Developer}" 
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                </StackPanel>
                
                <!-- 许可证信息 -->
                <StackPanel Spacing="8">
                    <TextBlock Text="许可证" Classes="h3"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock Text="{Binding License}" 
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                </StackPanel>
                
                <!-- 版权信息 -->
                <TextBlock Text="{Binding Copyright}" 
                           TextWrapping="Wrap" 
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>