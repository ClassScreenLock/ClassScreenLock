<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:m="clr-namespace:ClassScreenLock.Models"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:Converters="clr-namespace:ClassScreenLock.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ClassScreenLock.Views.AutomationView"
             x:DataType="vm:AutomationViewModel"
             x:Name="AutomationRoot">

    <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,*,Auto">

        <!-- ============ Top Bar ============ -->
        <Border Grid.Row="0" Padding="24,16" Background="{DynamicResource F2SolidBackgroundSecondaryBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{DynamicResource Automation_Title}" Classes="h1"/>
                    <TextBlock Text="{DynamicResource Automation_Description}" Classes="caption" Opacity="0.6"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource F2CardBackgroundDefaultBrush}" CornerRadius="4" Padding="16,8" BorderThickness="1" BorderBrush="{DynamicResource F2CardStrokeBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Automation_Enable}" FontWeight="Medium"/>
                            <TextBlock Text="{DynamicResource Automation_Enable_Desc}" FontSize="11" Opacity="0.6"/>
                        </StackPanel>
                        <ToggleSwitch IsChecked="{Binding IsAutomationEnabled}" OnContent="" OffContent="" Margin="0,-8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Toolbar: Scheme + Search + New + Workflow Cards ============ -->
        <Border Grid.Row="1" Padding="24,12" Background="{DynamicResource F2SolidBackgroundTertiaryBrush}" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource F2DividerStrokeBrush}">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">

                <!-- Scheme label + dropdown -->
                <TextBlock Grid.Column="0" Text="{DynamicResource Automation_Scheme_Label}" VerticalAlignment="Center" Opacity="0.6" FontSize="13"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableSchemes}" SelectedItem="{Binding CurrentAutomationScheme, Mode=TwoWay}" MinWidth="120" Margin="8,0,0,0"/>

                <!-- Add scheme -->
                <Button Grid.Column="2" Classes="outline" Padding="10,8" Margin="4,0,0,0" ToolTip.Tip="{DynamicResource Automation_AddScheme}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="8" Width="200">
                                <TextBox Text="{Binding NewSchemeName}" Watermark="{DynamicResource Automation_SchemeName_Watermark}" Classes="clear"/>
                                <Button Command="{Binding AddSchemeCommand}" Classes="accent" HorizontalAlignment="Stretch" Content="{DynamicResource Automation_AddScheme}"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <fluent:SymbolIcon Symbol="Add" FontSize="14"/>
                </Button>

                <!-- Delete scheme -->
                <Button Grid.Column="3" Command="{Binding RemoveSchemeCommand}" CommandParameter="{Binding CurrentAutomationScheme}" Classes="danger" Padding="10,8" Margin="4,0,0,0" ToolTip.Tip="{DynamicResource Automation_DeleteCurrentScheme}">
                    <fluent:SymbolIcon Symbol="Delete" FontSize="14"/>
                </Button>

                <!-- Separator -->
                <Border Grid.Column="4" Width="1" Background="{DynamicResource F2DividerStrokeBrush}" Margin="16,2"/>

                <!-- Workflow dropdown -->
                <ComboBox Grid.Column="5" ItemsSource="{Binding VisibleWorkflows}" SelectedItem="{Binding SelectedWorkflow}" MinWidth="200" MaxWidth="300" HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="m:AutomationWorkflow">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource F2SystemSuccessBrush}" IsVisible="{Binding IsEnabled}"/>
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource F2TextTertiaryBrush}" IsVisible="{Binding !IsEnabled}"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- New workflow -->
                <Button Grid.Column="6" Command="{Binding AddWorkflowCommand}" Classes="accent" Padding="12,8" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fluent:SymbolIcon Symbol="Add" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Automation_AddWorkflow}" VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>
                </Button>

                <!-- Duplicate -->
                <Button Grid.Column="7" Command="{Binding DuplicateWorkflowCommand}" Classes="outline" Padding="10,8" Margin="4,0,0,0" ToolTip.Tip="{DynamicResource Automation_Duplicate}">
                    <fluent:SymbolIcon Symbol="Copy" FontSize="14"/>
                </Button>

                <!-- Delete workflow -->
                <Button Grid.Column="8" Command="{Binding DeleteWorkflowCommand}" Classes="danger" Padding="10,8" Margin="4,0,0,0" ToolTip.Tip="{DynamicResource Automation_Delete}">
                    <fluent:SymbolIcon Symbol="Delete" FontSize="14"/>
                </Button>

            </Grid>
        </Border>

        <!-- ============ Editor ============ -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border Padding="24,20">
                <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">
                    <StackPanel.Styles>
                        <Style Selector="Border.Card">
                            <Setter Property="Background" Value="{DynamicResource F2CardBackgroundDefaultBrush}"/>
                            <Setter Property="CornerRadius" Value="4"/>
                            <Setter Property="Padding" Value="20"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource F2CardStrokeBrush}"/>
                            <Setter Property="BoxShadow" Value="{DynamicResource F2ShadowCardRest}"/>
                        </Style>
                        <Style Selector="TextBlock.SectionHeader">
                            <Setter Property="FontSize" Value="16"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Foreground" Value="{DynamicResource F2TextPrimaryBrush}"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover">
                            <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
                        </Style>
                        <Style Selector="fluent|SymbolIcon">
                            <Setter Property="FontSize" Value="14"/>
                        </Style>
                    </StackPanel.Styles>

                        <ContentControl Content="{Binding SelectedWorkflow}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="m:AutomationWorkflow">
                                    <StackPanel Spacing="16">

                                        <!-- ===== Workflow Header Card ===== -->
                                        <Border Classes="Card">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="{DynamicResource Automation_Name}" Classes="caption" Opacity="0.5"/>
                                                    <TextBox Text="{Binding Name}" Width="240" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Bottom">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{DynamicResource Automation_Enable}" FontSize="11" Opacity="0.6"/>
                                                        <ToggleSwitch IsChecked="{Binding IsEnabled}" OnContent="" OffContent="" MinWidth="0"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{DynamicResource Automation_ConditionsSection}" FontSize="11" Opacity="0.6"/>
                                                        <ToggleSwitch IsChecked="{Binding ConditionsEnabled}" OnContent="" OffContent="" MinWidth="0"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{DynamicResource Automation_RecoveryEnabled}" FontSize="11" Opacity="0.6"/>
                                                        <ToggleSwitch IsChecked="{Binding RecoveryEnabled}" OnContent="" OffContent="" MinWidth="0"/>
                                                    </StackPanel>
                                                    <Button Command="{Binding $parent[UserControl].DataContext.RunAutomationCheckCommand}" Classes="accent" Padding="12,8" VerticalAlignment="Bottom" ToolTip.Tip="{DynamicResource Automation_CheckNow}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <fluent:SymbolIcon Symbol="Play"/>
                                                            <TextBlock Text="{DynamicResource Automation_CheckNow}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- ===== Pipeline Stage 1: Triggers ===== -->
                                        <Border Classes="Card">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Background="{DynamicResource F2AccentDefaultBrush}">
                                                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource Automation_TriggerSection}" Classes="SectionHeader"/>
                                                    </StackPanel>
                                                    <Menu Grid.Column="2" Background="Transparent">
                                                        <MenuItem Header="{DynamicResource Automation_AddTrigger}" Classes="accent">
                                                            <MenuItem.Icon>
                                                                <fluent:SymbolIcon Symbol="Add"/>
                                                            </MenuItem.Icon>
                                                            <MenuItem Header="{DynamicResource Automation_Trigger_DailyTime}" Command="{Binding $parent[UserControl].DataContext.AddTriggerCommand}" CommandParameter="DailyTime">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Clock"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Trigger_Interval}" Command="{Binding $parent[UserControl].DataContext.AddTriggerCommand}" CommandParameter="Interval">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="ArrowSync"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Trigger_OnStartup}" Command="{Binding $parent[UserControl].DataContext.AddTriggerCommand}" CommandParameter="OnStartup">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Power"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Trigger_ProcessRunning}" Command="{Binding $parent[UserControl].DataContext.AddTriggerCommand}" CommandParameter="ProcessRunning">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Apps"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Trigger_ProcessNotRunning}" Command="{Binding $parent[UserControl].DataContext.AddTriggerCommand}" CommandParameter="ProcessNotRunning">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Folder"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Trigger_NetworkAvailable}" Command="{Binding $parent[UserControl].DataContext.AddTriggerCommand}" CommandParameter="NetworkAvailable">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Globe"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Trigger_NetworkUnavailable}" Command="{Binding $parent[UserControl].DataContext.AddTriggerCommand}" CommandParameter="NetworkUnavailable">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Globe"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Trigger_FileExists}" Command="{Binding $parent[UserControl].DataContext.AddTriggerCommand}" CommandParameter="FileExists">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Document"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuItem>
                                                    </Menu>
                                                </Grid>
                                                <TextBlock Text="{DynamicResource Automation_TriggerDescription}" Opacity="0.5" FontSize="12"/>

                                                <ItemsControl ItemsSource="{Binding Triggers}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:AutomationTrigger">
                                                            <Border Background="{DynamicResource F2LayerDefaultBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                                                <Grid ColumnDefinitions="Auto,*,36">
                                                                    <Panel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Width="20">
                                                                        <fluent:SymbolIcon Symbol="Clock" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DailyTime}"/>
                                                                        <fluent:SymbolIcon Symbol="ArrowSync" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Interval}"/>
                                                                        <fluent:SymbolIcon Symbol="Power" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OnStartup}"/>
                                                                        <fluent:SymbolIcon Symbol="Apps" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessRunning}"/>
                                                                        <fluent:SymbolIcon Symbol="Folder" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessNotRunning}"/>
                                                                        <fluent:SymbolIcon Symbol="Globe" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkAvailable}"/>
                                                                        <fluent:SymbolIcon Symbol="Globe" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkUnavailable}"/>
                                                                        <fluent:SymbolIcon Symbol="Document" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=FileExists}"/>
                                                                    </Panel>
                                                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Left">
                                                                        <ComboBox SelectedItem="{Binding Type}" Width="130" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                            <ComboBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                        <Panel Width="16">
                                                                                            <fluent:SymbolIcon Symbol="Clock" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=DailyTime}"/>
                                                                                            <fluent:SymbolIcon Symbol="ArrowSync" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=Interval}"/>
                                                                                            <fluent:SymbolIcon Symbol="Power" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=OnStartup}"/>
                                                                                            <fluent:SymbolIcon Symbol="Apps" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessRunning}"/>
                                                                                            <fluent:SymbolIcon Symbol="Folder" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessNotRunning}"/>
                                                                                            <fluent:SymbolIcon Symbol="Globe" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkAvailable}"/>
                                                                                            <fluent:SymbolIcon Symbol="Globe" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkUnavailable}"/>
                                                                                            <fluent:SymbolIcon Symbol="Document" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=FileExists}"/>
                                                                                        </Panel>
                                                                                        <Panel>
                                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_DailyTime}" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=DailyTime}"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_Interval}" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=Interval}"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_OnStartup}" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=OnStartup}"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_ProcessRunning}" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessRunning}"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_ProcessNotRunning}" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessNotRunning}"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_NetworkAvailable}" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkAvailable}"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_NetworkUnavailable}" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkUnavailable}"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_FileExists}" IsVisible="{Binding Converter={StaticResource StringEqualsConverter}, ConverterParameter=FileExists}"/>
                                                                                        </Panel>
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ComboBox.ItemTemplate>
                                                                            <x:String>DailyTime</x:String>
                                                                            <x:String>Interval</x:String>
                                                                            <x:String>OnStartup</x:String>
                                                                            <x:String>ProcessRunning</x:String>
                                                                            <x:String>ProcessNotRunning</x:String>
                                                                            <x:String>NetworkAvailable</x:String>
                                                                            <x:String>NetworkUnavailable</x:String>
                                                                            <x:String>FileExists</x:String>
                                                                        </ComboBox>

                                                                        <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Left">
                                                                            <!-- DailyTime editor -->
                                                                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DailyTime}">
                                                                                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableHours}" SelectedItem="{Binding Hour}" Width="65"/>
                                                                                <TextBlock Text="{DynamicResource Automation_Time_Hour}" VerticalAlignment="Center" Classes="caption"/>
                                                                                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableMinutes}" SelectedItem="{Binding Minute}" Width="65">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <TextBlock Text="{Binding StringFormat={}{0:D2}}"/>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                                <TextBlock Text="{DynamicResource Automation_Time_Minute}" VerticalAlignment="Center" Classes="caption"/>
                                                                            </StackPanel>

                                                                            <!-- Interval editor -->
                                                                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Interval}">
                                                                                <NumericUpDown Value="{Binding IntervalMinutes}" Minimum="1" Maximum="1440" Width="120"/>
                                                                                <TextBlock Text="{DynamicResource Automation_Time_Minutes}" VerticalAlignment="Center" Classes="caption"/>
                                                                            </StackPanel>

                                                                            <!-- OnStartup description -->
                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_OnStartup_Description}" VerticalAlignment="Center" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OnStartup}"/>

                                                                            <!-- ProcessRunning editor -->
                                                                            <StackPanel Orientation="Vertical" Spacing="6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessRunning}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                    <TextBlock Text="{DynamicResource Automation_CheckInterval_Seconds}" VerticalAlignment="Center" Opacity="0.6"/>
                                                                                    <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableCheckIntervals}" SelectedItem="{Binding CheckIntervalSeconds, Mode=TwoWay}" Width="140">
                                                                                        <ComboBox.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                                    <TextBlock Text="{Binding}"/>
                                                                                                    <TextBlock Text="{DynamicResource Automation_Time_Seconds}"/>
                                                                                                </StackPanel>
                                                                                            </DataTemplate>
                                                                                        </ComboBox.ItemTemplate>
                                                                                    </ComboBox>
                                                                                </StackPanel>
                                                                                <WrapPanel>
                                                                                    <TextBlock Text="{DynamicResource Automation_Trigger_ProcessRunning_Description}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,8"/>
                                                                                    <TextBox x:Name="TriggerFilterBox" Text="{Binding $parent[UserControl].DataContext.ProcessFilterText}" Watermark="{DynamicResource Automation_ProcessFilter_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                                                                                    <Button Command="{Binding $parent[UserControl].DataContext.RefreshProcessesCommand}" Padding="12,6" Margin="0,0,8,8">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <fluent:SymbolIcon Symbol="ArrowSync"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Refresh}"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                    <Button Command="{Binding $parent[UserControl].DataContext.UseFilterTextForTriggerCommand}" CommandParameter="{Binding}" Padding="12,6" Margin="0,0,8,8">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <fluent:SymbolIcon Symbol="Checkmark"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Fill}"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </WrapPanel>
                                                                                <Popup PlacementTarget="{Binding #TriggerFilterBox}" Placement="BottomEdgeAlignedLeft" IsOpen="{Binding #TriggerFilterBox.IsFocused}">
                                                                                    <Border Background="{DynamicResource F2CardBackgroundDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource F2CardStrokeBrush}" CornerRadius="4" Padding="4" Width="{Binding #TriggerFilterBox.Width}" MaxHeight="240">
                                                                                        <ListBox ItemsSource="{Binding $parent[UserControl].DataContext.FilteredSuggestions}" SelectionChanged="OnTriggerSuggestionSelected" Tag="{Binding}">
                                                                                            <ListBox.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2" Tapped="OnTriggerSuggestionTapped">
                                                                                                        <fluent:SymbolIcon Grid.Column="0" Symbol="{Binding Icon, Converter={x:Static Converters:FontAwesomeToFluentIconConverter.Instance}}"/>
                                                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                                                                            <TextBlock Text="{Binding Name}"/>
                                                                                                            <TextBlock Text="{Binding Path}" Classes="caption" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                                                                                        </StackPanel>
                                                                                                    </Grid>
                                                                                                </DataTemplate>
                                                                                            </ListBox.ItemTemplate>
                                                                                        </ListBox>
                                                                                    </Border>
                                                                                </Popup>
                                                                                <WrapPanel>
                                                                                    <TextBox Text="{Binding ProcessName}" Watermark="{DynamicResource Automation_ProcessName_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                                                                                </WrapPanel>
                                                                                <WrapPanel>
                                                                                    <TextBox Text="{Binding FilePath}" Watermark="{DynamicResource Automation_FilePath_Watermark}" Width="360" Classes="clear" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                                                                                    <Button Command="{Binding $parent[UserControl].DataContext.PickTriggerExeCommand}" CommandParameter="{Binding}" Padding="12,6" Classes="accent" Margin="0,0,8,8">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <fluent:SymbolIcon Symbol="FolderOpen"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Browse}"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </WrapPanel>
                                                                            </StackPanel>

                                                                            <!-- ProcessNotRunning editor -->
                                                                            <StackPanel Orientation="Vertical" Spacing="6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessNotRunning}">
                                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                    <TextBlock Text="{DynamicResource Automation_CheckInterval_Seconds}" VerticalAlignment="Center" Opacity="0.6"/>
                                                                                    <NumericUpDown Value="{Binding CheckIntervalSeconds}" Minimum="1" Maximum="60" Width="120"/>
                                                                                </StackPanel>
                                                                                <WrapPanel>
                                                                                    <TextBlock Text="{DynamicResource Automation_Trigger_ProcessNotRunning_Description}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,8"/>
                                                                                    <TextBox x:Name="NotRunningFilterBox" Text="{Binding $parent[UserControl].DataContext.ProcessFilterText}" Watermark="{DynamicResource Automation_ProcessFilter_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                                                                                    <Button Command="{Binding $parent[UserControl].DataContext.RefreshProcessesCommand}" Padding="12,6" Margin="0,0,8,8">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <fluent:SymbolIcon Symbol="ArrowSync"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Refresh}"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </WrapPanel>
                                                                                <Popup PlacementTarget="{Binding #NotRunningFilterBox}" Placement="BottomEdgeAlignedLeft" IsOpen="{Binding #NotRunningFilterBox.IsFocused}">
                                                                                    <Border Background="{DynamicResource F2CardBackgroundDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource F2CardStrokeBrush}" CornerRadius="4" Padding="4" Width="{Binding #NotRunningFilterBox.Width}" MaxHeight="240">
                                                                                        <ListBox ItemsSource="{Binding $parent[UserControl].DataContext.FilteredSuggestions}" SelectionChanged="OnTriggerSuggestionSelected" Tag="{Binding}">
                                                                                            <ListBox.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2" Tapped="OnTriggerSuggestionTapped">
                                                                                                        <fluent:SymbolIcon Grid.Column="0" Symbol="{Binding Icon, Converter={x:Static Converters:FontAwesomeToFluentIconConverter.Instance}}"/>
                                                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                                                                            <TextBlock Text="{Binding Name}"/>
                                                                                                            <TextBlock Text="{Binding Path}" Classes="caption" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                                                                                        </StackPanel>
                                                                                                    </Grid>
                                                                                                </DataTemplate>
                                                                                            </ListBox.ItemTemplate>
                                                                                        </ListBox>
                                                                                    </Border>
                                                                                </Popup>
                                                                                <WrapPanel>
                                                                                    <TextBox Text="{Binding ProcessName}" Watermark="{DynamicResource Automation_ProcessName_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                                                                                </WrapPanel>
                                                                                <WrapPanel>
                                                                                    <TextBox Text="{Binding FilePath}" Watermark="{DynamicResource Automation_FilePath_Watermark}" Width="360" Classes="clear" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                                                                                    <Button Command="{Binding $parent[UserControl].DataContext.PickTriggerExeCommand}" CommandParameter="{Binding}" Padding="12,6" Classes="accent" Margin="0,0,8,8">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                            <fluent:SymbolIcon Symbol="FolderOpen"/>
                                                                                            <TextBlock Text="{DynamicResource Automation_Browse}"/>
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </WrapPanel>
                                                                            </StackPanel>

                                                                            <!-- FileExists editor -->
                                                                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=FileExists}">
                                                                                <TextBlock Text="{DynamicResource Automation_Trigger_FileExists_Description}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0"/>
                                                                                <TextBox Text="{Binding FilePath}" Watermark="{DynamicResource Automation_FilePath_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left"/>
                                                                            </StackPanel>

                                                                            <!-- Network descriptions -->
                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_Network_Description}" VerticalAlignment="Center" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkAvailable}"/>
                                                                            <TextBlock Text="{DynamicResource Automation_Trigger_Network_Description}" VerticalAlignment="Center" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkUnavailable}"/>
                                                                        </Panel>
                                                                    </Grid>
                                                                    <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.RemoveTriggerCommand}" CommandParameter="{Binding}" Classes="danger icon-sm">
                                                                        <fluent:SymbolIcon Symbol="Dismiss"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- ===== Connector 1->2 ===== -->
                                        <StackPanel HorizontalAlignment="Center" Spacing="0" Margin="0,-4">
                                            <Border Width="2" Height="12" Background="{DynamicResource F2DividerStrokeBrush}"/>
                                            <fluent:SymbolIcon Symbol="ChevronDown" Opacity="0.3" Width="14" Height="14"/>
                                        </StackPanel>

                                        <!-- ===== Pipeline Stage 2: Conditions ===== -->
                                        <Border Classes="Card">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Background="{DynamicResource F2AccentDefaultBrush}">
                                                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource Automation_ConditionsSection}" Classes="SectionHeader"/>
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="2" IsChecked="{Binding ConditionsEnabled}" OnContent="{DynamicResource Automation_Conditions_Enable}" OffContent="{DynamicResource Automation_Conditions_Disable}" VerticalAlignment="Center"/>
                                                    <Menu Grid.Column="3" Background="Transparent">
                                                        <MenuItem Header="{DynamicResource Automation_AddCondition}" Classes="accent">
                                                            <MenuItem.Icon>
                                                                <fluent:SymbolIcon Symbol="Add"/>
                                                            </MenuItem.Icon>
                                                            <MenuItem Header="{DynamicResource Automation_Condition_IsLocked}" Command="{Binding $parent[UserControl].DataContext.AddConditionCommand}" CommandParameter="IsLocked">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="LockClosed"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Condition_TimeRange}" Command="{Binding $parent[UserControl].DataContext.AddConditionCommand}" CommandParameter="TimeRange">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Calendar"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Condition_DayOfWeek}" Command="{Binding $parent[UserControl].DataContext.AddConditionCommand}" CommandParameter="DayOfWeek">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="CalendarWeekNumbers"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{DynamicResource Automation_Condition_AppBlockingEnabled}" Command="{Binding $parent[UserControl].DataContext.AddConditionCommand}" CommandParameter="AppBlockingEnabled">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Prohibited"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Condition_NetworkLockEnabled}" Command="{Binding $parent[UserControl].DataContext.AddConditionCommand}" CommandParameter="NetworkLockEnabled">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Shield"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Condition_ProcessRunning}" Command="{Binding $parent[UserControl].DataContext.AddConditionCommand}" CommandParameter="ProcessRunning">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Apps"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Condition_FileExists}" Command="{Binding $parent[UserControl].DataContext.AddConditionCommand}" CommandParameter="FileExists">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Document"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuItem>
                                                    </Menu>
                                                </Grid>
                                                <TextBlock Text="{DynamicResource Automation_Conditions_Description}" Opacity="0.5" FontSize="12"/>

                                                <ItemsControl ItemsSource="{Binding Conditions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:AutomationCondition">
                                                            <Border Background="{DynamicResource F2LayerDefaultBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                                                <Grid ColumnDefinitions="Auto,*,36">
                                                                    <Panel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Width="20">
                                                                        <fluent:SymbolIcon Symbol="LockClosed" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=IsLocked}"/>
                                                                        <fluent:SymbolIcon Symbol="Calendar" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=TimeRange}"/>
                                                                        <fluent:SymbolIcon Symbol="CalendarWeekNumbers" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DayOfWeek}"/>
                                                                        <fluent:SymbolIcon Symbol="Prohibited" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=AppBlockingEnabled}"/>
                                                                        <fluent:SymbolIcon Symbol="Shield" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkLockEnabled}"/>
                                                                        <fluent:SymbolIcon Symbol="Apps" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessRunning}"/>
                                                                        <fluent:SymbolIcon Symbol="Document" Opacity="0.6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=FileExists}"/>
                                                                    </Panel>
                                                                    <Panel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Left">
                                                                        <!-- TimeRange editor -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=TimeRange}">
                                                                            <TextBlock Text="{DynamicResource Automation_Condition_TimeRange}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0"/>
                                                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableHours}" SelectedItem="{Binding StartHour}" Width="65"/>
                                                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="-4,0"/>
                                                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableMinutes}" SelectedItem="{Binding StartMinute}" Width="65">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding StringFormat={}{0:D2}}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                            <TextBlock Text="{DynamicResource Automation_TimeRange_To}" VerticalAlignment="Center" Margin="8,0"/>
                                                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableHours}" SelectedItem="{Binding EndHour}" Width="65"/>
                                                                            <TextBlock Text=":" VerticalAlignment="Center" Margin="-4,0"/>
                                                                            <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.AvailableMinutes}" SelectedItem="{Binding EndMinute}" Width="65">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding StringFormat={}{0:D2}}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                        </StackPanel>
                                                                        <!-- IsLocked editor -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=IsLocked}">
                                                                            <TextBlock Text="{DynamicResource Automation_Condition_IsLocked}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0"/>
                                                                            <ToggleSwitch IsChecked="{Binding Bool}" OnContent="{DynamicResource Automation_Condition_IsLocked_On}" OffContent="{DynamicResource Automation_Condition_IsLocked_Off}"/>
                                                                        </StackPanel>
                                                                        <!-- AppBlockingEnabled editor -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=AppBlockingEnabled}">
                                                                            <TextBlock Text="{DynamicResource Automation_Condition_AppBlocking}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0"/>
                                                                            <ToggleSwitch IsChecked="{Binding Bool}" OnContent="{DynamicResource Automation_Condition_Enabled}" OffContent="{DynamicResource Automation_Condition_Disabled}"/>
                                                                        </StackPanel>
                                                                        <!-- NetworkLockEnabled editor -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkLockEnabled}">
                                                                            <TextBlock Text="{DynamicResource Automation_Condition_NetworkLock}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0"/>
                                                                            <ToggleSwitch IsChecked="{Binding Bool}" OnContent="{DynamicResource Automation_Condition_Enabled}" OffContent="{DynamicResource Automation_Condition_Disabled}"/>
                                                                        </StackPanel>
                                                                        <!-- DayOfWeek editor -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DayOfWeek}">
                                                                            <TextBlock Text="{DynamicResource Automation_Condition_DayOfWeek}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0"/>
                                                                            <TextBlock Text="{DynamicResource Automation_Condition_DayOfWeek_Description}" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                        <!-- ProcessRunning editor (condition) -->
                                                                        <StackPanel Orientation="Vertical" Spacing="6" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProcessRunning}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <TextBlock Text="{DynamicResource Automation_Condition_ProcessRunning}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0"/>
                                                                                <TextBox x:Name="ConditionFilterBox" Text="{Binding $parent[UserControl].DataContext.ProcessFilterText}" Watermark="{DynamicResource Automation_ProcessFilter_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left"/>
                                                                                <Button Command="{Binding $parent[UserControl].DataContext.RefreshProcessesCommand}" Padding="12,6">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <fluent:SymbolIcon Symbol="ArrowSync"/>
                                                                                        <TextBlock Text="{DynamicResource Automation_Refresh}"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                                <Button Command="{Binding $parent[UserControl].DataContext.UseFilterTextForConditionCommand}" CommandParameter="{Binding}" Padding="12,6">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <fluent:SymbolIcon Symbol="Checkmark"/>
                                                                                        <TextBlock Text="{DynamicResource Automation_Fill}"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </StackPanel>
                                                                            <Popup PlacementTarget="{Binding #ConditionFilterBox}" Placement="BottomEdgeAlignedLeft" IsOpen="{Binding #ConditionFilterBox.IsFocused}">
                                                                                <Border Background="{DynamicResource F2CardBackgroundDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource F2CardStrokeBrush}" CornerRadius="4" Padding="4" Width="{Binding #ConditionFilterBox.Width}" MaxHeight="240">
                                                                                    <ListBox ItemsSource="{Binding $parent[UserControl].DataContext.FilteredSuggestions}" SelectionChanged="OnConditionSuggestionSelected" Tag="{Binding}">
                                                                                        <ListBox.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <Grid ColumnDefinitions="Auto,*" Margin="0,2" Tapped="OnConditionSuggestionTapped">
                                                                                                    <fluent:SymbolIcon Grid.Column="0" Symbol="{Binding Icon, Converter={x:Static Converters:FontAwesomeToFluentIconConverter.Instance}}"/>
                                                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                                                                        <TextBlock Text="{Binding Name}"/>
                                                                                                        <TextBlock Text="{Binding Path}" Classes="caption" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                                                                                    </StackPanel>
                                                                                                </Grid>
                                                                                            </DataTemplate>
                                                                                        </ListBox.ItemTemplate>
                                                                                    </ListBox>
                                                                                </Border>
                                                                            </Popup>
                                                                            <WrapPanel>
                                                                                <TextBox Text="{Binding ProcessName}" Watermark="{DynamicResource Automation_ProcessName_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                                                                            </WrapPanel>
                                                                            <WrapPanel>
                                                                                <TextBox Text="{Binding FilePath}" Watermark="{DynamicResource Automation_FilePath_Watermark}" Width="360" Classes="clear" HorizontalAlignment="Left" Margin="0,0,8,8"/>
                                                                                <Button Command="{Binding $parent[UserControl].DataContext.PickConditionExeCommand}" CommandParameter="{Binding}" Padding="12,6" Classes="accent" Margin="0,0,8,8">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <fluent:SymbolIcon Symbol="FolderOpen"/>
                                                                                        <TextBlock Text="{DynamicResource Automation_Browse}"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </WrapPanel>
                                                                        </StackPanel>
                                                                        <!-- FileExists editor (condition) -->
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=FileExists}">
                                                                            <TextBlock Text="{DynamicResource Automation_Condition_FileExists}" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,8,0"/>
                                                                            <TextBox Text="{Binding FilePath}" Watermark="{DynamicResource Automation_FilePath_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left"/>
                                                                        </StackPanel>
                                                                    </Panel>
                                                                    <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.RemoveConditionCommand}" CommandParameter="{Binding}" Classes="danger icon-sm">
                                                                        <fluent:SymbolIcon Symbol="Dismiss"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <!-- ===== Connector 2->3 ===== -->
                                        <StackPanel HorizontalAlignment="Center" Spacing="0" Margin="0,-4">
                                            <Border Width="2" Height="12" Background="{DynamicResource F2DividerStrokeBrush}"/>
                                            <fluent:SymbolIcon Symbol="ChevronDown" Opacity="0.3" Width="14" Height="14"/>
                                        </StackPanel>

                                        <!-- ===== Pipeline Stage 3: Actions ===== -->
                                        <Border Classes="Card">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4" Background="{DynamicResource F2AccentDefaultBrush}">
                                                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource Automation_ActionsSection}" Classes="SectionHeader"/>
                                                    </StackPanel>
                                                    <Menu Grid.Column="2" Background="Transparent">
                                                        <MenuItem Header="{DynamicResource Automation_AddAction}" Classes="accent">
                                                            <MenuItem.Icon>
                                                                <fluent:SymbolIcon Symbol="Add"/>
                                                            </MenuItem.Icon>
                                                            <MenuItem Header="{DynamicResource Automation_Action_LockFull}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="LockFull">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="PersonLock"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Action_Shutdown}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="Shutdown">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Power"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Action_Restart}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="Restart">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="ArrowSync"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{DynamicResource Automation_Action_NetworkLockOn}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="NetworkLockOn">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Shield"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Action_NetworkLockOff}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="NetworkLockOff">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="LockOpen"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Action_AppBlockOn}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="AppBlockOn">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Prohibited"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Action_AppBlockOff}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="AppBlockOff">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="CheckmarkCircle"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{DynamicResource Automation_Action_WebcamCapture}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="WebcamCapture">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Camera"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Action_ScreenShot}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="ScreenShot">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Image"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Action_PlaySound}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="PlaySound">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Speaker2"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{DynamicResource Automation_Action_OpenUrl}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="OpenUrl">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Link"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Action_RunProcess}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="RunProcess">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Play"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator/>
                                                            <MenuItem Header="{DynamicResource Automation_Action_BasicProtectionOn}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="BasicProtectionOn">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Shield"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="{DynamicResource Automation_Action_BasicProtectionOff}" Command="{Binding $parent[UserControl].DataContext.AddActionCommand}" CommandParameter="BasicProtectionOff">
                                                                <MenuItem.Icon>
                                                                    <fluent:SymbolIcon Symbol="Shield"/>
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuItem>
                                                    </Menu>
                                                </Grid>
                                                <TextBlock Text="{DynamicResource Automation_Actions_Description}" Opacity="0.5" FontSize="12"/>

                                                <ItemsControl ItemsSource="{Binding Actions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:AutomationAction">
                                                            <Border Background="{DynamicResource F2LayerDefaultBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                                                <Grid ColumnDefinitions="Auto,*,36">
                                                                    <Panel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Width="20">
                                                                        <fluent:SymbolIcon Symbol="PersonLock" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=LockFull}"/>
                                                                        <fluent:SymbolIcon Symbol="Power" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Shutdown}"/>
                                                                        <fluent:SymbolIcon Symbol="ArrowSync" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Restart}"/>
                                                                        <fluent:SymbolIcon Symbol="Shield" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkLockOn}"/>
                                                                        <fluent:SymbolIcon Symbol="LockOpen" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkLockOff}"/>
                                                                        <fluent:SymbolIcon Symbol="Prohibited" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=AppBlockOn}"/>
                                                                        <fluent:SymbolIcon Symbol="CheckmarkCircle" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=AppBlockOff}"/>
                                                                        <fluent:SymbolIcon Symbol="Camera" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=WebcamCapture}"/>
                                                                        <fluent:SymbolIcon Symbol="Image" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ScreenShot}"/>
                                                                        <fluent:SymbolIcon Symbol="Speaker2" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=PlaySound}"/>
                                                                        <fluent:SymbolIcon Symbol="Link" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OpenUrl}"/>
                                                                        <fluent:SymbolIcon Symbol="Play" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=RunProcess}"/>
                                                                        <fluent:SymbolIcon Symbol="Shield" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BasicProtectionOn}"/>
                                                                        <fluent:SymbolIcon Symbol="Shield" Foreground="{DynamicResource F2AccentTextPrimaryBrush}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BasicProtectionOff}"/>
                                                                    </Panel>
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0" HorizontalAlignment="Left" Spacing="8">
                                                                        <TextBlock Text="{DynamicResource Automation_Action_LockFull_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=LockFull}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_Shutdown_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Shutdown}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_Restart_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Restart}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_NetworkLockOn_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkLockOn}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_NetworkLockOff_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NetworkLockOff}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_AppBlockOn_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=AppBlockOn}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_AppBlockOff_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=AppBlockOff}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_BasicProtectionOn_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BasicProtectionOn}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_BasicProtectionOff_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=BasicProtectionOff}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_WebcamCapture_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=WebcamCapture}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_ScreenShot_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ScreenShot}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_PlaySound_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=PlaySound}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_OpenUrl_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OpenUrl}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_RunProcess_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=RunProcess}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                        <TextBlock Text="{DynamicResource Automation_Action_Notify_Display}" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Notify}" VerticalAlignment="Center" FontWeight="SemiBold"/>

                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=WebcamCapture}">
                                                                            <TextBlock Text="{DynamicResource Automation_Delay_Seconds}" VerticalAlignment="Center" Opacity="0.6"/>
                                                                            <ComboBox ItemsSource="{Binding #AutomationRoot.DataContext.AvailableCaptureDelays}" SelectedItem="{Binding DelaySeconds}" Width="100">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ScreenShot}">
                                                                            <TextBlock Text="{DynamicResource Automation_Delay_Seconds}" VerticalAlignment="Center" Opacity="0.6"/>
                                                                            <ComboBox ItemsSource="{Binding #AutomationRoot.DataContext.AvailableCaptureDelays}" SelectedItem="{Binding DelaySeconds}" Width="100">
                                                                                <ComboBox.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <TextBlock Text="{Binding}"/>
                                                                                    </DataTemplate>
                                                                                </ComboBox.ItemTemplate>
                                                                            </ComboBox>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Notify}">
                                                                            <TextBlock Text="{DynamicResource Automation_Action_Notify_Label}" VerticalAlignment="Center" Opacity="0.6"/>
                                                                            <TextBox Text="{Binding Text}" Watermark="{DynamicResource Automation_Action_Notify_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left"/>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OpenUrl}">
                                                                            <TextBlock Text="{DynamicResource Automation_Action_OpenUrl_Label}" VerticalAlignment="Center" Opacity="0.6"/>
                                                                            <TextBox Text="{Binding Text}" Watermark="https://" Width="300" Classes="clear" HorizontalAlignment="Left"/>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Type, Converter={StaticResource StringEqualsConverter}, ConverterParameter=RunProcess}">
                                                                            <TextBlock Text="{DynamicResource Automation_Action_RunProcess_Label}" VerticalAlignment="Center" Opacity="0.6"/>
                                                                            <TextBox Text="{Binding Text}" Watermark="{DynamicResource Automation_Action_RunProcess_Watermark}" Width="300" Classes="clear" HorizontalAlignment="Left"/>
                                                                            <Button Command="{Binding $parent[UserControl].DataContext.PickRunProcessExeCommand}" CommandParameter="{Binding}" Padding="12,6" Classes="accent">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <fluent:SymbolIcon Symbol="FolderOpen"/>
                                                                                    <TextBlock Text="{DynamicResource Automation_Browse}"/>
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.RemoveActionCommand}" CommandParameter="{Binding}" Classes="danger icon-sm">
                                                                        <fluent:SymbolIcon Symbol="Dismiss"/>
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Empty State -->
                        <Border IsVisible="{Binding SelectedWorkflow, Converter={StaticResource IsNullConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,100,0,0">
                            <StackPanel Spacing="16" HorizontalAlignment="Center">
                                <fluent:SymbolIcon Symbol="Bot" Width="64" Height="64" Opacity="0.1"/>
                                <TextBlock Text="{DynamicResource Automation_SelectWorkflow_Prompt}" Opacity="0.4" FontSize="16"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </ScrollViewer>

        <!-- ============ Bottom Warning Bar ============ -->
        <Border Grid.Row="3" Background="{DynamicResource F2SystemCautionBackgroundBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource F2DividerStrokeBrush}"
                IsVisible="{Binding !IsAutomationEnabled}" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <fluent:SymbolIcon Symbol="Warning" Foreground="{DynamicResource F2SystemCautionBrush}" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource Automation_Disabled_Warning}" Foreground="{DynamicResource F2TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{DynamicResource Automation_EnableNow}" Command="{Binding ToggleAutomationCommand}" Classes="accent" Padding="16,6" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
