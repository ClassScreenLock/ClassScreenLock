<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:Converters="clr-namespace:ClassScreenLock.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ClassScreenLock.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <Grid Margin="24">
        <!-- 概览卡片 -->
        <Grid ColumnDefinitions="*, 16, *, 16, *, 16, *" RowDefinitions="Auto, 16, *">
            <!-- 下一个计划 -->
            <Border Grid.Row="0" Grid.Column="0" Classes="card" Padding="12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <fluent:SymbolIcon Symbol="HourglassHalf" Foreground="{DynamicResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="{DynamicResource Home_NextSchedule}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NextScheduleText}" FontSize="{DynamicResource F2FontSizeSubtitle}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 拦截应用 -->
            <Border Grid.Row="0" Grid.Column="2" Classes="card" Padding="12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <fluent:SymbolIcon Symbol="Apps" Foreground="{DynamicResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="{DynamicResource Home_BlockedApps}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BlockedAppsCount}" FontSize="{DynamicResource F2FontSizeH4}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 网络拦截 -->
            <Border Grid.Row="0" Grid.Column="4" Classes="card" Padding="12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <fluent:SymbolIcon Symbol="Globe" Foreground="{DynamicResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="{DynamicResource Home_NetworkInterception}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BlockedNetworkCount}" FontSize="{DynamicResource F2FontSizeH4}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- UIAccess提权状态 -->
            <Border Grid.Row="0" Grid.Column="6" Classes="card" Padding="12">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <fluent:SymbolIcon Symbol="Shield" Foreground="{DynamicResource SystemAccentColor}" FontSize="16"/>
                        <TextBlock Text="{DynamicResource Home_UIAccessElevation}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding HasUiAccess, Converter={StaticResource SuccessStatusBrushConverter}}"/>
                        <TextBlock Text="{Binding UiAccessStatusText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 快速操作区（动态可编辑） -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Classes="card" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Home_QuickActions}" FontSize="{DynamicResource F2FontSizeSubtitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="transparent" Command="{Binding EditQuickActionsCommand}" ToolTip.Tip="{DynamicResource QA_EditTooltip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <fluent:SymbolIcon Symbol="Edit" FontSize="14"/>
                                <TextBlock Text="{DynamicResource Home_EditQuickActions}" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding QuickActions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" HorizontalAlignment="Stretch"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:QuickActionItemViewModel">
                                <Button Classes="transparent"
                                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).OpenQuickActionCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Padding="12,10"
                                        Margin="2"
                                        CornerRadius="{DynamicResource F2RadiusControl}"
                                        ToolTip.Tip="{Binding Label}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <fluent:SymbolIcon Symbol="{Binding IconName}" FontSize="16" Foreground="{Binding AccentColor}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>