<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:models="clr-namespace:ClassScreenLock.Models"
             xmlns:Converters="clr-namespace:ClassScreenLock.Converters"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ClassScreenLock.Views.InitializationView"
             x:DataType="vm:InitializationViewModel">

    <UserControl.Resources>
        <Converters:ServiceStatusBrushConverter x:Key="ServiceStatusBrushConverter"/>
    </UserControl.Resources>

    <Panel>
        <!-- 主初始化界面 -->
        <Border Padding="32" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="4">
            <Grid RowDefinitions="Auto,* ,Auto">
                <!-- 顶部标题 + 步骤计数 -->
                <Grid Grid.Row="0" ColumnDefinitions="* , Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{DynamicResource Initialization_Title}" Classes="h1"/>
                        <TextBlock Text="{DynamicResource Initialization_Subtitle}" Classes="caption" Opacity="0.6"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Initialization_Steps}" Classes="caption" Opacity="0.6"/>
                        <TextBlock Text="{Binding StepDisplay}" FontWeight="SemiBold"/>
                        <TextBlock Text="/" Opacity="0.6"/>
                        <TextBlock Text="{Binding StepTotal}" Opacity="0.6"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,16,0,0">
                    <ProgressBar Grid.Row="0" Minimum="0" Maximum="{Binding StepProgressMax}" Value="{Binding StepProgressValue}" Height="4"/>

                    <Carousel x:Name="InitCarousel" Grid.Row="1" SelectedIndex="{Binding StepIndex}">
                        <Carousel.Transitions>
                            <Transitions>
                                <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                            </Transitions>
                        </Carousel.Transitions>
                        <Carousel.Items>
                            <!-- ====== Step 0: 欢迎与协议 ====== -->
                            <ScrollViewer>
                                <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20">
                                    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="4" Padding="20">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="欢迎使用 ClassScreenLock" Classes="h2"/>
                                            <TextBlock Text="感谢您选择我们的课堂监控与安全防护系统" Classes="caption" Opacity="0.6"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Spacing="16">
                                        <TextBlock Text="在开始之前，我们需要引导您完成一些基础配置，包括管理员账户、监控策略以及安全设置。这些步骤将确保软件能够按照您的需求正常运行。"
                                                   TextWrapping="Wrap" Opacity="0.7" LineHeight="20"/>

                                        <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}" CornerRadius="4" Padding="16" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                    <fluent:SymbolIcon Symbol="Info" FontSize="16" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="请阅读并同意用户协议与隐私政策以继续：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </Grid>

                                                <Button Command="{Binding OpenUserAgreementCommand}"
                                                        Classes="link"
                                                        Padding="0"
                                                        HorizontalAlignment="Left"
                                                        Background="Transparent"
                                                        BorderThickness="0">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="查看用户协议与隐私政策" Foreground="{DynamicResource SystemControlBackgroundAccentBrush}" TextDecorations="Underline"/>
                                                        <fluent:SymbolIcon Symbol="ArrowSquareUpRight" FontSize="10" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <CheckBox IsChecked="{Binding IsAgreementAccepted}" Content="我已阅读并同意上述用户协议与隐私政策" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ====== Step 1: 系统配置 ====== -->
                            <ScrollViewer>
                                <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Init_SystemConfig_Title}" Classes="h3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Init_AvailableInSettings}" Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Classes="card" Padding="24" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" Spacing="32" HorizontalAlignment="Center">
                                            <ToggleSwitch Content="{DynamicResource Settings_DarkMode}" IsChecked="{Binding DarkMode}"/>
                                            <ToggleSwitch Content="{DynamicResource Settings_UseSystemAccentColor}" IsChecked="{Binding UseSystemAccentColor}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card" Padding="24">
                                        <StackPanel Orientation="Horizontal" Spacing="32" HorizontalAlignment="Center">
                                            <StackPanel Width="300" Spacing="8">
                                                <TextBlock Text="{DynamicResource Settings_InterfaceLanguage}"/>
                                                <ComboBox ItemsSource="{Binding LanguageOptions}"
                                                          SelectedItem="{Binding Language}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                            <StackPanel Width="300" Spacing="8">
                                                <TextBlock Text="{DynamicResource Settings_AccentColor}"/>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <ComboBox ItemsSource="{Binding AccentColorOptions}"
                                                              SelectedItem="{Binding AccentColor}" HorizontalAlignment="Stretch"/>
                                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="4" Margin="8,0,0,0"
                                                            Background="{Binding AccentColor, Converter={x:Static Converters:StringToBrushConverter.Instance}}"
                                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                            BorderThickness="1"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ====== Step 2: 用户偏好 ====== -->
                            <ScrollViewer>
                                <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Init_UserPreferences_Title}" Classes="h3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Init_AvailableInSettings}" Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Classes="card" Padding="24">
                                        <ToggleSwitch Content="{DynamicResource Settings_ShowNotifications}" IsChecked="{Binding ShowNotifications}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ====== Step 3: 监控配置 ====== -->
                            <ScrollViewer>
                                <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="监控配置" Classes="h3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="配置屏幕截图与摄像头拍照策略" Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Classes="card" Padding="24">
                                        <StackPanel Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <fluent:SymbolIcon Symbol="Desktop" FontSize="16"/>
                                                <TextBlock Text="屏幕截图设置" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                                                <ToggleSwitch Grid.Row="0" Grid.Column="0" Content="上课期间启用屏幕截图" IsChecked="{Binding EnableClassScreenshot}"/>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding EnableClassScreenshot}">
                                                    <TextBlock Text="间隔(分钟):" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding ScreenshotIntervalOptions}" SelectedItem="{Binding ClassScreenshotInterval}" Width="100"/>
                                                </StackPanel>

                                                <ToggleSwitch Grid.Row="1" Grid.Column="0" Content="课间休息启用屏幕截图" IsChecked="{Binding EnableBreakScreenshot}" Margin="0,12,0,0"/>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding EnableBreakScreenshot}" Margin="0,12,0,0">
                                                    <TextBlock Text="间隔(分钟):" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding ScreenshotIntervalOptions}" SelectedItem="{Binding BreakScreenshotInterval}" Width="100"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="card" Padding="24">
                                        <StackPanel Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <fluent:SymbolIcon Symbol="Camera" FontSize="16"/>
                                                <TextBlock Text="摄像头拍照设置" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="选择摄像头"/>
                                                <ComboBox ItemsSource="{Binding CameraOptions}"
                                                          SelectedValue="{Binding SelectedCamera}"
                                                          SelectedValueBinding="{Binding Moniker}"
                                                          DisplayMemberBinding="{Binding Name}"
                                                          HorizontalAlignment="Stretch"
                                                          PlaceholderText="未检测到摄像头或请选择"/>
                                            </StackPanel>

                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                                                <ToggleSwitch Grid.Row="0" Grid.Column="0" Content="上课期间启用拍照" IsChecked="{Binding EnableClassWebcam}"/>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding EnableClassWebcam}">
                                                    <TextBlock Text="间隔(分钟):" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding ScreenshotIntervalOptions}" SelectedItem="{Binding ClassWebcamInterval}" Width="100"/>
                                                </StackPanel>

                                                <ToggleSwitch Grid.Row="1" Grid.Column="0" Content="课间休息启用拍照" IsChecked="{Binding EnableBreakWebcam}" Margin="0,12,0,0"/>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding EnableBreakWebcam}" Margin="0,12,0,0">
                                                    <TextBlock Text="间隔(分钟):" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding ScreenshotIntervalOptions}" SelectedItem="{Binding BreakWebcamInterval}" Width="100"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ====== Step 4: 权限设置 ====== -->
                            <ScrollViewer>
                                <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Init_PermissionSetup_Title}" Classes="h3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Init_AvailableInSecurityCenter}" Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Classes="card" Padding="24">
                                        <StackPanel Spacing="16">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource Init_AdminLoginVerificationMode}" FontWeight="SemiBold"/>
                                                <ComboBox SelectedIndex="{Binding LoginVerificationModeIndex, Mode=TwoWay}" HorizontalAlignment="Left" Width="400">
                                                    <ComboBoxItem Content="{DynamicResource AdminLoginVerification_PasswordPlusTwoFactor}"/>
                                                    <ComboBoxItem Content="{DynamicResource AdminLoginVerification_PasswordOnly}"/>
                                                    <ComboBoxItem Content="{DynamicResource AdminLoginVerification_TwoFactorOnly}"/>
                                                    <ComboBoxItem Content="{DynamicResource AdminLoginVerification_PasswordOrTwoFactor}"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4" Padding="12">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <fluent:SymbolIcon Symbol="Info" VerticalAlignment="Center" FontSize="16"/>
                                                    <TextBlock Text="{DynamicResource Init_2FA_BindingTip}" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ====== Step 5: 管理员账户 ====== -->
                            <ScrollViewer>
                                <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Init_AdminAccount_Title}" Classes="h3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Init_AdminAccount_Subtitle}" Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <Border Classes="card" Padding="24" IsVisible="{Binding !HasSuperAdminAccount}">
                                        <StackPanel Spacing="20">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource SecurityCenter_Username}"/>
                                                <TextBox Text="{Binding Username}" Watermark="{DynamicResource Init_Username_Watermark}" Classes="clear" Width="400" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource SecurityCenter_Password}"/>
                                                <TextBox Text="{Binding Password}" PasswordChar="●" Watermark="{DynamicResource Init_Password_Watermark}" Classes="clear" Width="400" HorizontalAlignment="Left"/>
                                                <ProgressBar Value="{Binding PasswordStrength}" Height="4" MinHeight="4" Margin="0,4,0,0" Width="400" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource Account_ConfirmPassword}"/>
                                                <TextBox Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="{DynamicResource Init_ConfirmPassword_Watermark}" Classes="clear"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource F2SystemCriticalBrush}" TextWrapping="Wrap" IsVisible="{Binding !!ValidationMessage}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="card" Padding="24" IsVisible="{Binding CanResetAdminPassword}">
                                        <StackPanel Spacing="20">
                                            <TextBlock Text="{DynamicResource Init_ResetAdminPassword_Title}" Classes="h3" HorizontalAlignment="Center"/>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource SecurityCenter_NewPassword}"/>
                                                <TextBox Text="{Binding NewAdminPassword}" PasswordChar="●" Watermark="输入新密码" Classes="clear"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource SecurityCenter_ConfirmPassword}"/>
                                                <TextBox Text="{Binding ConfirmAdminPassword}" PasswordChar="●" Watermark="再次输入新密码" Classes="clear"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                                <Button Content="{DynamicResource Btn_ResetPassword}" Command="{Binding ResetAdminPasswordCommand}" Classes="accent"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="card" Padding="24">
                                         <Border.IsVisible>
                                             <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                 <Binding Path="HasSuperAdminAccount"/>
                                                 <Binding Path="!CanResetAdminPassword"/>
                                             </MultiBinding>
                                         </Border.IsVisible>
                                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                                            <fluent:SymbolIcon Symbol="CheckmarkCircle" FontSize="32" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource SystemAccentColor}"/>
                                            <TextBlock Text="管理员账户已配置" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="您已完成管理员账户设置，可以继续下一步。" Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ====== Step 6: 双重验证 ====== -->
                            <ScrollViewer>
                                <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Init_TwoFactorBinding_Title}" Classes="h3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Init_TwoFactorBinding_Subtitle}" Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Classes="card" Padding="24">
                                        <StackPanel Spacing="24">
                                            <Border CornerRadius="4" Background="{DynamicResource SystemControlBackgroundAltHighBrush}" Padding="16" HorizontalAlignment="Center">
                                                <Image Source="{Binding QrCodeBitmap}" Width="200" Height="200"/>
                                            </Border>

                                            <StackPanel Spacing="12">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Init_ManualSecret}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    <ToggleSwitch IsChecked="{Binding UseManualSecret}" OnContent="手动输入" OffContent="自动" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBox Text="{Binding TwoFactorSecret}" IsReadOnly="True" Watermark="{DynamicResource Init_SystemSecret_Watermark}" Classes="clear" IsVisible="{Binding !UseManualSecret}"/>
                                                <TextBox Text="{Binding ManualSecretInput}" Watermark="{DynamicResource Init_ManualSecret_Watermark}" Classes="clear" IsVisible="{Binding UseManualSecret}"/>
                                            </StackPanel>

                                            <Separator Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.3"/>

                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource Init_TwoFactorCode}" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding TwoFactorInputCode}" Watermark="{DynamicResource Init_TwoFactorCode_Watermark}" Classes="clear" HorizontalContentAlignment="Center" Width="200"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ====== Step 7: 应用拦截 ====== -->
                            <ScrollViewer>
                                <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Init_AppBlocking_Title}" Classes="h3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Init_AppBlocking_Subtitle}" Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Classes="card" Padding="24">
                                        <StackPanel Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="32" HorizontalAlignment="Center">
                                                <ToggleSwitch Content="{DynamicResource Init_EnableBasicProtection}" IsChecked="{Binding BasicProtectionEnabled}"/>
                                                <ToggleSwitch Content="{DynamicResource Init_EnableAppBlocking}" IsChecked="{Binding AppBlockingEnabled}"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8" IsVisible="{Binding BasicProtectionEnabled}">
                                                <TextBlock Text="{DynamicResource AppManagement_ProtectionItemsTitle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource AppManagement_ProtectionItemsDesc}" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                                <ItemsControl ItemsSource="{Binding ProtectionRules}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ProtectionRule">
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}"
                                                                              Command="{Binding $parent[UserControl].((vm:InitializationViewModel)DataContext).ToggleProtectionRuleCommand}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ====== Step 8: 网络拦截 ====== -->
                            <ScrollViewer>
                                <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Center" Margin="0,20">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Init_NetworkBlocking_Title}" Classes="h3" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Init_NetworkBlocking_Subtitle}" Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <Border Classes="card" Padding="24">
                                        <StackPanel Spacing="16">
                                            <ToggleSwitch Content="{DynamicResource Init_EnableNetworkLock}" IsChecked="{Binding NetworkLockEnabled}" HorizontalAlignment="Center"/>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{DynamicResource Init_BlockDomains_Label}" FontWeight="SemiBold"/>
                                                <TextBox Text="{Binding NetworkDomainsText}" Watermark="{DynamicResource Init_BlockDomains_Watermark}" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                                                <TextBlock Text="{DynamicResource Init_ApplyRulesNextStep_Tip}" Classes="caption" Opacity="0.6"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Carousel.Items>
                    </Carousel>
                </Grid>

                <!-- 底部导航按钮 -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Left">
                        <Button Command="{Binding OpenRepositoryCommand}" Classes="outline">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluent:SymbolIcon Symbol="Code" FontSize="16"/>
                                <TextBlock Text="{DynamicResource About_Repository}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenUserAgreementCommand}" Classes="outline">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluent:SymbolIcon Symbol="Document" FontSize="16"/>
                                <TextBlock Text="{DynamicResource About_UserAgreement}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{DynamicResource Btn_Back}" Command="{Binding BackCommand}" Classes="outline"/>
                        <Button Content="{DynamicResource Btn_Skip}" Command="{Binding SkipCommand}" Classes="outline" IsEnabled="{Binding CanSkip}"/>
                        <Button Content="{DynamicResource Btn_Next}" Command="{Binding NextCommand}" Classes="accent"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 欢迎动画层：不透明背景固定不动，仅内容滑入 -->
        <Border x:Name="WelcomeLayer"
                Background="{DynamicResource F2SolidBackgroundBaseBrush}"
                IsVisible="{Binding IsWelcomeVisible}"
                Opacity="{Binding WelcomeOpacity}"
                CornerRadius="4">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel x:Name="WelcomeContent"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="32"
                        Opacity="0">
                <Image Source="/Assets/CSL.png" Width="512" Height="512" Stretch="Uniform" HorizontalAlignment="Center"/>
                <TextBlock Text="正在准备配置引导，请稍后..." Classes="caption" Opacity="0.6" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
