<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
        xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
        xmlns:Converters="clr-namespace:ClassScreenLock.Converters"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="ClassScreenLock.Views.LockWindow"
        x:DataType="vm:LockWindowViewModel"
        Title="Screen Locked"
        WindowState="FullScreen"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        RequestedThemeVariant="Dark"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        KeyDown="Window_OnKeyDown"
        KeyUp="Window_OnKeyUp">

    <Window.Styles>
        <!-- Underlined Text Field — Fluent 规范：透明背景、无圆角、仅底线 -->
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <!-- 软键盘按钮样式 -->
        <Style Selector="Button.keypad">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#28FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style Selector="Button.keypad:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#38FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
        </Style>
        <Style Selector="Button.keypad:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- 功能键样式 -->
        <Style Selector="Button.keypad-func">
            <Setter Property="Background" Value="#38FFFFFF"/>
            <Setter Property="Width" Value="76"/>
        </Style>
        <Style Selector="Button.keypad.caps-on">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 底线状态：默认 1px → hover 加深 → focus 2px 强调色 -->
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        <!-- 水印文字 -->
        <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
            <Setter Property="Foreground" Value="#8CFFFFFF"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <!-- 解锁按钮样式 -->
        <Style Selector="Button.lock-action-btn">
            <Setter Property="Background" Value="#28FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.lock-action-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF"/>
            <Setter Property="BorderBrush" Value="#80FFFFFF"/>
        </Style>
        <Style Selector="Button.lock-action-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#55FFFFFF"/>
        </Style>

        <!-- 关机按钮样式 -->
        <Style Selector="Button.shutdown-btn">
            <Setter Property="Background" Value="#22FF4444"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderBrush" Value="#33FF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Opacity" Value="0.75"/>
        </Style>
        <Style Selector="Button.shutdown-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FF4444"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.shutdown-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#44FF4444"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- 对话框按钮 -->
        <Style Selector="Button.dialog-btn">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Border Background="Black" Opacity="{Binding LockBackgroundOpacity}"/>

        <!-- 锁屏主界面 -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="36" IsVisible="{Binding !IsLoginVisible}">
            <!-- 图标和标题 -->
            <StackPanel Spacing="20" HorizontalAlignment="Center">
                <!-- 图标带圆形背景 -->
                <Border Width="96" Height="96" CornerRadius="48"
                        Background="#1AFFFFFF"
                        HorizontalAlignment="Center">
                    <fluent:SymbolIcon Symbol="LockClosed" FontSize="48" Foreground="White" Opacity="0.95"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource LockScreen_Locked}" FontSize="36" FontWeight="Light" Foreground="White" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#CC000000" BlurRadius="{Binding LockTextShadowBlurRadius}" Opacity="{Binding LockTextShadowOpacity}"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <TextBlock Text="{Binding CurrentTime}" FontSize="112" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#E6000000" BlurRadius="{Binding LockTextShadowBlurRadius}" Opacity="{Binding LockTextShadowOpacity}"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- 倒计时卡片 -->
            <Border CornerRadius="12" Padding="32,14" HorizontalAlignment="Center"
                    IsVisible="{Binding HasCountdown}">
                <Border.Background>
                    <SolidColorBrush Color="#40000000" Opacity="0.85"/>
                </Border.Background>
                <Border.BorderBrush><SolidColorBrush Color="#22FFFFFF"/></Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding NextClassLabel}" FontSize="16" Foreground="White" Opacity="0.85" HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#CC000000" BlurRadius="{Binding LockTextShadowBlurRadius}" Opacity="{Binding LockTextShadowOpacity}"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <fluent:SymbolIcon Symbol="Timer" FontSize="18" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CountdownText}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#CC000000" BlurRadius="{Binding LockTextShadowBlurRadius}"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button Command="{Binding UnlockEarlyCommand}"
                        Classes="lock-action-btn"
                        Height="48"
                        Padding="28,0"
                        CornerRadius="24">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <fluent:SymbolIcon Symbol="LockOpen" FontSize="16" Foreground="White"/>
                        <TextBlock Text="{DynamicResource LockScreen_UnlockEarly}" VerticalAlignment="Center" Foreground="White" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding RelockCommand}"
                        Classes="lock-action-btn"
                        Height="48"
                        Padding="28,0"
                        CornerRadius="24"
                        IsVisible="{Binding CanRelock}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <fluent:SymbolIcon Symbol="LockClosed" FontSize="16" Foreground="White"/>
                        <TextBlock Text="重新锁定" VerticalAlignment="Center" Foreground="White" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- 底部信息 -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,36" IsVisible="{Binding !IsLoginVisible}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{DynamicResource LockScreen_Tagline}"
                       Foreground="White"
                       Opacity="0.5"
                       FontSize="13"
                       VerticalAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#CC000000" BlurRadius="{Binding LockTextShadowBlurRadius}" Opacity="{Binding LockTextShadowOpacity}"/>
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <!-- 右下角关机按钮 -->
        <Button Command="{Binding ShowShutdownDialogCommand}"
                Classes="shutdown-btn"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                IsVisible="{Binding !IsLoginVisible}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <fluent:SymbolIcon Symbol="Power" FontSize="15" Foreground="#FF6B6B"/>
                <TextBlock Text="{DynamicResource LockScreen_Shutdown}" VerticalAlignment="Center" FontWeight="Medium" Foreground="#FF6B6B" FontSize="13"/>
            </StackPanel>
        </Button>

        <!-- 关机确认对话框 -->
        <Panel ZIndex="200">
            <Border Background="#80000000"
                    IsVisible="{Binding IsShutdownDialogVisible}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    x:Name="ShutdownOverlay">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="LinearEasing"/>
                    </Transitions>
                </Border.Transitions>
            </Border>

            <Border CornerRadius="14"
                    Padding="28"
                    Width="340"
                    BoxShadow="0 16 48 0 #CC000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsShutdownDialogVisible}"
                    RenderTransformOrigin="0.5,0.5"
                    x:Name="ShutdownDialog">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#E62D2D2D"/>
                        <GradientStop Offset="1" Color="#E6252525"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush><SolidColorBrush Color="#22FFFFFF"/></Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="QuadraticEaseOut"/>
                        <DoubleTransition Property="(ScaleTransform.ScaleX)" Duration="0:0:0.25" Easing="QuadraticEaseOut"/>
                        <DoubleTransition Property="(ScaleTransform.ScaleY)" Duration="0:0:0.25" Easing="QuadraticEaseOut"/>
                    </Transitions>
                </Border.Transitions>

                <StackPanel Spacing="18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
                        <Border Width="48" Height="48" CornerRadius="24"
                                Background="#22FF4444">
                            <fluent:SymbolIcon Symbol="Power" FontSize="24" Foreground="#FF6B6B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource LockScreen_ConfirmShutdown}" FontSize="22" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ShutdownCountdownText}"
                               FontSize="14"
                               Foreground="White"
                               Opacity="0.85"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               IsVisible="{Binding IsShutdownCountdownActive}"
                               MinHeight="20"/>

                    <TextBlock Text="{DynamicResource LockScreen_ConfirmShutdownMessage}"
                               FontSize="14"
                               Foreground="White"
                               Opacity="0.8"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !IsShutdownCountdownActive}"/>

                    <TextBlock Text="{DynamicResource LockScreen_ShutdownCountdownTip}"
                               FontSize="12"
                               Foreground="White"
                               Opacity="0.45"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !IsShutdownCountdownActive}"/>

                    <ProgressBar Value="{Binding ShutdownCountdown}"
                                 Maximum="5"
                                 Minimum="0"
                                 Height="3"
                                 CornerRadius="2"
                                 Foreground="#FF6B6B"
                                 Background="#33FF4444"
                                 IsVisible="{Binding IsShutdownCountdownActive}"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4,0,0">
                        <Button Grid.Column="0"
                                Classes="dialog-btn"
                                Command="{Binding CancelShutdownCommand}"
                                Content="{DynamicResource LockScreen_Cancel}"
                                HorizontalAlignment="Stretch"
                                Background="#18FFFFFF"
                                BorderThickness="1"
                                BorderBrush="#22FFFFFF"
                                Foreground="White"/>
                        <Button Grid.Column="1"
                                Classes="dialog-btn"
                                Command="{Binding ConfirmShutdownCommand}"
                                IsVisible="{Binding !IsShutdownCountdownActive}"
                                Content="{DynamicResource LockScreen_ConfirmShutdown}"
                                HorizontalAlignment="Stretch"
                                Background="#33FF4444"
                                Foreground="White"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Panel>

        <!-- 登录覆盖层 -->
        <Border Background="#CC000000" IsVisible="{Binding IsLoginVisible}" ZIndex="100">
            <Grid RowDefinitions="*,Auto">
                <!-- 登录表单 -->
                <Border Grid.Row="0" CornerRadius="16" Padding="28" Width="440" BoxShadow="0 12 40 0 #80000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#F02D2D2D"/>
                            <GradientStop Offset="1" Color="#F0252525"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#22FFFFFF"/></Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <StackPanel Spacing="14">
                        <!-- 标题区域 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="14" Margin="0,0,0,4">
                            <Border Width="48" Height="48" CornerRadius="24"
                                    Background="#22FFFFFF">
                                <fluent:SymbolIcon Symbol="ShieldPerson" FontSize="26"
                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{DynamicResource LockScreen_Authentication}"
                                       FontSize="20" FontWeight="SemiBold" Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBox Text="{Binding Username}"
                                 Watermark="{DynamicResource LockScreen_EnterUsername}"
                                 Height="44"
                                 Width="360"
                                 CornerRadius="8"
                                 HorizontalAlignment="Center"
                                 GotFocus="TextBox_OnGotFocus"
                                 Name="UsernameBox"/>

                        <Grid Width="360" HorizontalAlignment="Center" IsVisible="{Binding IsPasswordInputVisible}">
                            <TextBox Text="{Binding Password}"
                                     Watermark="{DynamicResource LockScreen_EnterPassword}"
                                     PasswordChar="{Binding PasswordChar}"
                                     Height="44"
                                     CornerRadius="8"
                                     Padding="45,0"
                                     HorizontalAlignment="Stretch"
                                     GotFocus="TextBox_OnGotFocus"
                                     Name="PasswordBox"
                                     TextInput="PasswordBox_OnTextInput"/>
                            <Button Command="{Binding TogglePasswordVisibilityCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <fluent:SymbolIcon Symbol="{Binding PasswordIcon, Converter={x:Static Converters:FontAwesomeToFluentIconConverter.Instance}}"
                                            Width="16" Height="16" Foreground="#80FFFFFF"/>
                            </Button>
                        </Grid>

                        <TextBox Text="{Binding TwoFactorCode}"
                                 IsVisible="{Binding IsTwoFactorInputVisible}"
                                 Watermark="{DynamicResource LockScreen_EnterTwoFactorCode}"
                                 MaxLength="6"
                                 Height="44"
                                 Width="360"
                                 CornerRadius="8"
                                 HorizontalAlignment="Center"
                                 GotFocus="TextBox_OnGotFocus"
                                 Name="TwoFactorBox"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,2,0,0">
                            <TextBlock Text="{DynamicResource LockScreen_CapsLockOn}" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding IsCapsLockEnabled}" FontSize="12"/>
                            <TextBlock Text="{DynamicResource LockScreen_CapsLockOff}" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding !IsCapsLockEnabled}" FontSize="12"/>
                            <TextBlock Text="{DynamicResource LockScreen_SymbolMode}" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding IsSymbolModeEnabled}" FontSize="12"/>
                            <TextBlock Text="{DynamicResource LockScreen_LetterMode}" Foreground="{DynamicResource SystemAccentColor}" IsVisible="{Binding !IsSymbolModeEnabled}" FontSize="12"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                            <Button
                                Grid.Column="0"
                                Classes="dialog-btn"
                                Command="{Binding CancelLoginCommand}"
                                Content="{DynamicResource LockScreen_Cancel}"
                                HorizontalAlignment="Stretch"
                                Background="#18FFFFFF"
                                BorderThickness="1"
                                BorderBrush="#22FFFFFF"
                                Foreground="White"/>
                            <Button
                                Grid.Column="1"
                                Classes="dialog-btn"
                                Command="{Binding VerifyUnlockCommand}"
                                Content="{DynamicResource LockScreen_VerifyAndUnlock}"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource SystemAccentColor}"
                                Foreground="White"/>
                        </Grid>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#FF6B6B"
                                   HorizontalAlignment="Center"
                                   IsVisible="{Binding HasError}"
                                   TextAlignment="Center"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- 虚拟键盘 (固定在底部，避免被输入框挤走) -->
                <Border Grid.Row="1" CornerRadius="16" Padding="16" Width="680" BoxShadow="0 10 30 0 #80000000" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#F02D2D2D"/>
                            <GradientStop Offset="1" Color="#F0252525"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#22FFFFFF"/></Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <StackPanel Spacing="5">
                        <!-- 第一行: 数字 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Classes="keypad" Content="1" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="1"/>
                            <Button Classes="keypad" Content="2" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="2"/>
                            <Button Classes="keypad" Content="3" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="3"/>
                            <Button Classes="keypad" Content="4" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="4"/>
                            <Button Classes="keypad" Content="5" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="5"/>
                            <Button Classes="keypad" Content="6" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="6"/>
                            <Button Classes="keypad" Content="7" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="7"/>
                            <Button Classes="keypad" Content="8" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="8"/>
                            <Button Classes="keypad" Content="9" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="9"/>
                            <Button Classes="keypad" Content="0" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="0"/>
                            <Button Classes="keypad keypad-func" Command="{Binding BackspaceCommand}">
                                <fluent:SymbolIcon Symbol="Backspace" FontSize="18"/>
                            </Button>
                        </StackPanel>

                        <!-- 字母模式行 -->
                        <StackPanel x:Name="LetterRows" Spacing="5" IsVisible="{Binding IsLetterModeVisible}">
                            <!-- 第二行: QWERTY -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Classes="keypad" Content="q" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="q"/>
                                <Button Classes="keypad" Content="w" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="w"/>
                                <Button Classes="keypad" Content="e" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="e"/>
                                <Button Classes="keypad" Content="r" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="r"/>
                                <Button Classes="keypad" Content="t" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="t"/>
                                <Button Classes="keypad" Content="y" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="y"/>
                                <Button Classes="keypad" Content="u" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="u"/>
                                <Button Classes="keypad" Content="i" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="i"/>
                                <Button Classes="keypad" Content="o" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="o"/>
                                <Button Classes="keypad" Content="p" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="p"/>
                            </StackPanel>

                            <!-- 第三行: ASDFG -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Classes="keypad" Content="a" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="a"/>
                                <Button Classes="keypad" Content="s" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="s"/>
                                <Button Classes="keypad" Content="d" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="d"/>
                                <Button Classes="keypad" Content="f" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="f"/>
                                <Button Classes="keypad" Content="g" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="g"/>
                                <Button Classes="keypad" Content="h" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="h"/>
                                <Button Classes="keypad" Content="j" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="j"/>
                                <Button Classes="keypad" Content="k" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="k"/>
                                <Button Classes="keypad" Content="l" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="l"/>
                                <Button Classes="keypad keypad-func" Content="{DynamicResource LockScreen_Clear}" Command="{Binding ClearFocusedFieldCommand}"/>
                            </StackPanel>

                            <!-- 第四行: ZXCVB + 空格/快捷 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Classes="keypad" Content="z" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="z"/>
                                <Button Classes="keypad" Content="x" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="x"/>
                                <Button Classes="keypad" Content="c" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="c"/>
                                <Button Classes="keypad" Content="v" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="v"/>
                                <Button Classes="keypad" Content="b" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="b"/>
                                <Button Classes="keypad" Content="n" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="n"/>
                                <Button Classes="keypad" Content="m" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="m"/>
                                <Button Classes="keypad" Content="." Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="."/>
                                <Button Classes="keypad" Content="_" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="_"/>
                                <Button Classes="keypad keypad-func" Content="{DynamicResource LockScreen_Space}" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter=" "/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 符号模式行 -->
                        <StackPanel x:Name="SymbolRows" Spacing="5" IsVisible="{Binding IsSymbolModeEnabled}">
                            <!-- 常用符号第一行 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Classes="keypad" Content="@" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="@"/>
                                <Button Classes="keypad" Content="#" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="#"/>
                                <Button Classes="keypad" Content="$" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="$"/>
                                <Button Classes="keypad" Content="%" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="%"/>
                                <Button Classes="keypad" Content="&amp;" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="&amp;"/>
                                <Button Classes="keypad" Content="(" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="("/>
                                <Button Classes="keypad" Content=")" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter=")"/>
                                <Button Classes="keypad" Content="-" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="-"/>
                                <Button Classes="keypad" Content="+" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="+"/>
                                <Button Classes="keypad" Content="=" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="="/>
                            </StackPanel>

                            <!-- 常用符号第二行 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Classes="keypad" Content="!" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="!"/>
                                <Button Classes="keypad" Content="?" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="?"/>
                                <Button Classes="keypad" Content="," Command="{Binding AppendToFocusedFieldCommand}" CommandParameter=","/>
                                <Button Classes="keypad" Content="." Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="."/>
                                <Button Classes="keypad" Content=":" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter=":"/>
                                <Button Classes="keypad" Content=";" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter=";"/>
                                <Button Classes="keypad" Content="/" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="/"/>
                                <Button Classes="keypad" Content="\\" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="\\"/>
                                <Button Classes="keypad" Content="[" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="["/>
                                <Button Classes="keypad" Content="]" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="]"/>
                            </StackPanel>

                            <!-- 符号第三行: 中文标点 + 空格 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Classes="keypad" Content="（" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="（"/>
                                <Button Classes="keypad" Content="）" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="）"/>
                                <Button Classes="keypad" Content="。" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="。"/>
                                <Button Classes="keypad" Content="，" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="，"/>
                                <Button Classes="keypad" Content="？" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="？"/>
                                <Button Classes="keypad" Content="！" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="！"/>
                                <Button Classes="keypad" Content="·" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter="·"/>
                                <Button Classes="keypad keypad-func" Content="{DynamicResource LockScreen_Space}" Command="{Binding AppendToFocusedFieldCommand}" CommandParameter=" "/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 模式切换行 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button x:Name="CapsKey"
                                    Classes="keypad keypad-func"
                                    Classes.caps-on="{Binding IsCapsLockEnabled}"
                                    Width="116"
                                    Command="{Binding ToggleCapsLockCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <fluent:SymbolIcon Symbol="ArrowUp" FontSize="15"/>
                                    <TextBlock Text="{DynamicResource LockScreen_Caps}" IsVisible="{Binding IsCapsLockEnabled}"/>
                                    <TextBlock Text="{DynamicResource LockScreen_Lowercase}" IsVisible="{Binding !IsCapsLockEnabled}"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="SymbolKey"
                                    Classes="keypad keypad-func"
                                    Width="116"
                                    Margin="8,0,0,0"
                                    Command="{Binding ToggleSymbolModeCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <fluent:SymbolIcon Symbol="NumberSymbol" FontSize="15"/>
                                    <TextBlock Text="{DynamicResource LockScreen_Symbols}"/>
                                </StackPanel>
                            </Button>

                            <!-- 解锁按钮 -->
                            <Button Classes="keypad keypad-func"
                                    Width="116"
                                    Margin="8,0,0,0"
                                    Command="{Binding VerifyUnlockCommand}"
                                    Background="{DynamicResource SystemAccentColor}"
                                    BorderBrush="{DynamicResource SystemAccentColor}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <fluent:SymbolIcon Symbol="LockOpen" FontSize="15"/>
                                    <TextBlock Text="{DynamicResource LockScreen_Unlock}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
