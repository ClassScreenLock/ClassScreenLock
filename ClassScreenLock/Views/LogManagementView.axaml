<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:Converters="clr-namespace:ClassScreenLock.Converters"
             xmlns:services="clr-namespace:ClassScreenLock.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassScreenLock.Views.LogManagementView"
             x:DataType="vm:LogManagementViewModel">

    <Design.DataContext>
        <vm:LogManagementViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="{DynamicResource Log_Title}" Classes="h1" Margin="24,24,24,8"/>

        <!-- 第一行：搜索与筛选 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="24,0,24,8">
            <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="{DynamicResource Log_Search_Watermark}" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}" Width="140" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="2" ItemsSource="{Binding AvailableSources}" SelectedItem="{Binding SelectedSource}" Width="160" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Command="{Binding RefreshLogsCommand}" Classes="outline" Width="100" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <fluent:SymbolIcon Symbol="ArrowSync" FontSize="14"/>
                    <TextBlock Text="{DynamicResource Log_Refresh}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="4" Command="{Binding ToggleDisplayModeCommand}" Classes="outline" Width="140">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <fluent:SymbolIcon Symbol="{Binding IsTableView, Converter={x:Static Converters:BoolToIconConverter.Instance}}" FontSize="14"/>
                    <TextBlock IsVisible="{Binding IsTableView}" Text="{DynamicResource Log_TableView}"/>
                    <TextBlock IsVisible="{Binding !IsTableView}" Text="{DynamicResource Log_TextView}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- 第二行：操作按钮 -->
        <WrapPanel Grid.Row="2" Margin="24,0,24,12" ItemSpacing="8">
            <Button Command="{Binding ExportCsvAskPathCommand}" Classes="accent">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fluent:SymbolIcon Symbol="ArrowExport" FontSize="14"/>
                    <TextBlock Text="{DynamicResource Log_ExportCsv}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportJsonAskPathCommand}" Classes="accent">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fluent:SymbolIcon Symbol="ArrowExport" FontSize="14"/>
                    <TextBlock Text="{DynamicResource Log_ExportJson}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportCsvBySourceCommand}" Classes="outline">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fluent:SymbolIcon Symbol="Folder" FontSize="14"/>
                    <TextBlock Text="{DynamicResource Log_ExportCsvBySource}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ExportJsonBySourceCommand}" Classes="outline">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fluent:SymbolIcon Symbol="Folder" FontSize="14"/>
                    <TextBlock Text="{DynamicResource Log_ExportJsonBySource}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ClearLogsCommand}" Classes="danger">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <fluent:SymbolIcon Symbol="Delete" FontSize="14"/>
                    <TextBlock Text="{DynamicResource Log_Clear}"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- 表格视图 -->
        <DataGrid Grid.Row="3" 
                  IsVisible="{Binding IsTableView}"
                  ItemsSource="{Binding DisplayLogs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  Background="Transparent"
                  RowHeight="38"
                  HorizontalScrollBarVisibility="Auto"
                  Margin="24,0,24,24">
            <DataGrid.Styles>
                <Style Selector="DataGridRow" x:DataType="vm:LogEntryWrapper">
                    <Setter Property="Background" Value="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}, ConverterParameter=0.06}"/>
                </Style>
                <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle" x:DataType="vm:LogEntryWrapper">
                    <Setter Property="Fill" Value="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}, ConverterParameter=0.12}"/>
                </Style>
                <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle" x:DataType="vm:LogEntryWrapper">
                    <Setter Property="Fill" Value="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}, ConverterParameter=0.20}"/>
                </Style>
            </DataGrid.Styles>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="42">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <fluent:SymbolIcon Symbol="{Binding Type, Converter={x:Static Converters:LogTypeToIconConverter.Instance}}" 
                                        FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="时间" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm:ss}}" 
                                       Foreground="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}}"
                                       VerticalAlignment="Center" Margin="8,0" FontSize="13"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="类型" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Type}" 
                                       Foreground="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}}"
                                       VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold" FontSize="13"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="操作" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Action}" 
                                       Foreground="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}}"
                                       VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="来源" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Target}" 
                                       Foreground="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}}"
                                       VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="详情" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Details}" 
                                       Foreground="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}}"
                                       VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" FontSize="13"
                                       ToolTip.Tip="{Binding Details}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 文本视图 -->
        <Grid Grid.Row="3" IsVisible="{Binding IsTableView, Converter={x:Static Converters:BoolToInverseBoolConverter.Instance}}" Margin="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 操作按钮 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <Button Command="{Binding CopySelectedLogsCommand}" Classes="accent" Width="100">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fluent:SymbolIcon Symbol="Copy" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Log_CopySelected}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SelectAllLogsCommand}" Classes="outline" Width="100">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fluent:SymbolIcon Symbol="Checkmark" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Log_SelectAll}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeselectAllLogsCommand}" Classes="outline" Width="100">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <fluent:SymbolIcon Symbol="CheckmarkSquare" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Log_DeselectAll}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
            <!-- 日志列表 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">
                    <ItemsControl ItemsSource="{Binding DisplayLogs}">
                        <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntryWrapper">
                            <Border Background="{Binding Type, Converter={x:Static Converters:LogTypeToBrushConverter.Instance}, ConverterParameter=0.06}" 
                                    Padding="12" 
                                    CornerRadius="4" 
                                    Margin="0,2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap">
                                        <Run Text="["/>
                                        <Run Text="{Binding Timestamp, StringFormat={}{0:yyyy/MM/dd HH:mm:ss}}"/>
                                        <Run Text="] "/>
                                        <Run Text="{Binding Target}"/>
                                        <Run Text=":"/>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Details}" 
                                               FontSize="13" 
                                               TextWrapping="Wrap" 
                                               Margin="0,4,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
