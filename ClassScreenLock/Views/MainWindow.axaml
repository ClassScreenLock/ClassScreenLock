<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ClassScreenLock.Views"
        xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
        xmlns:Converters="clr-namespace:ClassScreenLock.Converters"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="ClassScreenLock.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/ClassScreenLock.ico"
        Title="ClassScreenLock"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="36">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <Converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <Converters:IsNullConverter x:Key="IsNullConverter"/>
        <Converters:BoolToIntConverter x:Key="BoolToIntConverter"/>
        <Converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <Converters:BoolToFluentIconConverter x:Key="BoolToFluentIconConverter"/>
    </Window.Resources>

    <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- ========== 自定义标题栏 ========== -->
        <Border Grid.Row="0"
                x:Name="TitleBar"
                Height="36"
                Background="{DynamicResource F2SolidBackgroundBaseBrush}"
                BorderBrush="{DynamicResource F2DividerStrokeBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_OnPointerPressed"
                DoubleTapped="TitleBar_OnDoubleTapped">
            <Grid ColumnDefinitions="*,Auto">
                <!-- 标题文字：IsHitTestVisible=False 让点击穿透到 Border 用于拖拽 -->
                <TextBlock Grid.Column="0"
                           Text="ClassScreenLock"
                           FontSize="{DynamicResource F2FontSizeBody}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource F2TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           IsHitTestVisible="False"/>

                <!-- 窗口控制按钮：使用已定义的 WindowTitleButton / CloseButton 样式 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Classes="WindowTitleButton"
                            Click="MinimizeButton_Click"
                            ToolTip.Tip="最小化">
                        <Path Data="M 0,5 L 10,5" StrokeThickness="1"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Width="10" Height="10"/>
                    </Button>
                    <Button Classes="WindowTitleButton"
                            Click="MaximizeButton_Click"
                            ToolTip.Tip="最大化/还原">
                        <Panel Width="10" Height="10">
                            <!-- 最大化：方框 -->
                            <Path Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z"
                                  StrokeThickness="1"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  IsVisible="{Binding !IsMaximized}"/>
                            <!-- 还原：重叠双框 -->
                            <Path Data="M 2,0.5 L 9.5,0.5 L 9.5,8 M 0.5,2 L 0.5,9.5 L 8,9.5"
                                  StrokeThickness="1"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  IsVisible="{Binding IsMaximized}"/>
                        </Panel>
                    </Button>
                    <Button Classes="WindowTitleButton CloseButton"
                            Click="CloseButton_Click"
                            ToolTip.Tip="关闭">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" StrokeThickness="1"
                              Stroke="{Binding $parent[Button].Foreground}"
                              Width="10" Height="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1"
              Grid.RowSpan="{Binding IsOnboarding, Converter={StaticResource BoolToIntConverter}, ConverterParameter=2}"
              Classes="main-content-grid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <views:Sidebar Grid.Column="0"
                           DataContext="{Binding SidebarViewModel}"
                           IsEnabled="{Binding !((vm:MainWindowViewModel)DataContext).IsAnyLockActive, RelativeSource={RelativeSource AncestorType=Window}}"
                           IsVisible="{Binding !((vm:MainWindowViewModel)DataContext).IsOnboarding, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <!-- 内容区域 -->
            <Border Grid.Column="{Binding IsOnboarding, Converter={StaticResource BoolToIntConverter}, ConverterParameter=0}"
                    Grid.ColumnSpan="{Binding IsOnboarding, Converter={StaticResource BoolToIntConverter}, ConverterParameter=2}"
                    Padding="{Binding IsOnboarding, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter='0|24'}"
                    CornerRadius="0"
                    Classes="main-content-border">
                <Grid>
                    <!-- 关于页面 -->
                    <ContentControl Content="{Binding CurrentView}"
                                    IsVisible="{Binding CurrentView, Converter={x:Static Converters:IsNotNullConverter.Instance}}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding}"/>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <!-- 默认内容 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"
                                IsVisible="{Binding CurrentView, Converter={x:Static Converters:IsNullConverter.Instance}}">
                        <TextBlock Text="{Binding Greeting}" Classes="subtitle"
                                   HorizontalAlignment="Center"/>

                        <Button Content="开始锁定" Command="{Binding StartLockCommand}"
                                IsVisible="{Binding !IsAnyLockActive}"
                                Classes="accent" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Classes="chrome"
                Padding="16,8"
                IsVisible="{Binding !IsOnboarding}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Status}" Classes="status"/>
                <TextBlock Grid.Column="1" Text="{Binding AppVersion, StringFormat='v {0}'}" Classes="caption"/>
            </Grid>
        </Border>

        <!-- 点击反馈覆盖层：不参与命中测试，承载扩散动画 -->
        <Canvas x:Name="RippleOverlay"
                IsHitTestVisible="False"
                Background="Transparent"
                Grid.RowSpan="3"
                Panel.ZIndex="9999"/>
    </Grid>
</Window>
