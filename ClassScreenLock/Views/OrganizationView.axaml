<UserControl
    x:Class="ClassScreenLock.Views.OrganizationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    x:DataType="vm:OrganizationViewModel"
    mc:Ignorable="d">

    <Panel>
        <!-- ========== 主内容区 ========== -->
        <ScrollViewer>
            <StackPanel Margin="32" Spacing="24">
                <!-- 标题部分 -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource Organization_Title}" Classes="h1"/>
                    <TextBlock Text="{DynamicResource Organization_Description}" Classes="caption" Opacity="0.6"/>
                </StackPanel>

                <!-- 已加入组织状态 -->
                <Border
                    Classes="card"
                    Padding="24"
                    IsVisible="{Binding HasJoinedOrganization}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="20">
                            <!-- 标题行 -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border
                                    Width="48"
                                    Height="48"
                                    Background="{DynamicResource F2AccentDefaultBrush}"
                                    CornerRadius="8">
                                    <fluent:SymbolIcon
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource F2TextOnAccentPrimaryBrush}"
                                        Symbol="CheckmarkCircle" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="{DynamicResource Organization_Joined}" />
                                    <TextBlock
                                        Foreground="{DynamicResource F2TextSecondaryBrush}"
                                        Text="{DynamicResource Organization_Joined_Description}" />
                                </StackPanel>
                            </Grid>

                            <!-- 组织信息面板 -->
                            <Border
                                Padding="16"
                                Background="{DynamicResource F2CardBackgroundSecondaryBrush}"
                                CornerRadius="8">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="120,*">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource F2TextSecondaryBrush}"
                                            Text="{DynamicResource Organization_OrgName}" />
                                        <TextBlock Grid.Column="1" Text="{Binding OrganizationName}" />
                                    </Grid>
                                    <Border
                                        Background="{DynamicResource F2DividerStrokeBrush}"
                                        Height="1" />
                                    <Grid ColumnDefinitions="120,*">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource F2TextSecondaryBrush}"
                                            Text="{DynamicResource Organization_OrgDescription}" />
                                        <TextBlock Grid.Column="1" Text="{Binding OrganizationDescription}" />
                                    </Grid>
                                    <Border
                                        Background="{DynamicResource F2DividerStrokeBrush}"
                                        Height="1" />
                                    <Grid ColumnDefinitions="120,*">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource F2TextSecondaryBrush}"
                                            Text="{DynamicResource Organization_OrganizationId}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            FontFamily="Consolas"
                                            Text="{Binding OrganizationId}" />
                                    </Grid>
                                    <Border
                                        Background="{DynamicResource F2DividerStrokeBrush}"
                                        Height="1" />
                                    <Grid ColumnDefinitions="120,*">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource F2TextSecondaryBrush}"
                                            Text="{DynamicResource Organization_JoinedTime}" />
                                        <TextBlock Grid.Column="1" Text="{Binding JoinedAtText}" />
                                    </Grid>
                                    <Border
                                        Background="{DynamicResource F2DividerStrokeBrush}"
                                        Height="1" />
                                    <Grid ColumnDefinitions="120,*">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource F2TextSecondaryBrush}"
                                            Text="{DynamicResource Organization_LastSync}" />
                                        <TextBlock Grid.Column="1" Text="{Binding LastSyncTimeText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button
                                    Classes="accent"
                                    Command="{Binding SyncConfigurationCommand}"
                                    Content="{DynamicResource Organization_SyncConfiguration}"
                                    IsEnabled="{Binding !IsLoading}" />
                                <Button
                                    Classes="danger"
                                    Command="{Binding LeaveOrganizationCommand}"
                                    Content="{DynamicResource Organization_LeaveOrganization}"
                                    IsEnabled="{Binding !IsLoading}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 装饰图标 -->
                        <fluent:SymbolIcon
                            Grid.Column="1"
                            Width="120"
                            Height="120"
                            Margin="0,20,20,0"
                            VerticalAlignment="Top"
                            Opacity="0.05"
                            Symbol="Building" />
                    </Grid>
                </Border>

                <!-- 未加入组织状态（简化版，仅显示引导按钮） -->
                <Border
                    Classes="card"
                    Padding="32"
                    IsVisible="{Binding !HasJoinedOrganization}">
                    <StackPanel
                        Spacing="16"
                        HorizontalAlignment="Center"
                        Margin="0,16">
                        <Border
                            Width="56"
                            Height="56"
                            CornerRadius="8"
                            Background="{DynamicResource F2AccentDefaultBrush}"
                            HorizontalAlignment="Center">
                            <fluent:SymbolIcon
                                Symbol="People"
                                Width="28"
                                Height="28"
                                Foreground="{DynamicResource F2TextOnAccentPrimaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <StackPanel
                            Spacing="4"
                            HorizontalAlignment="Center">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center"
                                Text="{DynamicResource Organization_Join}" />
                            <TextBlock
                                Foreground="{DynamicResource F2TextSecondaryBrush}"
                                HorizontalAlignment="Center"
                                Text="{DynamicResource Organization_Join_Description}" />
                        </StackPanel>
                        <Button
                            Classes="accent"
                            Margin="0,8,0,0"
                            Command="{Binding OpenJoinDialogCommand}"
                            Content="{DynamicResource Organization_JoinOrganization}"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- 加载状态（向导打开时不显示，向导内有自己的进度条） -->
                <Border
                    Classes="card"
                    Padding="24"
                    IsVisible="{Binding IsPageLoading}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                        <ProgressBar
                            Width="24"
                            Height="24"
                            IsIndeterminate="True" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{DynamicResource Organization_Processing}" />
                    </StackPanel>
                </Border>

                <!-- 使用说明 -->
                <Border
                    Classes="card"
                    Padding="24">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{DynamicResource Organization_Usage_Title}" />
                        <StackPanel Margin="8,0,0,0" Spacing="8">
                            <TextBlock Text="{DynamicResource Organization_Usage_1}" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Organization_Usage_2}" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Organization_Usage_3}" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Organization_Usage_4}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ========== 加入组织向导弹窗 ==========
             由代码隐藏通过 ContentDialog 承载（JoinOrganizationDialog），
             遮罩/弹出动画/阴影与删除确认对话框一致，覆盖整个主窗口。 -->
    </Panel>
</UserControl>
