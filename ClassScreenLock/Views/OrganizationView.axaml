<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="ClassScreenLock.Views.OrganizationView"
             x:DataType="vm:OrganizationViewModel">

    <ScrollViewer>
        <StackPanel Spacing="24" Margin="32">
            <!-- 标题部分 -->
            <StackPanel Spacing="8">
                <TextBlock 
                    Text="{DynamicResource Organization_Title}" 
                    FontSize="26" FontWeight="SemiBold"/>
                <TextBlock 
                    Text="{DynamicResource Organization_Description}" 
                    FontSize="14" Opacity="0.7"/>
            </StackPanel>

            <!-- 已加入组织状态 -->
            <Border 
                IsVisible="{Binding HasJoinedOrganization}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                CornerRadius="12" Padding="24">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                                <fluent:SymbolIcon Symbol="CheckmarkCircle" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{DynamicResource Organization_Joined}" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Organization_Joined_Description}" Opacity="0.7"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" 
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="组织名称：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OrganizationName}"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Margin="0,4"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="组织描述：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OrganizationDescription}"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Margin="0,4"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="组织 ID：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OrganizationId}" FontFamily="Consolas"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Margin="0,4"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="加入时间：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding JoinedAtText}"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Margin="0,4"/>
                                <Grid ColumnDefinitions="120,*">
                                    <TextBlock Text="最后同步：" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LastSyncTimeText}"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button 
                                Content="{DynamicResource Organization_SyncConfiguration}" 
                                Command="{Binding SyncConfigurationCommand}"
                                Classes="accent"
                                Padding="24,12"
                                IsEnabled="{Binding !IsLoading}"/>
                            <Button 
                                Content="{DynamicResource Organization_LeaveOrganization}" 
                                Command="{Binding LeaveOrganizationCommand}"
                                Background="#a80000"
                                Foreground="White"
                                Padding="24,12"
                                IsEnabled="{Binding !IsLoading}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <fluent:SymbolIcon Grid.Column="1" Symbol="Building" Width="120" Height="120" 
                                Opacity="0.05" VerticalAlignment="Top" Margin="0,20,20,0"/>
                </Grid>
            </Border>

            <Border 
                IsVisible="{Binding !HasJoinedOrganization}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                CornerRadius="12" Padding="32">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="24">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SystemControlBackgroundAccentBrush}">
                                <fluent:SymbolIcon Symbol="People" Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{DynamicResource Organization_Join}" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Organization_Join_Description}" Opacity="0.7"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock 
                            Text="{DynamicResource Organization_Usage_Instruction}"
                            TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,0"/>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{DynamicResource Organization_ServerUrl}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox 
                                Text="{Binding ServerUrl}"
                                Watermark="{DynamicResource Organization_ServerUrl_Watermark}"
                                Height="48"
                                VerticalContentAlignment="Center"
                                Padding="12,8"/>
                            <TextBlock Text="{DynamicResource Organization_ServerUrl_Note}" 
                                       Opacity="0.6" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Organization_OrganizationId}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox 
                                Text="{Binding OrganizationId}"
                                Watermark="{DynamicResource Organization_OrganizationId_Watermark}"
                                Height="48"
                                VerticalContentAlignment="Center"
                                Padding="12,8"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Organization_ContactPhone}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox 
                                Text="{Binding ContactPhone}"
                                Watermark="{DynamicResource Organization_ContactPhone_Watermark}"
                                Height="48"
                                VerticalContentAlignment="Center"
                                Padding="12,8"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Organization_ClassName}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox 
                                Text="{Binding ClassName}"
                                Watermark="{DynamicResource Organization_ClassName_Watermark}"
                                Height="48"
                                VerticalContentAlignment="Center"
                                Padding="12,8"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Organization_PersonInCharge}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox 
                                Text="{Binding PersonInCharge}"
                                Watermark="{DynamicResource Organization_PersonInCharge_Watermark}"
                                Height="48"
                                VerticalContentAlignment="Center"
                                Padding="12,8"/>
                        </StackPanel>

                            <TextBlock 
                                Text="{Binding ErrorMessage}"
                                Foreground="#a80000"
                                TextWrapping="Wrap"
                                IsVisible="{Binding HasError}"
                                Margin="0,8,0,0"/>

                            <TextBlock 
                                Text="{Binding SuccessMessage}"
                                Foreground="#008000"
                                TextWrapping="Wrap"
                                IsVisible="{Binding HasSuccess}"
                                Margin="0,8,0,0"/>

                            <Button 
                                Content="{DynamicResource Organization_JoinOrganization}" 
                                Command="{Binding JoinOrganizationCommand}"
                                Classes="accent"
                                Padding="32,12"
                                HorizontalAlignment="Left"
                                MinWidth="160"
                                IsEnabled="{Binding !IsLoading}"/>
                    </StackPanel>
                    
                    <fluent:SymbolIcon Grid.Column="1" Symbol="PersonAdd" Width="120" Height="120" 
                                Opacity="0.05" VerticalAlignment="Top" Margin="0,20,20,0"/>
                </Grid>
            </Border>

            <Border 
                IsVisible="{Binding IsLoading}"
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                CornerRadius="12" Padding="24">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="24" Height="24"/>
                    <TextBlock Text="{DynamicResource Organization_Processing}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border 
                Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                CornerRadius="12" Padding="24">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <fluent:SymbolIcon Symbol="Info" Foreground="{DynamicResource SystemControlBackgroundAccentBrush}" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Organization_Usage_Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Spacing="8" Margin="8,0,0,0">
                        <TextBlock 
                            Text="{DynamicResource Organization_Usage_1}"
                            TextWrapping="Wrap"/>
                        <TextBlock 
                            Text="{DynamicResource Organization_Usage_2}"
                            TextWrapping="Wrap"/>
                        <TextBlock 
                            Text="{DynamicResource Organization_Usage_3}"
                            TextWrapping="Wrap"/>
                        <TextBlock 
                            Text="{DynamicResource Organization_Usage_4}"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
