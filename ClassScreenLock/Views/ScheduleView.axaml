<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:models="clr-namespace:ClassScreenLock.Models"
             xmlns:converters="clr-namespace:ClassScreenLock.Converters"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="ClassScreenLock.Views.ScheduleView"
             x:DataType="vm:ScheduleViewModel"
             Name="Root">

    <UserControl.Resources>
        <converters:TimePointTypeToBrushConverter x:Key="TypeToBrushConverter"/>
        <converters:IsNullConverter x:Key="IsNullConverter"/>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <converters:EqualityMultiConverter x:Key="EqualConverter"/>
    </UserControl.Resources>

    <!-- 统一控件尺寸：所有按钮 32px 高，统一 14px 字号 -->
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <!-- 星期分段选择器 -->
        <Style Selector="ListBox.day-picker">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.day-picker ListBoxItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Foreground" Value="{DynamicResource F2TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="ListBox.day-picker ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
        </Style>
        <Style Selector="ListBox.day-picker ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource F2NavSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource F2AccentTextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="ListBox.day-picker ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource F2NavSelectedHoverBackgroundBrush}"/>
        </Style>
        <Style Selector="ListBox.day-picker ListBoxItem:selected:focus-visible">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="24,24,24,24">

        <!-- 页面标题 -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{DynamicResource Sidebar_Schedule}" Classes="h1"/>
            <TextBlock Text="管理周课表与时间计划安排" Classes="caption" Opacity="0.6"/>
        </StackPanel>

        <!-- ============ 主内容区（全宽） ============ -->
        <Border Grid.Row="1" Classes="card" Padding="20,16">
            <Grid RowDefinitions="Auto,Auto,Auto,*">

                <!-- 顶部：标题 + 周课表选择 + 今日摘要 -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,14">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Schedule_WeeklySchedule}" Classes="h3" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <!-- 周课表选择器 -->
                        <ComboBox ItemsSource="{Binding WeeklySchedules}"
                                  SelectedItem="{Binding SelectedWeekly, Mode=TwoWay}"
                                  MinWidth="180" Height="32" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:WeeklyScheduleFile">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <fluent:SymbolIcon Grid.Column="0" Symbol="Calendar" FontSize="14" Opacity="0.7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- 周操作：新建/复制/导入/导出/清空 -->
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="icon-sm" Command="{Binding AddWeeklyCommand}" ToolTip.Tip="{DynamicResource Schedule_Add}">
                                <fluent:SymbolIcon Symbol="Add" FontSize="16"/>
                            </Button>
                            <Button Classes="icon-sm" Command="{Binding CopyWeeklyCommand}" ToolTip.Tip="{DynamicResource Schedule_Copy}">
                                <fluent:SymbolIcon Symbol="Copy" FontSize="16"/>
                            </Button>
                            <Button Classes="icon-sm" Click="ImportSchedule_Click" ToolTip.Tip="{DynamicResource Schedule_Import}">
                                <fluent:SymbolIcon Symbol="ArrowDown" FontSize="16"/>
                            </Button>
                            <Button Classes="icon-sm" Click="ExportSchedule_Click" ToolTip.Tip="{DynamicResource Schedule_Export}">
                                <fluent:SymbolIcon Symbol="ArrowUp" FontSize="16"/>
                            </Button>
                            <Button Classes="icon-sm" Command="{Binding ClearWeeklyCommand}" ToolTip.Tip="{DynamicResource Schedule_Clear}">
                                <fluent:SymbolIcon Symbol="Eraser" FontSize="16" Foreground="{DynamicResource F2SystemCriticalBrush}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- 今日执行摘要（规范信息条） -->
                    <Border Grid.Column="1" Background="{DynamicResource F2SubtleSecondaryBrush}" CornerRadius="6" Padding="12,6"
                            VerticalAlignment="Center" IsVisible="{Binding TodayScheduleSummary, Converter={StaticResource IsNotNullConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fluent:SymbolIcon Symbol="CalendarDay" FontSize="14" Opacity="0.75" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TodayScheduleSummary}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 工具栏：添加时间点 + 排序操作 -->
                <Border Grid.Row="1" Padding="4,8,4,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <WrapPanel Grid.Column="0" ItemSpacing="8">
                            <Button Command="{Binding AddClassCommand}" Padding="16,7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluent:SymbolIcon Symbol="Video" FontSize="16"/>
                                    <TextBlock Text="{DynamicResource Schedule_Class}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddBreakCommand}" Padding="16,7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluent:SymbolIcon Symbol="DrinkToGo" FontSize="16"/>
                                    <TextBlock Text="{DynamicResource Schedule_Break}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddDividerCommand}" Padding="16,7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluent:SymbolIcon Symbol="MoreHorizontal" FontSize="16"/>
                                    <TextBlock Text="{DynamicResource Schedule_Divider}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddActionCommand}" Padding="16,7">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluent:SymbolIcon Symbol="Flash" FontSize="16"/>
                                    <TextBlock Text="{DynamicResource Schedule_Action}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Command="{Binding SortTimePointsCommand}" IsEnabled="{Binding CanSortTimePoints}"
                                    Classes="icon-sm" ToolTip.Tip="{DynamicResource Schedule_Sort}">
                                <fluent:SymbolIcon Symbol="ArrowSort" FontSize="16"/>
                            </Button>
                            <Button Command="{Binding ToggleSettingsCommand}" IsVisible="{Binding CanToggleSettings}"
                                    Classes="icon-sm" ToolTip.Tip="{DynamicResource Schedule_Info}">
                                <fluent:SymbolIcon Symbol="Settings" FontSize="16"/>
                            </Button>
                            <Button Command="{Binding LoadSchedulesCommand}" Classes="icon-sm" ToolTip.Tip="{DynamicResource Schedule_Refresh}">
                                <fluent:SymbolIcon Symbol="ArrowSync" FontSize="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 周轮换设置 -->
                <Border Grid.Row="2" Padding="4,0,4,14">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
                        <!-- 轮换周数 -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Schedule_RotationWeeks}" FontSize="14" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding WeeklyCycleOptions}"
                                      SelectedItem="{Binding WeeklyCycleCount, Mode=TwoWay}"
                                      MinWidth="100" Height="34" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 开学日期 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Schedule_StartDate}" FontSize="14" VerticalAlignment="Center"/>
                            <Grid ColumnDefinitions="*,Auto" Width="220">
                                <TextBox Grid.Column="0"
                                         Text="{Binding TermStartDateText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         Watermark="{DynamicResource Schedule_DateFormatHint}"
                                         VerticalContentAlignment="Center"
                                         Classes="clear"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Classes="icon-sm" VerticalAlignment="Center" Margin="4,0,0,0">
                                    <fluent:SymbolIcon Symbol="Calendar" FontSize="16"/>
                                    <Button.Flyout>
                                        <Flyout Placement="Bottom">
                                            <Border Classes="card" Padding="12">
                                                <StackPanel Spacing="10">
                                                    <Calendar SelectedDate="{Binding TermStartDateCalendar, Mode=TwoWay}" Width="280" Height="300"/>
                                                    <Button Command="{Binding ClearTermStartDateCommand}"
                                                            Classes="danger"
                                                            HorizontalAlignment="Stretch"
                                                            Content="{DynamicResource Schedule_ClearTermStartDate}"/>
                                                </StackPanel>
                                            </Border>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding TermStartDateValidationMessage}"
                                       IsVisible="{Binding IsTermStartDateInvalid}"
                                       Foreground="{DynamicResource F2SystemCriticalBrush}"
                                       TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding SaveAndBackupCommand}" Classes="accent"
                                VerticalAlignment="Center" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluent:SymbolIcon Symbol="Save" FontSize="16"/>
                                <TextBlock Text="{DynamicResource Schedule_SaveAndBackup}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 星期 Tab + 时间点列表 -->
                <Grid Grid.Row="3" RowDefinitions="Auto,*">
                    <!-- 列表底衬（浅色区分层，打破白卡套白卡） -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Classes="list-surface"
                            Background="{DynamicResource F2SubtleSecondaryBrush}"
                            CornerRadius="10" Padding="14,12"/>

                    <ListBox Grid.Row="0" Classes="day-picker"
                             SelectedIndex="{Binding SelectedDayTabIndex, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem Content="{DynamicResource Schedule_Monday}"/>
                        <ListBoxItem Content="{DynamicResource Schedule_Tuesday}"/>
                        <ListBoxItem Content="{DynamicResource Schedule_Wednesday}"/>
                        <ListBoxItem Content="{DynamicResource Schedule_Thursday}"/>
                        <ListBoxItem Content="{DynamicResource Schedule_Friday}"/>
                        <ListBoxItem Content="{DynamicResource Schedule_Saturday}"/>
                        <ListBoxItem Content="{DynamicResource Schedule_Sunday}"/>
                    </ListBox>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding SelectedSchedule.TimePoints}"
                             SelectedItem="{Binding SelectedTimePoint, Mode=TwoWay}"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Margin="0,10,0,0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Margin" Value="0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover">
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:focus-visible">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <!-- 设置项悬停/选中反馈：整卡变色 -->
                            <Style Selector="ListBoxItem:pointerover Border.card">
                                <Setter Property="Background" Value="{DynamicResource F2SubtleTertiaryBrush}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected Border.card">
                                <Setter Property="Background" Value="{DynamicResource F2NavSelectedBackgroundBrush}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected Border.card TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource F2AccentTextPrimaryBrush}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected Border.card TextBlock.caption">
                                <Setter Property="Foreground" Value="{DynamicResource F2AccentTextSecondaryBrush}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected Border.card Ellipse">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TimePoint">
                                <!-- 课程条：固定列宽表格布局，行间严格对齐（制表符效果） -->
                                <Border Classes="card" Padding="18,14" CornerRadius="8">
                                    <Grid ColumnDefinitions="Auto,132,58,62,118,Auto" ColumnSpacing="10">

                                        <!-- 类型圆点 -->
                                        <Ellipse Grid.Column="0" Width="12" Height="12"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Type, Converter={StaticResource TypeToBrushConverter}}"/>

                                        <!-- 标签（固定 132，左对齐，超长省略） -->
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                        <!-- 类型（固定 58，左对齐） -->
                                        <TextBlock Grid.Column="2" Text="{Binding TypeDisplayName}" FontSize="13" Opacity="0.7"
                                                   VerticalAlignment="Center"/>

                                        <!-- 时长（固定 62，右对齐） -->
                                        <TextBlock Grid.Column="3" Text="{Binding Duration, StringFormat=\{0\}分钟}" FontSize="13" Opacity="0.7"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- 时间（固定 118，右对齐） -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StartTime, StringFormat=\{0:hh\\:mm\}}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Text="–" FontSize="14" Opacity="0.55" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EndTime, StringFormat=\{0:hh\\:mm\}}" FontSize="15" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- 操作 -->
                                        <Button Grid.Column="5" Command="{Binding $parent[UserControl].((vm:ScheduleViewModel)DataContext).DeleteTimePointCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="icon-sm" ToolTip.Tip="{DynamicResource Schedule_Delete}"
                                                VerticalAlignment="Center" Margin="10,0,0,0">
                                            <fluent:SymbolIcon Symbol="Delete" FontSize="16" Foreground="{DynamicResource F2SystemCriticalBrush}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 右栏：设置面板（覆盖层，不挤压主内容） ============ -->
        <Border Classes="overlay-panel" Padding="20"
                Width="300" HorizontalAlignment="Right"
                IsVisible="{Binding ShowSettingsPanelWithSchedule}"
                ZIndex="20"
                BorderBrush="{DynamicResource F2DividerStrokeBrush}" BorderThickness="1,0,0,0"
                BoxShadow="{DynamicResource F2ShadowFlyout}">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <fluent:SymbolIcon Symbol="Settings" FontSize="18" VerticalAlignment="Center" Opacity="0.85"/>
                        <TextBlock Text="{DynamicResource Schedule_Info}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CloseSettingsCommand}"
                            IsVisible="{Binding !IsLargeView}" Classes="icon-sm">
                        <fluent:SymbolIcon Symbol="Dismiss" FontSize="16"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20">
                        <!-- 名称 -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource Schedule_Label}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SelectedSchedule.Name}" Watermark="{DynamicResource Schedule_NameWatermark}" Classes="clear"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource F2DividerStrokeBrush}"/>

                        <!-- 默认时长 -->
                        <StackPanel Spacing="14">
                            <TextBlock Text="{DynamicResource Schedule_DefaultClassDuration}" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Schedule_Class}" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding SelectedSchedule.DefaultClassDuration}" 
                                               Minimum="1" Maximum="120" ShowButtonSpinner="False" Width="96"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="{DynamicResource Schedule_Break}" VerticalAlignment="Center"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding SelectedSchedule.DefaultBreakDuration}" 
                                               Minimum="1" Maximum="120" ShowButtonSpinner="False" Width="96"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource F2DividerStrokeBrush}"/>

                        <Button Content="{DynamicResource Schedule_Save}" 
                                Command="{Binding SaveCurrentScheduleCommand}" 
                                Classes="accent" 
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ============ 详情编辑覆盖层 ============ -->
        <Border
                Width="360" HorizontalAlignment="Right"
                IsVisible="{Binding IsDetailVisible}"
                Classes="overlay-panel"
                ZIndex="50"
                BoxShadow="{DynamicResource F2ShadowFlyout}">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Classes="overlay-panel-header" BorderBrush="{DynamicResource F2DividerStrokeBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <fluent:SymbolIcon Symbol="Edit" FontSize="18" VerticalAlignment="Center" Opacity="0.85"/>
                            <TextBlock Text="{DynamicResource Schedule_TimePointDetail}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseDetailCommand}" Classes="icon-sm">
                            <fluent:SymbolIcon Symbol="Dismiss" FontSize="16"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="20">
                        <StackPanel Spacing="20">
                            <!-- 标签 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Schedule_Label}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding SelectedTimePoint.Label, TargetNullValue=''}" 
                                         Watermark="{DynamicResource Schedule_LabelWatermark}" Classes="clear"/>
                            </StackPanel>

                            <!-- 类型 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Schedule_Type}" FontSize="13" FontWeight="SemiBold"/>
                                <ComboBox ItemsSource="{Binding AllTimePointTypes}"
                                          SelectedItem="{Binding SelectedTimePoint.Type, Mode=TwoWay, TargetNullValue=Class}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Converter={StaticResource TypeToBrushConverter}}"/>
                                                <TextBlock Text="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource F2DividerStrokeBrush}"/>

                            <!-- 时间安排 -->
                            <StackPanel Spacing="14">
                                <TextBlock Text="{DynamicResource Schedule_TimeArrangement}" FontSize="13" FontWeight="SemiBold"/>

                                <!-- 开始时间（整行独占，不再挤压） -->
                                <Grid ColumnDefinitions="72,*,Auto,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Schedule_StartTime}" FontSize="13" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding HourOptions}" SelectedItem="{Binding SelectedTimePoint.StartHour}"
                                              MinWidth="0" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Column="2" Text=":" FontSize="14" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding SelectedTimePoint.StartMinute}"
                                              MinWidth="0" HorizontalAlignment="Stretch"/>
                                </Grid>

                                <!-- 结束时间 -->
                                <Grid ColumnDefinitions="72,*,Auto,*" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Schedule_EndTime}" FontSize="13" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding HourOptions}" SelectedItem="{Binding SelectedTimePoint.EndHour}"
                                              MinWidth="0" HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Column="2" Text=":" FontSize="14" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding MinuteOptions}" SelectedItem="{Binding SelectedTimePoint.EndMinute}"
                                              MinWidth="0" HorizontalAlignment="Stretch"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto">
                                    <NumericUpDown Grid.Column="0" Value="{Binding SelectedTimePoint.Duration, TargetNullValue=0}" Minimum="0" Maximum="1440" ShowButtonSpinner="False"/>
                                    <TextBlock Grid.Column="1" Text="min" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" Opacity="0.75"/>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{DynamicResource F2DividerStrokeBrush}"/>

                            <!-- 描述 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource Schedule_Description}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding SelectedTimePoint.Description}"
                                         AcceptsReturn="True" MinHeight="100"
                                         Watermark="{DynamicResource Schedule_DescriptionWatermark}"
                                         VerticalContentAlignment="Top" Classes="clear"/>
                            </StackPanel>

                            <Button Content="{DynamicResource Schedule_Save}"
                                    Command="{Binding SaveCurrentScheduleCommand}"
                                    Classes="accent" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
