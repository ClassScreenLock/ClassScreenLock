<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:converters="clr-namespace:ClassScreenLock.Converters"
             xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ClassScreenLock.Views.ScreenshotHistoryView"
             x:DataType="vm:ScreenshotHistoryViewModel"
             Focusable="True"
             KeyDown="OnRootKeyDown">
    
    <UserControl.Resources>
        <converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:BoolToResourceBrushConverter x:Key="BoolToResourceBrushConverter"/>
        <converters:MBToGBConverter x:Key="MBToGBConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- 标题部分 -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="32,32,32,24">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border Background="{DynamicResource SystemAccentColorLightBrush}" 
                        Width="48" Height="48" CornerRadius="8">
                    <icons:Icon Value="fas fa-camera" Width="24" Height="24" 
                                Foreground="{DynamicResource SystemAccentColor}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="屏幕记录" Classes="h1" Margin="0"/>
                    <TextBlock Text="查看并管理自动屏幕截图记录" Classes="caption" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" Margin="32,0,32,32">
                <!-- Settings Section -->
                <Border Classes="card" Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                            <icons:Icon Value="fas fa-cog" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                            <TextBlock Text="截屏设置" Classes="h3"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                            <!-- Class Screenshot -->
                            <StackPanel Grid.Row="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="上课截图" Classes="subtitle"/>
                                <TextBlock Text="在课程进行期间自动记录屏幕" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Settings.EnableClassScreenshot}">
                                    <TextBlock Text="间隔" VerticalAlignment="Center" Classes="caption"/>
                                    <ComboBox ItemsSource="{Binding ClassIntervalOptions}" SelectedItem="{Binding Settings.ClassScreenshotInterval}" Width="100"/>
                                    <TextBlock Text="分钟" VerticalAlignment="Center" Classes="caption"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding Settings.EnableClassScreenshot}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12"/>

                            <!-- Break Screenshot -->
                            <StackPanel Grid.Row="2" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="课间截图" Classes="subtitle"/>
                                <TextBlock Text="在课间休息期间自动记录屏幕" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Settings.EnableBreakScreenshot}">
                                    <TextBlock Text="间隔" VerticalAlignment="Center" Classes="caption"/>
                                    <ComboBox ItemsSource="{Binding BreakIntervalOptions}" SelectedItem="{Binding Settings.BreakScreenshotInterval}" Width="100"/>
                                    <TextBlock Text="分钟" VerticalAlignment="Center" Classes="caption"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding Settings.EnableBreakScreenshot}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12"/>

                            <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                    <StackPanel Spacing="4" Margin="0,0,32,12" VerticalAlignment="Center" Width="180">
                                        <TextBlock Text="自动清理" Classes="subtitle"/>
                                        <TextBlock Text="自动删除旧的记录以释放空间" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,0,24,12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="保留时长" Classes="caption" Opacity="0.6"/>
                                            <ComboBox ItemsSource="{Binding RetentionDaysOptions}" SelectedItem="{Binding Settings.RetentionDays}" Width="110">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='{}{0} 天'}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="存储上限" Classes="caption" Opacity="0.6"/>
                                            <ComboBox ItemsSource="{Binding MaxStorageMBOptions}" SelectedItem="{Binding Settings.MaxStorageMB}" Width="110">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat={}{0:0.0} GB, Converter={StaticResource MBToGBConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="图片格式" Classes="caption" Opacity="0.6"/>
                                            <ComboBox ItemsSource="{Binding AvailableFormats}"
                                                      SelectedValue="{Binding Settings.ImageFormat}" 
                                                      SelectedValueBinding="{Binding Value}" 
                                                      Width="110">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>

                                <Button Grid.Column="1" Content="保存设置" Command="{Binding SaveSettingsCommand}" 
                                        Classes="accent" VerticalAlignment="Center" Height="36" Padding="24,0" Margin="0,0,0,12"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Filter & Actions -->
                <Border Classes="card" Padding="12">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <icons:Icon Value="fas fa-calendar-alt" Width="16" Height="16"/>
                            <TextBlock Text="日期" VerticalAlignment="Center"/>
                            <CalendarDatePicker SelectedDate="{Binding FilterDate}" Width="150"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
                            <icons:Icon Value="fas fa-filter" Width="16" Height="16"/>
                            <TextBlock Text="类型" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding FilterTypeIndex}" Width="120">
                                <ComboBoxItem>全部</ComboBoxItem>
                                <ComboBoxItem>上课时段</ComboBoxItem>
                                <ComboBoxItem>课间休息</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding LoadScreenshotsCommand}" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:Icon Value="fas fa-sync" Width="16" Height="16"/>
                                    <TextBlock Text="刷新"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenFolderCommand}" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:Icon Value="fas fa-folder-open" Width="16" Height="16"/>
                                    <TextBlock Text="打开文件夹"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bulk Actions -->
                <Border Classes="card" Padding="12">
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,10,10">
                            <ToggleSwitch IsChecked="{Binding IsSelectionMode}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            <TextBlock Text="批量选择" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Command="{Binding SelectAllOnPageCommand}" Padding="12,8" IsEnabled="{Binding IsSelectionMode}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:Icon Value="fas fa-check-square" Width="16" Height="16"/>
                                <TextBlock Text="全选本页"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearSelectionCommand}" Padding="12,8" IsEnabled="{Binding IsSelectionMode}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:Icon Value="fas fa-times-circle" Width="16" Height="16"/>
                                <TextBlock Text="清除"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="26" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,0,10,10"/>

                        <Button Command="{Binding BulkRotateLeftCommand}" ToolTip.Tip="统一左旋" Padding="10" IsEnabled="{Binding IsSelectionMode}" Margin="0,0,10,10">
                            <icons:Icon Value="fas fa-undo" Width="16" Height="16"/>
                        </Button>
                        <Button Command="{Binding BulkRotateRightCommand}" ToolTip.Tip="统一右旋" Padding="10" IsEnabled="{Binding IsSelectionMode}" Margin="0,0,10,10">
                            <icons:Icon Value="fas fa-redo" Width="16" Height="16"/>
                        </Button>
                        <Button Command="{Binding BulkToggleFlipHorizontalCommand}" ToolTip.Tip="统一水平翻转" Padding="10" IsEnabled="{Binding IsSelectionMode}" Margin="0,0,10,10">
                            <icons:Icon Value="fas fa-arrows-alt-h" Width="16" Height="16"/>
                        </Button>
                        <Button Command="{Binding BulkToggleFlipVerticalCommand}" ToolTip.Tip="统一垂直翻转" Padding="10" IsEnabled="{Binding IsSelectionMode}" Margin="0,0,10,10">
                            <icons:Icon Value="fas fa-arrows-alt-v" Width="16" Height="16"/>
                        </Button>

                        <Rectangle Width="1" Height="26" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,0,10,10"/>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,10,10">
                            <TextBlock Text="{Binding SelectedCount, StringFormat='已选 {0}'}" Opacity="0.8" VerticalAlignment="Center"/>
                            <Button Command="{Binding ResetBulkEditsCommand}" Padding="12,8" IsEnabled="{Binding IsSelectionMode}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:Icon Value="fas fa-sync-alt" Width="16" Height="16"/>
                                    <TextBlock Text="重置编辑"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyBulkEditsToSelectedCommand}" Padding="12,8" IsEnabled="{Binding IsSelectionMode}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:Icon Value="fas fa-check" Width="16" Height="16"/>
                                    <TextBlock Text="应用到已选"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteSelectedCommand}" Padding="12,8" IsEnabled="{Binding IsSelectionMode}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:Icon Value="fas fa-trash" Width="16" Height="16" Foreground="#FF4444"/>
                                    <TextBlock Text="删除已选"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- Screenshots Grid -->
                <ItemsControl ItemsSource="{Binding PagedScreenshots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="6" Padding="0" Background="Transparent" BorderThickness="0" 
                                    Command="{Binding $parent[UserControl].((vm:ScreenshotHistoryViewModel)DataContext).OpenOrToggleSelectCommand}" 
                                    CommandParameter="{Binding}"
                                    PointerPressed="OnScreenshotItemPointerPressed">
                                <Border Width="240" Height="180" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToResourceBrushConverter}, ConverterParameter=SystemAccentColor|SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter=2|1}">

                                    <Grid RowDefinitions="*,Auto">
                                        <Image Grid.Row="0" Source="{Binding FilePath, Converter={StaticResource StringToBitmapConverter}, ConverterParameter=thumb}" Stretch="UniformToFill"/>

                                        <Border Grid.Row="0" Background="#66000000" CornerRadius="6" Padding="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                IsVisible="{Binding $parent[UserControl].((vm:ScreenshotHistoryViewModel)DataContext).IsSelectionMode}">
                                            <CheckBox IsChecked="{Binding IsSelected}"/>
                                        </Border>

                                        <Border Grid.Row="1" Background="#CC000000" Padding="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="White" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock Text="上课时段" IsVisible="{Binding IsClassTime}" Foreground="LightGreen" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock Text="课间休息" IsVisible="{Binding !IsClassTime}" Foreground="LightBlue" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Hover/Context Actions Overlay could go here, but context menu is simpler -->
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开" Command="{Binding $parent[UserControl].((vm:ScreenshotHistoryViewModel)DataContext).OpenScreenshotCommand}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="删除" Command="{Binding $parent[UserControl].((vm:ScreenshotHistoryViewModel)DataContext).DeleteScreenshotCommand}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <TextBlock Text="暂无截图" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Opacity="0.5" Margin="0,20,0,0"/>

                <!-- Pager -->
                <Border Classes="card" Padding="12" IsVisible="{Binding HasScreenshots}">
                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto">
                        <TextBlock Grid.Column="0" Text="{Binding TotalItems, StringFormat='共 {0} 张'}" VerticalAlignment="Center" Opacity="0.8"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PageStartItemIndex, StringFormat='显示 {0}'}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="-" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="{Binding PageEndItemIndex}" VerticalAlignment="Center" Opacity="0.8"/>
                            <Rectangle Width="1" Height="18" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="10,0"/>
                            <Button Command="{Binding FirstPageCommand}" Padding="10" IsEnabled="{Binding CanGoPrevious}">
                                <icons:Icon Value="fas fa-angle-double-left" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding PreviousPageCommand}" Padding="10" IsEnabled="{Binding CanGoPrevious}">
                                <icons:Icon Value="fas fa-chevron-left" Width="16" Height="16"/>
                            </Button>
                            <TextBlock Text="{Binding CurrentPage, StringFormat='第 {0}'}" VerticalAlignment="Center"/>
                            <TextBlock Text="/" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="{Binding TotalPages, StringFormat='{}{0} 页'}" VerticalAlignment="Center"/>
                            <Button Command="{Binding NextPageCommand}" Padding="10" IsEnabled="{Binding CanGoNext}">
                                <icons:Icon Value="fas fa-chevron-right" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding LastPageCommand}" Padding="10" IsEnabled="{Binding CanGoNext}">
                                <icons:Icon Value="fas fa-angle-double-right" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="每页" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="90"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Image Viewer Overlay -->
        <Grid IsVisible="{Binding IsImageViewerOpen}" Background="#F2000000">
            <!-- Image Area - Full Screen -->
            <ScrollViewer x:Name="ImageScrollViewer" 
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AllowAutoHide="True"
                          PointerWheelChanged="OnPointerWheelChanged"
                          PointerPressed="OnPointerPressed"
                          PointerMoved="OnPointerMoved"
                          PointerReleased="OnPointerReleased">
                <ScrollViewer.GestureRecognizers>
                    <PinchGestureRecognizer />
                </ScrollViewer.GestureRecognizers>
                <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center">
                    <LayoutTransformControl.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding RenderScaleX}" ScaleY="{Binding RenderScaleY}"/>
                            <RotateTransform Angle="{Binding Rotation}"/>
                        </TransformGroup>
                    </LayoutTransformControl.LayoutTransform>
                    <Image Source="{Binding CurrentViewingImage.FilePath, Converter={StaticResource StringToBitmapConverter}}"
                           Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                </LayoutTransformControl>
            </ScrollViewer>

            <!-- Overlay Controls -->
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Top Bar -->
                <Border Grid.Row="0" Background="#40000000" Padding="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding CurrentViewingImage.FileName}" Foreground="White" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Command="{Binding CloseImageViewerCommand}" 
                                Background="Transparent" BorderThickness="0" Padding="8" CornerRadius="4">
                            <icons:Icon Value="fas fa-times" Width="20" Height="20" Foreground="White"/>
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#33FFFFFF"/>
                                </Style>
                            </Button.Styles>
                        </Button>
                    </Grid>
                </Border>
                
                <!-- Zoom Ratio Display -->
                <Border Grid.Row="1" Background="#80000000" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" IsHitTestVisible="False">
                    <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                </Border>

                <!-- Navigation Arrows -->
                <Grid Grid.Row="1">
                    <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20" 
                            Command="{Binding PreviousImageCommand}" Background="#33000000" Foreground="White" 
                            Padding="15,20" CornerRadius="4" BorderThickness="0" IsHitTestVisible="True">
                        <icons:Icon Value="fas fa-chevron-left" Width="24" Height="24"/>
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#66000000"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20" 
                            Command="{Binding NextImageCommand}" Background="#33000000" Foreground="White" 
                            Padding="15,20" CornerRadius="4" BorderThickness="0" IsHitTestVisible="True">
                        <icons:Icon Value="fas fa-chevron-right" Width="24" Height="24"/>
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#66000000"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </Grid>
                
                <!-- Bottom Toolbar -->
                <Border Grid.Row="2" Background="#CC202020" Padding="15,10" Margin="0,0,0,20" HorizontalAlignment="Center" CornerRadius="8" BoxShadow="0 4 10 0 #66000000">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding ToggleMaximizeCommand}" ToolTip.Tip="{Binding IsMaximized, Converter={StaticResource StringEqualsConverter}, ConverterParameter='True|退出最大化|最大化'}" 
                                Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="{Binding IsMaximized, Converter={StaticResource StringEqualsConverter}, ConverterParameter='True|fas fa-compress-arrows-alt|fas fa-expand-arrows-alt'}" 
                                        Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Rectangle Width="1" Height="24" Fill="#66FFFFFF" Margin="4,0"/>
                        <Button Command="{Binding ZoomInCommand}" ToolTip.Tip="放大" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-search-plus" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding ZoomOutCommand}" ToolTip.Tip="缩小" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-search-minus" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Slider Minimum="0.1" Maximum="12" Value="{Binding ZoomLevel}" Width="180" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ZoomLevel, StringFormat='{}{0:P0}'}" Foreground="White" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <Button Command="{Binding ResetViewCommand}" ToolTip.Tip="重置视图" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-sync-alt" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Rectangle Width="1" Height="24" Fill="#66FFFFFF" Margin="4,0"/>
                        <Button Command="{Binding RotateLeftCommand}" ToolTip.Tip="左旋" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-undo" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding RotateRightCommand}" ToolTip.Tip="右旋" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-redo" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding ToggleFlipHorizontalCommand}" ToolTip.Tip="水平翻转" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-arrows-alt-h" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding ToggleFlipVerticalCommand}" ToolTip.Tip="垂直翻转" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-arrows-alt-v" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Rectangle Width="1" Height="24" Fill="#66FFFFFF" Margin="4,0"/>
                        <Button Command="{Binding ApplyEditsToCurrentCommand}" ToolTip.Tip="应用到当前(覆盖原图)" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-check" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding ApplyEditsToAllCommand}" ToolTip.Tip="批量应用到列表(覆盖原图)" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-layer-group" Width="20" Height="20" Foreground="White"/>
                        </Button>
                        <Button Command="{Binding DeleteScreenshotCommand}" CommandParameter="{Binding CurrentViewingImage}" 
                                ToolTip.Tip="删除" Background="Transparent" BorderThickness="0" Padding="12" CornerRadius="8">
                            <icons:Icon Value="fas fa-trash" Width="20" Height="20" Foreground="#FF4444"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
