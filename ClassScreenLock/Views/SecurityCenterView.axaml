<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:models="clr-namespace:ClassScreenLock.Models"
             xmlns:icons="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="ClassScreenLock.Views.SecurityCenterView"
             x:DataType="vm:SecurityCenterViewModel">

    <Design.DataContext>
        <vm:SecurityCenterViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *" Margin="32">
        <!-- 标题部分 -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border Background="{DynamicResource SystemAccentColorLightBrush}" 
                        Width="48" Height="48" CornerRadius="8">
                    <icons:Icon Value="fas fa-shield" Width="24" Height="24" 
                                Foreground="{DynamicResource SystemAccentColor}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SecurityCenter_Title}" Classes="h1" Margin="0"/>
                    <TextBlock Text="管理您的账户安全与权限设置" Classes="caption" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- 内容部分 -->
        <TabControl Grid.Row="1" Classes="FluentTabControl">
            <!-- 身份验证与概览 -->
            <TabItem Header="身份验证">
                <ScrollViewer>
                    <StackPanel Spacing="20" Margin="0,16,0,0">
                        <!-- 登录卡片 -->
                        <Border Classes="card" Padding="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="管理员登录" Classes="h3"/>
                                    
                                    <StackPanel Spacing="20" IsVisible="{Binding !IsAuthenticated}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="用户名" Classes="caption"/>
                                            <TextBox Text="{Binding Username}" Watermark="输入管理员用户名" Width="300" HorizontalAlignment="Left" VerticalContentAlignment="Center" Classes="clear"/>
                                        </StackPanel>

                                        <StackPanel Spacing="8" IsVisible="{Binding IsLoginPasswordVisible}">
                                            <TextBlock Text="密码" Classes="caption"/>
                                            <Grid ColumnDefinitions="*,Auto" Width="300" HorizontalAlignment="Left">
                                                <TextBox Text="{Binding LoginPassword, Mode=TwoWay}" 
                                                         PasswordChar="{Binding PasswordChar}" 
                                                         Watermark="输入管理员密码" 
                                                         Padding="10,0,35,0"
                                                         VerticalContentAlignment="Center"
                                                         HorizontalAlignment="Stretch"
                                                         Classes="clear"/>
                                                <Button Command="{Binding TogglePasswordVisibilityCommand}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Width="32"
                                                        Height="32"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,2,0">
                                                    <icons:Icon Value="{Binding PasswordIcon}" 
                                                                Width="14" Height="14" 
                                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                                                Opacity="0.6"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Spacing="8" IsVisible="{Binding IsLoginTwoFactorVisible}">
                                            <TextBlock Text="双重验证码" Classes="caption"/>
                                            <TextBox Text="{Binding LoginTwoFactorCode}" 
                                                     Watermark="输入 6 位验证码" 
                                                     MaxLength="6"
                                                     Width="300" 
                                                     HorizontalAlignment="Left"
                                                     Classes="clear"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding LoginMessage}" Classes="caption" 
                                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                                   TextWrapping="Wrap"/>
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button Content="登录" Command="{Binding LoginCommand}" 
                                                    Classes="accent" Width="120" Height="36" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                            <Button Command="{Binding UseBiometricCommand}" 
                                                    IsEnabled="{Binding IsBiometricAvailable}"
                                                    ToolTip.Tip="使用生物识别登录" Padding="8">
                                                <icons:Icon Value="fas fa-fingerprint" Width="20" Height="20"/>
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                                            <icons:Icon Value="fas fa-info-circle" Width="14" Height="14"/>
                                            <TextBlock Text="剩余尝试次数：" Classes="caption"/>
                                            <TextBlock Text="{Binding RemainingAttempts}" Classes="caption" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 已登录状态 -->
                                    <StackPanel Spacing="20" IsVisible="{Binding IsAuthenticated}">
                                        <Border Background="{DynamicResource SystemAccentColorLightBrush}" 
                                                CornerRadius="8" Padding="16">
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <icons:Icon Value="fas fa-user-shield" Width="32" Height="32" 
                                                            Foreground="{DynamicResource SystemAccentColor}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="管理员权限已激活" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="您可以完全访问所有系统功能" Classes="caption"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Spacing="40" Margin="0,10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="当前账户" Classes="caption" Opacity="0.6"/>
                                                <TextBlock Text="{Binding Username}" FontWeight="SemiBold" FontSize="18"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="身份类型" Classes="caption" Opacity="0.6"/>
                                                <TextBlock Text="{Binding AccountTypeText}" FontWeight="SemiBold" FontSize="18"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="登录状态" Classes="caption" Opacity="0.6"/>
                                                <TextBlock Text="{Binding AccountStatusText}" FontWeight="SemiBold" FontSize="18"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="登录时间" Classes="caption" Opacity="0.6"/>
                                                <TextBlock Text="{Binding LoginTimeText}" FontWeight="SemiBold" FontSize="18"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Content="退出登录" Command="{Binding LogoutCommand}" 
                                                Classes="outline" Width="120" Height="36"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <icons:Icon Grid.Column="1" Value="fas fa-user-lock" Width="120" Height="120" 
                                            Opacity="0.05" VerticalAlignment="Top" Margin="0,20,20,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 密码安全 -->
            <TabItem Header="安全中心">
                <ScrollViewer>
                    <StackPanel Spacing="20" Margin="0,16,0,0">
                        <Border Classes="card" Padding="24" IsVisible="{Binding !IsAuthenticated}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <icons:Icon Value="fas fa-lock" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                                    <TextBlock Text="需要管理员登录" Classes="h3"/>
                                </StackPanel>
                                <TextBlock Text="请先在“身份验证”页完成管理员登录后，再使用密码安全与双重验证功能。" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="20" IsVisible="{Binding IsAuthenticated}">
                            <!-- 账户管理 (仅超级管理员可见) -->
                            <StackPanel IsVisible="{Binding IsSuperAdmin}" Spacing="20">
                                <Border Classes="card" Padding="20">
                                    <StackPanel Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <icons:Icon Value="fas fa-user-plus" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                                            <TextBlock Text="创建新账户" Classes="h3"/>
                                        </StackPanel>
                                        
                                        <WrapPanel Orientation="Horizontal">
                                            <StackPanel Spacing="8" Margin="0,0,16,8">
                                                <TextBlock Text="用户名" Classes="caption"/>
                                                <TextBox Text="{Binding NewAccountUsername}" Width="200" Watermark="输入新用户名" Classes="clear"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8" Margin="0,0,16,8">
                                                <TextBlock Text="密码" Classes="caption"/>
                                                <TextBox Text="{Binding NewAccountPassword}" PasswordChar="●" Width="200" Watermark="设置初始密码" Classes="clear"/>
                                            </StackPanel>
                                            <StackPanel Spacing="8" Margin="0,0,16,8">
                                                <TextBlock Text="账户类型" Classes="caption"/>
                                                <ComboBox ItemsSource="{Binding AvailableAccountTypes}" 
                                                          SelectedItem="{Binding NewAccountType}" 
                                                          Width="150">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource AccountTypeToStringConverter}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <Button Content="创建账户" Command="{Binding CreateAccountCommand}" 
                                                    Classes="accent" VerticalAlignment="Bottom" Margin="0,0,0,8" Height="34"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Padding="0">
                                    <Grid RowDefinitions="Auto, 300">
                                        <Border Grid.Row="0" Padding="20,16">
                                            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                                <TextBlock Text="现有账户列表" Classes="h3" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Command="{Binding RefreshAccountsCommand}" Classes="FluentIconButton">
                                                    <icons:Icon Value="fas fa-sync-alt"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        
                                        <ListBox Grid.Row="1" ItemsSource="{Binding Accounts}" Background="Transparent" Padding="12">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:AccountModel">
                                                    <Border Background="{DynamicResource SystemControlBackgroundAltMediumHighBrush}" 
                                                            CornerRadius="8" Margin="4" Padding="16" Classes="account-card">
                                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                            <Border Background="{DynamicResource SystemAccentColorLightBrush}" 
                                                                    Width="40" Height="40" CornerRadius="20" Margin="0,0,16,0">
                                                                <icons:Icon Value="fas fa-user" Foreground="{DynamicResource SystemAccentColor}"/>
                                                            </Border>
                                                            
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="16"/>
                                                                <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.6">
                                                                    <TextBlock Text="{Binding AccountType, Converter={StaticResource AccountTypeToStringConverter}}" Classes="caption"/>
                                                                    <TextBlock Text="•" Classes="caption"/>
                                                                    <TextBlock Text="最后登录:" Classes="caption"/>
                                                                    <TextBlock Text="{Binding LastLoginAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Classes="caption"/>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0"
                                                                    Padding="8,2" CornerRadius="4" 
                                                                    Background="{Binding IsLocked, Converter={StaticResource BooleanToStatusBrushConverter}}">
                                                                <TextBlock Text="{Binding IsLocked, Converter={StaticResource BooleanToStatusTextConverter}}" 
                                                                           FontSize="10" Foreground="White"/>
                                                            </Border>

                                                            <Button Grid.Column="3" 
                                                                    Command="{Binding $parent[UserControl].((vm:SecurityCenterViewModel)DataContext).DeleteAccountCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="danger" Padding="8">
                                                                <icons:Icon Value="fas fa-trash-alt" Width="16" Height="16"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                                
                                <Separator Margin="0,10"/>
                            </StackPanel>

                            <!-- 修改密码 -->
                            <Border Classes="card" Padding="24">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="修改管理员密码" Classes="h3"/>
                                        <TextBlock Text="建议定期更换密码以降低风险。" Classes="caption" Opacity="0.7"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="12" ColumnSpacing="16">
                                        <TextBlock Text="当前密码" Classes="caption" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding CurrentPassword}" PasswordChar="●" Watermark="验证当前密码"
                                                 Width="320" HorizontalAlignment="Left" Classes="clear"/>

                                        <TextBlock Grid.Row="1" Text="新密码" Classes="caption" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewPassword}" PasswordChar="●" Watermark="设置高强度新密码"
                                                 Width="320" HorizontalAlignment="Left" Classes="clear"/>

                                        <TextBlock Grid.Row="2" Text="确认新密码" Classes="caption" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ConfirmPassword}" PasswordChar="●" Watermark="重复输入新密码"
                                                 Width="320" HorizontalAlignment="Left" Classes="clear"/>
                                    </Grid>

                                    <TextBlock Text="{Binding PasswordValidationErrors}" Classes="caption" 
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}" 
                                               TextWrapping="Wrap"/>

                                    <Button Content="更新密码" Command="{Binding ChangePasswordCommand}" 
                                            Classes="accent" HorizontalAlignment="Right" Width="140" Height="36"/>
                                </StackPanel>
                            </Border>

                            <!-- 密码强度评估 -->
                            <Border Classes="card" Padding="24">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="密码强度评估" Classes="h3"/>
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding PasswordStrengthScore}" 
                                                 Height="8" CornerRadius="4"/>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="当前评估结果：" Classes="caption"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PasswordStrengthLabel}" 
                                                   FontWeight="Bold" Foreground="{DynamicResource SystemAccentColor}"/>
                                    </Grid>
                                    
                                    <Button Content="生成随机强密码" Command="{Binding GenerateStrongPasswordCommand}" 
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>

                            <!-- 双重验证 (2FA) -->
                            <Border Classes="card" Padding="24">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="双重验证 (2FA)" Classes="h3"/>
                                            <TextBlock Text="为您的管理员账户增加额外的安全保障。" Classes="caption" Opacity="0.7"/>
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsTwoFactorEnabled}" 
                                                      Command="{Binding SetupTwoFactorCommand}"
                                                      OnContent="已开启" OffContent="已关闭"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" IsVisible="{Binding IsTwoFactorConfigured}">
                                        <TextBlock Text="登录验证方式" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Width="260" Margin="12,0,0,0"
                                                  ItemsSource="{Binding LoginVerificationModeOptions}"
                                                  SelectedItem="{Binding SelectedLoginVerificationMode}"/>
                                    </Grid>

                                    <StackPanel Spacing="16" IsVisible="{Binding IsSettingUpTwoFactor}">
                                        <Separator/>
                                        <TextBlock Text="设置双重验证" FontWeight="Bold"/>
                                        <TextBlock Text="1. 使用 Google Authenticator 或 Microsoft Authenticator 扫描下方的二维码（或手动输入密钥）：" 
                                                   Classes="caption" TextWrapping="Wrap"/>
                                        
                                        <Border Background="White" Padding="8" CornerRadius="8" Width="200" Height="200" HorizontalAlignment="Center"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                            <Image Source="{Binding QrCodeBitmap}" Stretch="Uniform"/>
                                        </Border>

                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" Padding="12" CornerRadius="8"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                                            <SelectableTextBlock Text="{Binding TwoFactorSecret}" 
                                                                HorizontalAlignment="Center" 
                                                                FontFamily="Consolas" 
                                                                FontSize="16" 
                                                                FontWeight="Bold"/>
                                        </Border>

                                        <TextBlock Text="2. 输入 App 中生成的 6 位验证码以确认：" Classes="caption"/>
                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto">
                                            <TextBox Text="{Binding TwoFactorInputCode}" Watermark="6 位验证码" MaxLength="6" Width="160" Classes="clear"/>
                                            <Button Grid.Column="1" Content="验证并启用" 
                                                    Command="{Binding VerifyAndEnableTwoFactorCommand}" 
                                                    Classes="accent" Margin="8,0,0,0"/>
                                        </Grid>
                                        <Button Content="取消设置" Command="{Binding CancelTwoFactorSetupCommand}" 
                                                HorizontalAlignment="Stretch" Classes="outline"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Classes="card" Padding="24">
                                <StackPanel Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <icons:Icon Value="fas fa-shield" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                                        <TextBlock Text="安全中心概览" Classes="h3"/>
                                    </StackPanel>
                                    <TextBlock Text="这里展示了系统的安全状态和最近的安全活动。您可以点击下方按钮进行安全检查。" 
                                               Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 权限管理 -->
            <TabItem Header="权限管理" IsEnabled="{Binding IsSuperAdmin}">
                <ScrollViewer>
                    <StackPanel Spacing="20" Margin="0,16,0,0">
                        <!-- 授权与操作 -->
                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <icons:Icon Value="fas fa-user-shield" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                                    <TextBlock Text="基础功能授权" Classes="h3"/>
                                </StackPanel>

                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-power-off" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="退出应用" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding ExitAppLevel}"/>
                                        <Button Grid.Column="3" Content="执行" Command="{Binding ExitAppCommand}" Classes="FluentIconButton"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="24">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <icons:Icon Value="fas fa-sitemap" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                                    <TextBlock Text="边栏功能访问控制" Classes="h3"/>
                                </StackPanel>

                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-home" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="主页" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding SidebarHomeLevel}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-lock" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="锁屏设置" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding SidebarLockSettingsLevel}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-coffee" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="下课锁屏设置" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding BreakTimeLockSettingsLevel}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-calendar-alt" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="课表" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding SidebarScheduleLevel}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-th-large" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="应用管理" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding SidebarAppManagementLevel}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-network-wired" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="网络拦截" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding SidebarNetworkInterceptionLevel}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-clipboard-list" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="安全日志" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding SidebarSecurityLogsLevel}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-user-shield" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="安全中心" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding SidebarSecurityCenterLevel}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-cog" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="系统设置" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding SidebarSettingsLevel}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <icons:Icon Value="fas fa-info-circle" Width="16" Height="16" Opacity="0.8"/>
                                            <TextBlock Text="关于" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding AuthorizationLevels}" SelectedItem="{Binding SidebarAboutLevel}"/>
                                    </Grid>
                                </StackPanel>

                                <Separator Margin="0,8"/>
                                <Button Content="应用权限配置" Command="{Binding ApplyAuthorizationSettingsCommand}"
                                        Classes="accent" HorizontalAlignment="Right" Width="140"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 锁屏中心 -->
            <TabItem Header="锁屏中心">
                <ScrollViewer>
                    <StackPanel Spacing="20" Margin="0,16,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="8">
                                <TextBlock Text="锁屏中心" Classes="h2"/>
                                <TextBlock Text="管理下课锁屏与相关行为" Classes="caption" Opacity="0.6"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding SaveLockSettingsCommand}" Classes="accent" Padding="16,8" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <icons:Icon Value="fas fa-save" Width="16" Height="16"/>
                                    <TextBlock Text="保存" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Classes="card" Padding="20" IsEnabled="{Binding CanEditBreakTimeLock}">
                            <StackPanel Spacing="20">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <icons:Icon Value="fas fa-lock" Width="24" Height="24" Foreground="{DynamicResource SystemAccentColor}"/>
                                    <TextBlock Text="下课锁屏" Classes="h3" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="启用下课锁屏" Classes="subtitle"/>
                                        <TextBlock Text="在课程结束进入课间时自动显示下课按钮" Classes="caption" Opacity="0.7"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableBreakTimeLock}" OnContent="" OffContent=""/>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.1"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="锁屏模式" Classes="subtitle"/>
                                        <TextBlock Text="选择点击下课按钮后触发的锁定级别" Classes="caption" Opacity="0.7"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="220" SelectedIndex="{Binding BreakTimeLockMode}">
                                        <ComboBoxItem Content="仅防护（不控屏）"/>
                                        <ComboBoxItem Content="仅锁屏"/>
                                        <ComboBoxItem Content="完整锁定（防护+锁屏）"/>
                                    </ComboBox>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.1"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="锁屏等待时间" Classes="subtitle"/>
                                        <TextBlock Text="设置自动进入锁屏前的等待时间" Classes="caption" Opacity="0.7"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <NumericUpDown Minimum="5" Maximum="300" Value="{Binding LockTimeout}" Width="120"/>
                                        <TextBlock Text="秒" VerticalAlignment="Center" Classes="caption"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.1"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="自动解锁" Classes="subtitle"/>
                                        <TextBlock Text="在即将上课前自动解除锁定" Classes="caption" Opacity="0.7"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="提前解锁时间 (分钟)" VerticalAlignment="Center" Classes="caption"/>
                                        <NumericUpDown Value="{Binding AutoUnlockBeforeClassMinutes}" Minimum="1" Maximum="30" Width="120"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.1"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="显示桌面悬浮锁屏按钮" Classes="subtitle"/>
                                        <TextBlock Text="在桌面上显示一个半透明的可拖动按钮，点击可快速进入下课锁定状态" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowFloatingLockWidget}" OnContent="" OffContent=""/>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.1"/>

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="提前解锁所需最小账户级别" Classes="subtitle"/>
                                        <TextBlock Text="低于此级别的账户无法在锁屏界面提前解锁" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="220" SelectedIndex="{Binding EarlyUnlockMinAccountTypeIndex}">
                                        <ComboBoxItem Content="超级管理员"/>
                                        <ComboBoxItem Content="管理员"/>
                                        <ComboBoxItem Content="普通用户"/>
                                    </ComboBox>
                                </Grid>

                                <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.1"/>

                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <icons:Icon Value="fas fa-font" Width="24" Height="24" Foreground="{DynamicResource SystemAccentColor}"/>
                                        <TextBlock Text="锁屏文字显示效果" Classes="h2" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="背景遮罩透明度" Classes="subtitle"/>
                                            <TextBlock Text="调节锁屏时的暗色遮罩强度，数值越小越透明" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Slider Minimum="0.1" Maximum="0.8" SmallChange="0.05" LargeChange="0.1" Width="200" Value="{Binding LockBackgroundOpacity}"/>
                                            <TextBlock Text="{Binding LockBackgroundOpacity, StringFormat=0.00}" Classes="caption" Width="50" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="文字阴影强度" Classes="subtitle"/>
                                            <TextBlock Text="提升文字与背景的对比度，避免在浅色背景下看不清" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Slider Minimum="0.3" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Width="200" Value="{Binding LockTextShadowOpacity}"/>
                                            <TextBlock Text="{Binding LockTextShadowOpacity, StringFormat=0.00}" Classes="caption" Width="50" HorizontalAlignment="Right"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                            <TextBlock Text="文字描边/阴影宽度" Classes="subtitle"/>
                                            <TextBlock Text="控制文字周围发光/描边范围，数值越大越厚重" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Slider Minimum="2" Maximum="16" SmallChange="1" LargeChange="2" Width="200" Value="{Binding LockTextShadowBlurRadius}"/>
                                            <TextBlock Text="{Binding LockTextShadowBlurRadius, StringFormat=0}" Classes="caption" Width="50" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,8,0,0">
                                        <Border Background="Black" CornerRadius="12" Opacity="{Binding LockBackgroundOpacity}"/>
                                        <Border Background="Transparent" CornerRadius="12" Padding="20">
                                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                                <TextBlock Text="锁屏文字效果预览" FontSize="16" Opacity="0.8" HorizontalAlignment="Center"/>
                                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                                    <TextBlock Text="屏幕已锁定" FontSize="32" FontWeight="Light" Foreground="White" HorizontalAlignment="Center">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="#CC000000"
                                                                              BlurRadius="{Binding LockTextShadowBlurRadius}"
                                                                              Opacity="{Binding LockTextShadowOpacity}"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <TextBlock Text="12:34:56" FontSize="56" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="#E6000000"
                                                                              BlurRadius="{Binding LockTextShadowBlurRadius}"
                                                                              Opacity="{Binding LockTextShadowOpacity}"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                    <TextBlock Text="距离下节课: 10:00" FontSize="18" Foreground="{DynamicResource SystemAccentColor}" HorizontalAlignment="Center">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="#CC000000"
                                                                              BlurRadius="{Binding LockTextShadowBlurRadius}"
                                                                              Opacity="{Binding LockTextShadowOpacity}"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                
                                <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Opacity="0.1"/>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                                    <Border Grid.Column="0" Classes="card" Padding="20">
                                        <StackPanel Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <icons:Icon Value="fas fa-shield" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                                                <TextBlock Text="置顶豁免设置" Classes="h3" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="当屏幕锁定时，列表中的程序允许保持置顶以便操作（例如视频会议窗口）" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                <TextBox Text="{Binding NewAllowedApp}" Watermark="输入进程名或窗口标题关键字" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Command="{Binding AddAllowedAppCommand}" Classes="accent" Width="40" Height="40" Padding="0">
                                                    <icons:Icon Value="fas fa-plus" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding AllowedTopmostApps}" Height="200">
                                                <ItemsControl.Template>
                                                    <ControlTemplate>
                                                        <ScrollViewer>
                                                            <ItemsPresenter/>
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                                                                CornerRadius="6" Margin="0,0,0,8" Padding="12,8">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <icons:Icon Value="fas fa-window-maximize" Width="14" Height="14" Opacity="0.5"/>
                                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="13"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.RemoveAllowedAppCommand}" 
                                                                        CommandParameter="{Binding}" Classes="transparent" Width="32" Height="32" Padding="0">
                                                                    <icons:Icon Value="fas fa-times" Width="14" Height="14" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Classes="card" Padding="20">
                                        <StackPanel Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <icons:Icon Value="fas fa-thumbtack" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                                                <TextBlock Text="强制置顶设置" Classes="h3" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="屏幕锁定时强制将列表中的程序窗口置顶" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>

                                            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                <TextBox Text="{Binding NewForcedApp}" Watermark="输入进程名或窗口标题关键字" Margin="0,0,8,0"/>
                                                <Button Grid.Column="1" Command="{Binding AddForcedAppCommand}" Classes="accent" Width="40" Height="40" Padding="0">
                                                    <icons:Icon Value="fas fa-plus" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding ForcedTopmostApps}" Height="200">
                                                <ItemsControl.Template>
                                                    <ControlTemplate>
                                                        <ScrollViewer>
                                                            <ItemsPresenter/>
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ItemsControl.Template>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                                                                CornerRadius="6" Margin="0,0,0,8" Padding="12,8">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <icons:Icon Value="fas fa-arrow-up" Width="14" Height="14" Opacity="0.5"/>
                                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="13"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Command="{Binding $parent[UserControl].DataContext.RemoveForcedAppCommand}" 
                                                                        CommandParameter="{Binding}" Classes="transparent" Width="32" Height="32" Padding="0">
                                                                    <icons:Icon Value="fas fa-times" Width="14" Height="14" Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 安全报告 -->
            <TabItem Header="安全报告">
                <Border Classes="card" Padding="24" Margin="0,16,0,0">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="系统安全概览" Classes="h3"/>
                                <TextBlock Text="最近 30 天的安全事件记录" Classes="caption" Opacity="0.6"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="刷新报告" Command="{Binding RefreshReportCommand}" Classes="FluentIconButton">
                                <icons:Icon Value="fas fa-sync-alt"/>
                            </Button>
                        </Grid>

                        <Separator/>

                        <TextBlock Text="{Binding SecurityReportText}" FontSize="16" LineHeight="32" 
                                   TextWrapping="Wrap" Opacity="0.8"/>
                        
                        <Border Background="{DynamicResource SystemAccentColorLightBrush}" CornerRadius="8" Padding="16">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <icons:Icon Value="fas fa-shield" Width="24" Height="24" Foreground="{DynamicResource SystemAccentColor}"/>
                                <TextBlock Text="系统当前运行正常，未检测到异常登录尝试。" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
