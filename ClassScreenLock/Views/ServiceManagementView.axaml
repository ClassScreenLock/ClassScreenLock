<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClassScreenLock.ViewModels"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ClassScreenLock.Views.ServiceManagementView"
             x:DataType="vm:ServiceManagementViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="20">
            <StackPanel Spacing="4" Margin="0,0,0,10">
                <TextBlock Text="Windows 服务管理" Classes="h1"/>
                <TextBlock Text="管理系统后台服务运行状态" Classes="caption" Opacity="0.6"/>
            </StackPanel>

            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                   CornerRadius="8"
                   Padding="16"
                   Margin="0,0,0,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="服务状态"
                              FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="12" Height="12"
                                Fill="{Binding WatchdogServiceRunning, Converter={StaticResource BoolToBrushConverter}}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="看门狗服务"
                                  VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource StringFormatConverter}" ConverterParameter="{}{0} - {1}">
                                    <Binding Path="WatchdogServiceInstalled" Converter="{StaticResource BoolToStringConverter}" ConverterParameter="已安装|未安装"/>
                                    <Binding Path="WatchdogServiceRunning" Converter="{StaticResource BoolToStringConverter}" ConverterParameter="运行中|已停止"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{Binding ServiceStatusText}"
                              FontStyle="Italic"/>

                    <TextBlock Text="{Binding ServiceDetailsText}"
                              TextWrapping="Wrap"
                              Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                   CornerRadius="8"
                   Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="服务操作"
                              Width="18" Height="18"
                              FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="安装服务"
                               Command="{Binding InstallServicesCommand}"
                               IsEnabled="{Binding !IsBusy}"
                               Classes="Accent"/>

                        <Button Content="卸载服务"
                               Command="{Binding UninstallServicesCommand}"
                               IsEnabled="{Binding !IsBusy}"/>

                        <Button Content="重启服务"
                               Command="{Binding RestartServicesCommand}"
                               IsEnabled="{Binding !IsBusy}"/>

                        <Button Content="刷新状态"
                               Command="{Binding RefreshServiceStatusCommand}"
                               IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>

                    <CheckBox Content="随系统自动启动服务"
                             IsChecked="{Binding AutoStartServices}"
                             Margin="0,8,0,0"/>

                    <TextBlock Text="说明"
                              FontWeight="SemiBold"
                              Margin="0,8,0,4"/>

                    <TextBlock Text="• 看门狗服务：以 LocalSystem 权限运行，使用 CreateProcessAsUser API 在用户会话中启动并监控 ClassScreenLock 主程序及用户模式看门狗"
                              TextWrapping="Wrap"
                              Width="13" Height="13"/>

                    <TextBlock Text="• 服务运行在 Session 0（系统隔离会话），不受用户注销影响，提供 SYSTEM 级保护"
                              TextWrapping="Wrap"
                              Width="13" Height="13"/>

                    <TextBlock Text="• 服务配置了自动恢复策略：第一次失败 5 秒后重启，第二次 10 秒，后续 30 秒"
                              TextWrapping="Wrap"
                              Width="13" Height="13"/>

                    <TextBlock Text="• 与现有的用户模式看门狗（CSL.Watchdog.exe）形成多层保护：服务 → 看门狗 → 主程序"
                              TextWrapping="Wrap"
                              Width="13" Height="13"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
