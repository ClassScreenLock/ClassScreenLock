<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:models="clr-namespace:ClassScreenLock.Models"
             xmlns:converters="clr-namespace:ClassScreenLock.Converters"
             xmlns:controls="clr-namespace:ClassScreenLock.Controls"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassScreenLock.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <!-- 分段选择样式（主题 / 强调色来源） -->
        <Style Selector="RadioButton.segmented">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segmented:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}"/>
        </Style>
        <Style Selector="RadioButton.segmented:checked">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 预设色块样式 -->
        <Style Selector="ToggleButton.swatch">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.swatch:pointerover">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>
        </Style>
        <Style Selector="ToggleButton.swatch:checked">
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border CornerRadius="8" Margin="0,0,16,0">
            <StackPanel Spacing="24" Margin="24">
                <!-- 标题 -->
                <StackPanel Spacing="4" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource Settings_Title}" Classes="h1"/>
                    <TextBlock Text="配置软件外观与系统行为" Classes="caption" Opacity="0.6"/>
                </StackPanel>
                
                <!-- 外观设置 -->
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        CornerRadius="8" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Settings_Appearance_Title}" Classes="h3"/>
                        
                        <!-- 主题模式 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource Settings_ThemeMode}" Classes="subtitle"/>
                                <TextBlock Text="{DynamicResource Settings_ThemeMode_Description}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <RadioButton Classes="segmented" GroupName="ThemeMode"
                                             Content="{DynamicResource Theme_Light}"
                                             IsChecked="{Binding DarkMode, Converter={x:Static converters:BoolToInverseBoolConverter.Instance}}"/>
                                <RadioButton Classes="segmented" GroupName="ThemeMode"
                                             Content="{DynamicResource Theme_Dark}"
                                             IsChecked="{Binding DarkMode}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- 强调色 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource Settings_AccentColor}" Classes="subtitle"/>
                                <TextBlock Text="{DynamicResource Settings_AccentColor_Description}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="12" HorizontalAlignment="Right" MaxWidth="440">
                                <!-- 强调色来源 -->
                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <RadioButton Classes="segmented" GroupName="AccentSource"
                                                 Content="{DynamicResource Settings_SystemAccentColor}"
                                                 IsChecked="{Binding UseSystemAccentColor}"/>
                                    <RadioButton Classes="segmented" GroupName="AccentSource"
                                                 Content="{DynamicResource Settings_CustomColor}"
                                                 IsChecked="{Binding UseSystemAccentColor, Converter={x:Static converters:BoolToInverseBoolConverter.Instance}}"/>
                                </StackPanel>

                                <!-- 跟随系统：显示当前系统强调色 -->
                                <Border IsVisible="{Binding UseSystemAccentColor}"
                                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        CornerRadius="6" Padding="12"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Border Width="20" Height="20" CornerRadius="10"
                                                Background="{Binding AccentColor, Converter={x:Static converters:StringToBrushConverter.Instance}}"/>
                                        <TextBlock Text="{Binding AccentColor}" VerticalAlignment="Center"
                                                   Classes="caption" FontFamily="Consolas"/>
                                        <TextBlock Text="{DynamicResource Settings_SystemAccentColor_Desc}" VerticalAlignment="Center"
                                                   Classes="caption" Opacity="0.6"/>
                                    </StackPanel>
                                </Border>

                                <!-- 自定义：预设色板 + 精细调色 -->
                                <Border IsVisible="{Binding !UseSystemAccentColor}"
                                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        CornerRadius="6" Padding="12"
                                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{DynamicResource Settings_PresetColors}" Classes="caption" Opacity="0.7"/>
                                        
                                        <!-- 预设色板 -->
                                        <ItemsControl ItemsSource="{Binding AccentColorOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AccentColorOption">
                                                    <ToggleButton Classes="swatch" Width="28" Height="28" Margin="0,0,10,10"
                                                                  Background="{Binding Hex, Converter={x:Static converters:StringToBrushConverter.Instance}}"
                                                                  IsChecked="{Binding IsSelected}"
                                                                  ToolTip.Tip="{Binding Hex}"
                                                                  Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SetAccentColorCommand}"
                                                                  CommandParameter="{Binding Hex}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- 当前颜色 -->
                                        <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="0" Text="{DynamicResource Settings_CurrentColor}"
                                                       VerticalAlignment="Center" Classes="caption"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                                                <Border Width="20" Height="20" CornerRadius="10"
                                                        Background="{Binding CustomAccentColor, Converter={x:Static converters:StringToBrushConverter.Instance}}"/>
                                                <TextBlock Text="{Binding CustomAccentColor}" VerticalAlignment="Center"
                                                           Classes="caption" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 更多颜色 -->
                                        <Expander HorizontalAlignment="Left" IsExpanded="False">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <fluent:SymbolIcon Symbol="Color" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource Settings_MoreColors}" Classes="caption"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                    CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                                <controls:ColorPicker SelectedColorHex="{Binding CustomAccentColor, Mode=TwoWay}"
                                                                      Width="300" HorizontalAlignment="Left"/>
                                            </Border>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- 通知设置 -->
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        CornerRadius="8" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Settings_Notification_Title}" Classes="h3"/>
                        
                        <!-- 显示通知 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource Settings_ShowNotifications}" Classes="subtitle"/>
                                <TextBlock Text="{DynamicResource Settings_ShowNotifications_Description}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowNotifications}" 
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 通知停留时长 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource Settings_NotificationDuration}" Classes="subtitle"/>
                                <TextBlock Text="{DynamicResource Settings_NotificationDuration_Description}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Slider Minimum="1" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding NotificationDurationSeconds, Mode=TwoWay}"
                                        Width="220" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="2" MinWidth="52">
                                    <TextBlock Text="{Binding NotificationDurationSeconds, StringFormat={}{0:0.#}}"
                                               VerticalAlignment="Center" Classes="subtitle"/>
                                    <TextBlock Text="{DynamicResource Settings_Seconds}" VerticalAlignment="Center"
                                               Classes="caption" Opacity="0.7"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 通知声音 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource Settings_NotificationSound}" Classes="subtitle"/>
                                <TextBlock Text="{DynamicResource Settings_NotificationSound_Description}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationSound}" 
                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 固定中央提示 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <fluent:SymbolIcon Symbol="Info" FontSize="14" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Settings_Notification_CenterHint}" Classes="caption"
                                       Opacity="0.6" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- 语言设置 -->
                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        CornerRadius="8" Padding="24">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{DynamicResource Settings_Language_Title}" Classes="h3"/>
                        
                        <!-- 语言选择 -->
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource Settings_InterfaceLanguage}" Classes="subtitle"/>
                                <TextBlock Text="{DynamicResource Settings_InterfaceLanguage_Description}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" 
                                      SelectedItem="{Binding Language}" Width="200" 
                                      HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Settings_ResetToDefaults}" Command="{Binding ResetToDefaultsCommand}" 
                            Classes="outline"/>
                    <Button Content="{DynamicResource Settings_RestartApp}" Command="{Binding RestartAppCommand}"
                            Classes="accent"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
