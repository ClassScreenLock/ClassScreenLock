<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:Converters="clr-namespace:ClassScreenLock.Converters"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="600"
             x:Class="ClassScreenLock.Views.Sidebar"
             x:DataType="vm:SidebarViewModel"
             Classes="Sidebar">

    <UserControl.Resources>
        <!-- 侧边栏菜单项模板：图标（16px 标准档）+ 文字（14px Body） -->
        <DataTemplate x:Key="SidebarMenuItemTemplate" DataType="vm:MenuItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <fluent:SymbolIcon Symbol="{Binding Icon, Converter={x:Static Converters:FontAwesomeToFluentIconConverter.Instance}}"
                                   FontSize="16"
                                   Width="20" Height="20"
                                   VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Title}"
                           FontSize="{DynamicResource F2FontSizeBody}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding $parent[UserControl].DataContext.IsExpanded}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ========== 侧边栏 ListBox（Kit: 导航项高 40、圆角 4px） ========== -->
        <Style Selector="ListBox.sidebar-nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style Selector="ListBox.sidebar-nav ListBoxItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusControl}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource F2TextSecondaryBrush}"/>
        </Style>
        <Style Selector="ListBox.sidebar-nav ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
        </Style>
        <Style Selector="ListBox.sidebar-nav ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource F2NavSelectedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource F2AccentTextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox.sidebar-nav ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource F2NavSelectedHoverBackgroundBrush}"/>
        </Style>

        <!-- 折叠态：胶囊居中、只显示图标 -->
        <Style Selector="ListBox.sidebar-nav.collapsed ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- ========== 顶部折叠按钮（4px 圆角一致） ========== -->
        <Style Selector="Button.sidebar-toggle-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="CornerRadius" Value="{DynamicResource F2RadiusControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource F2TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.sidebar-toggle-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.sidebar-toggle-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource F2SubtleTertiaryBrush}"/>
        </Style>
        <!-- 折叠时切换按钮胶囊居中 -->
        <Style Selector="Button.sidebar-toggle-btn.collapsed">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- ========== 底部账户区块（Fluent 规范账户样式） ========== -->
        <Style Selector="Border.sidebar-account">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.sidebar-account:pointerover">
            <Setter Property="Background" Value="{DynamicResource F2SubtleSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.sidebar-account:pressed">
            <Setter Property="Background" Value="{DynamicResource F2SubtleTertiaryBrush}"/>
        </Style>
        <!-- 折叠态：只保留头像并居中（文字由 IsExpanded 绑定控制显隐） -->
        <Style Selector="Border.sidebar-account.collapsed">
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent">
        <Border CornerRadius="0"
                Width="{Binding SidebarWidth}"
                Classes="sidebar-background"
                ClipToBounds="True">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Border.Transitions>
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- 顶部区域：侧边栏切换按钮 -->
                <Border Grid.Row="0" Padding="0,8,0,4">
                    <Button x:Name="ToggleButton"
                            Classes="sidebar-toggle-btn"
                            Classes.collapsed="{Binding !IsExpanded}"
                            Command="{Binding ToggleSidebarCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <fluent:SymbolIcon Grid.Column="0"
                                               Symbol="{Binding ToggleIcon, Converter={x:Static Converters:FontAwesomeToFluentIconConverter.Instance}}"
                                               FontSize="16"
                                               Width="20" Height="20"
                                               VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ToggleText}"
                                       VerticalAlignment="Center"
                                       FontSize="{DynamicResource F2FontSizeBody}"
                                       IsVisible="{Binding IsExpanded}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- 主菜单项 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                    <ListBox x:Name="MenuListBox"
                             Classes="sidebar-nav"
                             Classes.collapsed="{Binding !IsExpanded}"
                             ItemsSource="{Binding MenuItems}"
                             ItemTemplate="{StaticResource SidebarMenuItemTemplate}"
                             SelectionChanged="MenuListBox_SelectionChanged"/>
                </ScrollViewer>

                <!-- 底部固定项（账户 + 分隔线 + 设置 + 关于 + 版本） -->
                <StackPanel Grid.Row="2" Spacing="0" Margin="0,4,0,6">

                    <!-- 账户区块（Fluent 规范：导航底部，32px 圆形头像 + 名字 + 状态） -->
                    <Border Classes="sidebar-account"
                            Classes.collapsed="{Binding !IsExpanded}"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="8,0,8,4">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16"
                                    Background="{DynamicResource F2AccentDefaultBrush}"
                                    VerticalAlignment="Center">
                                <fluent:SymbolIcon Symbol="{Binding AccountIcon, Converter={x:Static Converters:FontAwesomeToFluentIconConverter.Instance}}"
                                                   FontSize="16"
                                                   Foreground="{DynamicResource F2TextOnAccentPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Spacing="0" VerticalAlignment="Center" IsVisible="{Binding IsExpanded}">
                                <TextBlock Text="{Binding AccountName}"
                                           FontSize="{DynamicResource F2FontSizeBody}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource F2TextPrimaryBrush}"
                                           IsVisible="{Binding IsLoggedIn}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                                <TextBlock Text="{Binding AccountStatusText}"
                                           FontSize="{DynamicResource F2FontSizeCaption}"
                                           Foreground="{DynamicResource F2TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Height="1"
                            Classes="sidebar-divider"
                            Margin="14,6,14,8"/>

                    <ListBox x:Name="BottomMenuListBox"
                             Classes="sidebar-nav"
                             Classes.collapsed="{Binding !IsExpanded}"
                             ItemsSource="{Binding BottomMenuItems}"
                             ItemTemplate="{StaticResource SidebarMenuItemTemplate}"
                             SelectionChanged="BottomMenuListBox_SelectionChanged"/>

                    <!-- 版本信息（12px Caption / 三级文本色） -->
                    <TextBlock Text="{Binding VersionInfo}"
                               HorizontalAlignment="Center"
                               Classes="sidebar-version"
                               IsVisible="{Binding IsExpanded}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="1"
                               Margin="12,8,12,4"
                               FontSize="{DynamicResource F2FontSizeCaption}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>