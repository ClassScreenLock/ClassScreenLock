<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="272" d:DesignHeight="560"
             x:Class="ClassScreenLock.Views.TrayMenuView"
             Width="272"
             UseLayoutRounding="True"
             Cursor="Hand">

    <!--
        系统托盘菜单 · Fluent 2 规范
        · 菜单面板圆角 8px（Fluent Flyout），菜单项圆角 4px（Fluent Control）
        · 行高 36px，图标容器 24px，字号 13px Medium
        · 阴影由 TrayPopupWindow 的透明内边距承载，避免被窗口边界裁切
    -->
    <UserControl.Styles>
        <!-- 菜单项：圆角 + 悬停 / 按压态 -->
        <Style Selector="Border.menu-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="ClipToBounds" Value="False"/>
        </Style>
        <Style Selector="Border.menu-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource QAE_MenuHoverBrush}"/>
        </Style>
        <Style Selector="Border.menu-item:pressed">
            <Setter Property="Background" Value="{DynamicResource QAE_MenuPressedBrush}"/>
        </Style>
        <Style Selector="Border.menu-item &gt; Grid, Border.menu-item StackPanel, Border.menu-item fluent|SymbolIcon, Border.menu-item TextBlock">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 图标容器：24px 圆角方块（Fluent 图标底板） -->
        <Style Selector="Border.menu-icon-bg">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.menu-text">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource QAE_MenuTextBrush}"/>
        </Style>

        <Style Selector="fluent|SymbolIcon.menu-icon">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 分组标题 -->
        <Style Selector="TextBlock.menu-header">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="Foreground" Value="{DynamicResource QAE_MenuTextBrush}"/>
            <Setter Property="Margin" Value="10,6,0,2"/>
        </Style>

        <!-- 分隔线 -->
        <Style Selector="Border.menu-divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource QAE_MenuDividerBrush}"/>
            <Setter Property="Margin" Value="8,5"/>
        </Style>

        <!-- 危险项（退出） -->
        <Style Selector="Border.menu-item-exit:pointerover">
            <Setter Property="Background" Value="{DynamicResource QAE_MenuDangerHoverBrush}"/>
        </Style>
        <Style Selector="Border.menu-item-exit TextBlock.menu-text">
            <Setter Property="Foreground" Value="{DynamicResource QAE_MenuDangerTextBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- 菜单面板：Fluent Flyout 表面（阴影由窗口透明边距承载） -->
    <Border Background="{DynamicResource QAE_MenuShellBrush}"
            BorderBrush="{DynamicResource QAE_MenuShellBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4"
            BoxShadow="{DynamicResource QAE_MenuShadow}">
        <!-- 滚动条放在面板内部：出现时只压缩内容宽度，不会裁切面板或丢失菜单项 -->
        <ScrollViewer x:Name="MenuScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      AllowAutoHide="True">
            <StackPanel Spacing="0">

            <!-- 主控制 -->
            <TextBlock Classes="menu-header" Text="{DynamicResource Tray_Header}"/>

            <Border Classes="menu-item" PointerPressed="OnShowClicked"
                    AutomationProperties.Name="{DynamicResource Tray_Show}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="menu-icon-bg" Background="#1A0078D4" Grid.Column="0">
                        <fluent:SymbolIcon Classes="menu-icon" Symbol="PanelLeft" Foreground="#0067C0"/>
                    </Border>
                    <TextBlock Classes="menu-text" Grid.Column="1"
                               Text="{DynamicResource Tray_Show}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Border Classes="menu-item" PointerPressed="OnLockClicked"
                    AutomationProperties.Name="{DynamicResource Tray_QuickLock}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="menu-icon-bg" Background="#1A0078D4" Grid.Column="0">
                        <fluent:SymbolIcon Classes="menu-icon" Symbol="LockClosed" Foreground="#0067C0"/>
                    </Border>
                    <TextBlock Classes="menu-text" Grid.Column="1"
                               Text="{DynamicResource Tray_QuickLock}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Border Classes="menu-divider"/>

            <!-- 管理工具 -->
            <TextBlock Classes="menu-header" Text="{DynamicResource Tray_HeaderTools}"/>

            <Border Classes="menu-item" PointerPressed="OnAppManagementClicked"
                    AutomationProperties.Name="{DynamicResource Tray_AppManagement}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="menu-icon-bg" Background="#1A107C10" Grid.Column="0">
                        <fluent:SymbolIcon Classes="menu-icon" Symbol="Grid" Foreground="#107C10"/>
                    </Border>
                    <TextBlock Classes="menu-text" Grid.Column="1"
                               Text="{DynamicResource Tray_AppManagement}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Border Classes="menu-item" PointerPressed="OnNetworkInterceptionClicked"
                    AutomationProperties.Name="{DynamicResource Tray_NetworkInterception}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="menu-icon-bg" Background="#1AC8501C" Grid.Column="0">
                        <fluent:SymbolIcon Classes="menu-icon" Symbol="Globe" Foreground="#AC501C"/>
                    </Border>
                    <TextBlock Classes="menu-text" Grid.Column="1"
                               Text="{DynamicResource Tray_NetworkInterception}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Border Classes="menu-item" PointerPressed="OnSecurityLogsClicked"
                    AutomationProperties.Name="{DynamicResource Tray_SecurityLogs}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="menu-icon-bg" Background="#1A6B4F8C" Grid.Column="0">
                        <fluent:SymbolIcon Classes="menu-icon" Symbol="ClipboardText" Foreground="#6B4F8C"/>
                    </Border>
                    <TextBlock Classes="menu-text" Grid.Column="1"
                               Text="{DynamicResource Tray_SecurityLogs}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Border Classes="menu-item" PointerPressed="OnSecurityCenterClicked"
                    AutomationProperties.Name="{DynamicResource Tray_SecurityCenter}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="menu-icon-bg" Background="#1AC50F1F" Grid.Column="0">
                        <fluent:SymbolIcon Classes="menu-icon" Symbol="ShieldPerson" Foreground="#C50F1F"/>
                    </Border>
                    <TextBlock Classes="menu-text" Grid.Column="1"
                               Text="{DynamicResource Tray_SecurityCenter}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Border Classes="menu-divider"/>

            <!-- 设置 -->
            <TextBlock Classes="menu-header" Text="{DynamicResource Tray_HeaderSettings}"/>

            <Border Classes="menu-item" PointerPressed="OnLockSettingsClicked"
                    AutomationProperties.Name="{DynamicResource Tray_OpenLockSettings}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="menu-icon-bg" Background="#1A5C2D92" Grid.Column="0">
                        <fluent:SymbolIcon Classes="menu-icon" Symbol="Options" Foreground="#5C2D92"/>
                    </Border>
                    <TextBlock Classes="menu-text" Grid.Column="1"
                               Text="{DynamicResource Tray_OpenLockSettings}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Border Classes="menu-item" PointerPressed="OnScheduleClicked"
                    AutomationProperties.Name="{DynamicResource Tray_OpenSchedule}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="menu-icon-bg" Background="#1A0078D4" Grid.Column="0">
                        <fluent:SymbolIcon Classes="menu-icon" Symbol="Calendar" Foreground="#0067C0"/>
                    </Border>
                    <TextBlock Classes="menu-text" Grid.Column="1"
                               Text="{DynamicResource Tray_OpenSchedule}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Border Classes="menu-divider"/>

            <!-- 退出 -->
            <Border Classes="menu-item menu-item-exit" PointerPressed="OnExitClicked"
                    AutomationProperties.Name="{DynamicResource Tray_Exit}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Classes="menu-icon-bg" Background="#1AE81123" Grid.Column="0">
                        <fluent:SymbolIcon Classes="menu-icon" Symbol="SignOut" Foreground="#C42B1C"/>
                    </Border>
                    <TextBlock Classes="menu-text" Grid.Column="1"
                               Text="{DynamicResource Tray_Exit}" Margin="10,0,0,0"/>
                </Grid>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
