<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScreenLock.ViewModels"
             xmlns:converters="clr-namespace:ClassScreenLock.Converters"
             xmlns:fluent="clr-namespace:FluentIcons.Avalonia;assembly=FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="ClassScreenLock.Views.WebcamHistoryView"
             x:DataType="vm:WebcamHistoryViewModel"
             Focusable="True"
             KeyDown="OnRootKeyDown">

    <UserControl.Resources>
        <converters:StringToBitmapConverter x:Key="StringToBitmapConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:BoolToResourceBrushConverter x:Key="BoolToResourceBrushConverter"/>
        <converters:MBToGBConverter x:Key="MBToGBConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:IsNullConverter x:Key="IsNullConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *">
        <StackPanel Grid.Row="0" Spacing="8" Margin="32,32,32,24">
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Border Background="{DynamicResource SystemAccentColorLightBrush}"
                        Width="48" Height="48" CornerRadius="8">
                    <fluent:SymbolIcon Symbol="Video" Width="24" Height="24"
                                Foreground="{DynamicResource SystemAccentColor}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource WebcamHistory_Title}" Classes="h1" Margin="0"/>
                    <TextBlock Text="{DynamicResource WebcamHistory_Description}" Classes="caption" Opacity="0.6"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20" Margin="32,0,32,32">
                <Border Classes="card" Padding="24">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                            <fluent:SymbolIcon Symbol="Settings" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                            <TextBlock Text="{DynamicResource WebcamHistory_Settings_Title}" Classes="h3"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <StackPanel Grid.Row="0" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource WebcamHistory_ClassWebcam}" Classes="subtitle"/>
                                <TextBlock Text="{DynamicResource WebcamHistory_ClassWebcam_Description}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Settings.EnableClassWebcam}">
                                    <TextBlock Text="{DynamicResource WebcamHistory_Interval}" VerticalAlignment="Center" Classes="caption"/>
                                    <ComboBox ItemsSource="{Binding ClassIntervalOptions}" SelectedItem="{Binding Settings.ClassWebcamInterval}" Width="100"/>
                                    <TextBlock Text="{DynamicResource WebcamHistory_Minutes}" VerticalAlignment="Center" Classes="caption"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding Settings.EnableClassWebcam}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12"/>

                            <StackPanel Grid.Row="2" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource WebcamHistory_BreakWebcam}" Classes="subtitle"/>
                                <TextBlock Text="{DynamicResource WebcamHistory_BreakWebcam_Description}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Settings.EnableBreakWebcam}">
                                    <TextBlock Text="{DynamicResource WebcamHistory_Interval}" VerticalAlignment="Center" Classes="caption"/>
                                    <ComboBox ItemsSource="{Binding BreakIntervalOptions}" SelectedItem="{Binding Settings.BreakWebcamInterval}" Width="100"/>
                                    <TextBlock Text="{DynamicResource WebcamHistory_Minutes}" VerticalAlignment="Center" Classes="caption"/>
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding Settings.EnableBreakWebcam}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12"/>

                            <StackPanel Grid.Row="4" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource WebcamHistory_CameraSelection}" Classes="subtitle"/>
                                <TextBlock Text="{DynamicResource WebcamHistory_CameraSelection_Description}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding CameraOptions}"
                                          SelectedValue="{Binding SelectedCameraMoniker}"
                                          SelectedValueBinding="{Binding Moniker}"
                                          DisplayMemberBinding="{Binding Name}"
                                          Width="260"
                                          PlaceholderText="未检测到摄像头或请选择"/>
                            </StackPanel>

                            <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="0,12"/>

                            <Grid Grid.Row="6" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                                    <StackPanel Spacing="4" Margin="0,0,32,12" VerticalAlignment="Center" Width="180">
                                        <TextBlock Text="自动清理" Classes="subtitle"/>
                                        <TextBlock Text="自动删除旧的记录以释放空间" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="0,0,24,12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="保留时长" Classes="caption" Opacity="0.6"/>
                                            <ComboBox ItemsSource="{Binding RetentionDaysOptions}" SelectedItem="{Binding Settings.RetentionDays}" Width="110">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat='{}{0} 天'}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="存储上限" Classes="caption" Opacity="0.6"/>
                                            <ComboBox ItemsSource="{Binding MaxStorageMBOptions}" SelectedItem="{Binding Settings.MaxStorageMB}" Width="110">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat={}{0:0.0} GB, Converter={StaticResource MBToGBConverter}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="图片格式" Classes="caption" Opacity="0.6"/>
                                            <ComboBox ItemsSource="{Binding AvailableFormats}"
                                                      SelectedValue="{Binding Settings.ImageFormat}"
                                                      SelectedValueBinding="{Binding Value}"
                                                      Width="110">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="4" Width="200">
                                            <TextBlock Text="拍照亮度" Classes="caption" Opacity="0.6"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Slider Minimum="0.1" Maximum="1.0" SmallChange="0.01" LargeChange="0.1" Width="120"
                                                        Value="{Binding WebcamBrightness}"/>
                                                <TextBlock Text="{Binding WebcamBrightness, StringFormat=P0}" Classes="caption" Width="40"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </WrapPanel>

                                <Button Grid.Column="1" Content="保存设置" Command="{Binding SaveSettingsCommand}"
                                        Classes="accent" VerticalAlignment="Center" Height="36" Padding="24,0" Margin="0,0,0,12"/>
                            </Grid>

                            <Separator Grid.Row="7" Grid.ColumnSpan="2" Margin="0,12"/>

                            <Grid Grid.Row="8" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="调试模式" Classes="subtitle"/>
                                    <TextBlock Text="开启后记录拍照日志并允许手动触发" Classes="caption" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <ToggleSwitch IsChecked="{Binding IsDebugEnabled}" OnContent="" OffContent=""/>
                                    <Button Content="立即拍照" Command="{Binding DebugCaptureCommand}" IsEnabled="{Binding IsDebugEnabled}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="24" IsVisible="{Binding IsDebugEnabled}">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
                            <fluent:SymbolIcon Symbol="Video" Width="20" Height="20" Foreground="{DynamicResource SystemAccentColor}"/>
                            <StackPanel>
                                <TextBlock Text="调试预览" Classes="h3"/>
                                <TextBlock Text="{Binding PreviewStatus}" Classes="caption" Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="8">
                            <Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" Height="240"/>
                                <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsVisible="{Binding PreviewImage, Converter={StaticResource IsNullConverter}}">
                                    <fluent:SymbolIcon Symbol="VideoOff" Width="20" Height="20" Opacity="0.6"/>
                                    <TextBlock Text="未开启预览" Classes="caption" Opacity="0.6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="打开预览" Command="{Binding StartPreviewCommand}"/>
                            <Button Content="停止预览" Command="{Binding StopPreviewCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="12">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <fluent:SymbolIcon Symbol="Calendar" Width="16" Height="16"/>
                            <TextBlock Text="日期" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AvailableDates}" SelectedItem="{Binding SelectedDate}" Width="150"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
                            <fluent:SymbolIcon Symbol="Filter" Width="16" Height="16"/>
                            <TextBlock Text="类型" VerticalAlignment="Center"/>
                            <ComboBox SelectedIndex="{Binding FilterTypeIndex}" Width="120">
                                <ComboBoxItem>全部</ComboBoxItem>
                                <ComboBoxItem>上课时段</ComboBoxItem>
                                <ComboBoxItem>课间休息</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding LoadScreenshotsCommand}" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluent:SymbolIcon Symbol="ArrowSync" Width="16" Height="16"/>
                                    <TextBlock Text="刷新"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenFolderCommand}" Padding="12,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluent:SymbolIcon Symbol="FolderOpen" Width="16" Height="16"/>
                                    <TextBlock Text="打开文件夹"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="card" Padding="12">
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,10,10">
                            <ToggleSwitch IsChecked="{Binding IsSelectionMode}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            <TextBlock Text="批量选择" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Command="{Binding SelectAllOnPageCommand}" Padding="12,8" IsEnabled="{Binding IsSelectionMode}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluent:SymbolIcon Symbol="CheckboxChecked" Width="16" Height="16"/>
                                <TextBlock Text="全选本页"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearSelectionCommand}" Padding="12,8" IsEnabled="{Binding IsSelectionMode}" Margin="0,0,10,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <fluent:SymbolIcon Symbol="DismissCircle" Width="16" Height="16"/>
                                <TextBlock Text="清除"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,10,10">
                            <TextBlock Text="{Binding SelectedCount, StringFormat='已选 {0}'}" Opacity="0.8" VerticalAlignment="Center"/>
                            <Button Command="{Binding DeleteSelectedCommand}" Padding="12,8" IsEnabled="{Binding IsSelectionMode}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <fluent:SymbolIcon Symbol="Delete" Width="16" Height="16" Foreground="#FF4444"/>
                                    <TextBlock Text="删除已选"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding PagedScreenshots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="6" Padding="0" Background="Transparent" BorderThickness="0"
                                    Command="{Binding $parent[UserControl].((vm:WebcamHistoryViewModel)DataContext).OpenOrToggleSelectCommand}"
                                    CommandParameter="{Binding}"
                                    PointerPressed="OnScreenshotItemPointerPressed">
                                <Border Width="240" Height="180" CornerRadius="8" ClipToBounds="True"
                                        Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                        BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToResourceBrushConverter}, ConverterParameter=SystemAccentColor|SystemControlForegroundBaseLowBrush}"
                                        BorderThickness="{Binding IsSelected, Converter={StaticResource BoolToThicknessConverter}, ConverterParameter=2|1}">

                                    <Grid RowDefinitions="*,Auto">
                                        <Image Grid.Row="0" Source="{Binding FilePath, Converter={StaticResource StringToBitmapConverter}, ConverterParameter=thumb}" Stretch="UniformToFill"/>

                                        <Border Grid.Row="0" Background="#66000000" CornerRadius="6" Padding="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                IsVisible="{Binding $parent[UserControl].((vm:WebcamHistoryViewModel)DataContext).IsSelectionMode}">
                                            <CheckBox IsChecked="{Binding IsSelected}"/>
                                        </Border>

                                        <Border Grid.Row="1" Background="#CC000000" Padding="6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="White" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock Text="上课时段" IsVisible="{Binding IsClassTime}" Foreground="LightGreen" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock Text="课间休息" IsVisible="{Binding !IsClassTime}" Foreground="LightBlue" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </Border>

                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="打开" Command="{Binding $parent[UserControl].((vm:WebcamHistoryViewModel)DataContext).OpenScreenshotCommand}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="删除" Command="{Binding $parent[UserControl].((vm:WebcamHistoryViewModel)DataContext).DeleteScreenshotCommand}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="暂无拍照" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" Opacity="0.5" Margin="0,20,0,0"/>

                <Border Classes="card" Padding="12" IsVisible="{Binding HasScreenshots}">
                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto">
                        <TextBlock Grid.Column="0" Text="{Binding TotalItems, StringFormat='共 {0} 张'}" VerticalAlignment="Center" Opacity="0.8"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PageStartItemIndex, StringFormat='显示 {0}'}" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="-" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="{Binding PageEndItemIndex}" VerticalAlignment="Center" Opacity="0.8"/>
                            <Rectangle Width="1" Height="18" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="10,0"/>
                            <Button Command="{Binding FirstPageCommand}" Padding="10" IsEnabled="{Binding CanGoPrevious}">
                                <fluent:SymbolIcon Symbol="ChevronDoubleLeft" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding PreviousPageCommand}" Padding="10" IsEnabled="{Binding CanGoPrevious}">
                                <fluent:SymbolIcon Symbol="ChevronLeft" Width="16" Height="16"/>
                            </Button>
                            <TextBlock Text="{Binding CurrentPage, StringFormat='第 {0}'}" VerticalAlignment="Center"/>
                            <TextBlock Text="/" VerticalAlignment="Center" Opacity="0.8"/>
                            <TextBlock Text="{Binding TotalPages, StringFormat='{}{0} 页'}" VerticalAlignment="Center"/>
                            <Button Command="{Binding NextPageCommand}" Padding="10" IsEnabled="{Binding CanGoNext}">
                                <fluent:SymbolIcon Symbol="ChevronRight" Width="16" Height="16"/>
                            </Button>
                            <Button Command="{Binding LastPageCommand}" Padding="10" IsEnabled="{Binding CanGoNext}">
                                <fluent:SymbolIcon Symbol="ChevronDoubleRight" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="每页" VerticalAlignment="Center" Opacity="0.8"/>
                            <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="90"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
