<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <Platform>x64</Platform>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <NuGetAudit>false</NuGetAudit>
        <DefineConstants Condition="'$(OS)' == 'Windows_NT'">$(DefineConstants);WINDOWS</DefineConstants>
        <Version>1.20.10.909</Version>
        <AssemblyVersion>1.20.10.909</AssemblyVersion>
        <FileVersion>1.20.10.909</FileVersion>
        <InformationalVersion>1.20.10.909</InformationalVersion>
        <Copyright>© 旧故里小牛（jiugulixiaoniu）</Copyright>
        <Authors>旧故里小牛（jiugulixiaoniu）</Authors>
        <Company>旧故里小牛（jiugulixiaoniu）</Company>
        <AssemblyName>CSL.Watchdog</AssemblyName>
        <ApplicationName>CSL.Watchdog</ApplicationName>
        <OutDir>..\ClassScreenLock\bin\$(Configuration)\$(TargetFramework)\</OutDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>false</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PublishTrimmed>false</PublishTrimmed>
        <!-- 单文件发布直接输出到主程序发布目录，统一部署 -->
        <PublishDir>..\ClassScreenLock\bin\$(Configuration)\$(TargetFramework)\win-x64\publish\</PublishDir>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationRequiresAdministrator>true</ApplicationRequiresAdministrator>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.Management" Version="8.0.0" />
    </ItemGroup>
</Project>
